    .ix:hover .ix__row { opacity: 0.32; }
    .ix .ix__row:hover { opacity: 1; }
    .ix__row:hover .ix__t { transform: translateX(18px); font-style: italic; }
    /* the preview trails the cursor, a portal-shaped window into the collection */
    .ix__float { display: block; position: fixed; left: 0; top: 0; z-index: 5; width: 300px; height: 380px; pointer-events: none; opacity: 0; transform: translate3d(var(--x, 0), var(--y, 0), 0) scale(0.92); transition: opacity 0.5s var(--ease), transform 0.08s linear; background: var(--stone); overflow: hidden; }
    .ix__float.on { opacity: 1; }
    .ix__float :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transform: scale(1.08); transition: opacity 0.7s var(--ease), transform 1.4s var(--ease); }
    .ix__float :global(img.on) { opacity: 1; transform: none; }
  }

  /* burn — the section is tall, its frame is pinned; scroll moves one evening of fire */
  .burn { position: relative; height: 420svh; margin-top: 110px; }
  .burn__pin { position: sticky; top: 0; height: 100svh; overflow: hidden; isolation: isolate; }
  /* phones: the fire is a wide window between title and reading (the source is landscape, so it stays sharp) */
  .burn__img { position: relative; z-index: -1; height: min(56vw, 30svh); margin: 18px calc(-1 * var(--gut)) 0; overflow: hidden; -webkit-mask-image: linear-gradient(180deg, transparent, #000 14%, #000 86%, transparent); mask-image: linear-gradient(180deg, transparent, #000 14%, #000 86%, transparent); }
  .burn__img img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 60%; transform: scale(var(--z, 1.12)); will-change: opacity, transform; }
  /* three gradings of one photograph; only their opacity moves, so scrolling stays smooth */
  .burn__cold { filter: brightness(0.16) saturate(0) contrast(1.1); }
  .burn__warm { opacity: 0; }
  .burn__ember { opacity: 0; filter: brightness(0.62) saturate(1.35) sepia(0.25) contrast(1.15); }
  .burn__hud { height: 100%; display: grid; grid-template-rows: auto auto 1fr auto auto; padding-top: calc(var(--hdr) + 22px); padding-bottom: 24px; }
  .burn__hud :global(.chap) { margin: 0; }
  .burn__read { align-self: end; display: flex; align-items: baseline; gap: 14px; margin: 12px 0 14px; }
  .burn__deg { font-family: var(--serif); font-weight: 300; font-size: min(22vw, 11.5svh, 200px); line-height: 0.8; font-variant-numeric: lining-nums tabular-nums; letter-spacing: -0.02em; }
  .burn__deg sup { font-size: 0.26em; vertical-align: top; margin-left: 6px; color: var(--bronze-2); letter-spacing: 0.04em; }
  .burn__at { font-size: 10.5px; letter-spacing: 0.26em; text-transform: uppercase; color: var(--cream-2); }
  .burn__foot { display: flex; align-items: center; gap: 18px; margin-top: 10px; }
  .burn__foot .burn__bar { flex: 1; margin: 0; }
  .burn__snd { flex: none; display: inline-flex; align-items: center; gap: 10px; min-height: 44px; font-size: 10.5px; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--cream-2); transition: color 0.3s; }
