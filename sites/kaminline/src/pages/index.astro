---
import Base from "../layouts/Base.astro";
import ProductCard from "../components/ProductCard.astro";
import Icon from "../components/Icon.astro";
import Podbor from "../components/Podbor.astro";
import Chapter from "../components/Chapter.astro";
import { products, categories, bySlug, url, img, pimg, rub, contacts, BRANDS, CAT_NOTE } from "../lib/site";

const plural = (n: number, one: string, few: string, many: string) => {
  const m10 = n % 10, m100 = n % 100;
  return m10 === 1 && m100 !== 11 ? one : m10 >= 2 && m10 <= 4 && (m100 < 12 || m100 > 14) ? few : many;
};

const catCover: Record<string, string> = {};
for (const c of categories) catCover[c.id] = products.find((p) => p.cat === c.id)!.variants[0].img[0];
catCover["kamini"] = bySlug("kamin-pech-na-pedestale").variants[0].img[0];
catCover["electro"] = bySlug("hugo-26-blue-effect-flame").variants[0].img[2] ?? catCover["electro"];
const hits = ["rio-na-drovnike", "seus", "versal", "malahitovaya-klassika", "loki", "tera", "panorama", "3d-hotline"].map(bySlug);
const slides = [
  ["s1", "Камин с прямым стеклом в светлой гостиной"],
  ["s2", "Изразцовый камин «Малахитовая классика»"],
  ["s3", "Изразцовый камин «Флорентийская мечта» в библиотеке"],
];
const works = [
  ["florence", "Флорентийская мечта", "florentiyskaya-mechta", "Изразцы ручной работы"],
  ["veranda", "Круглый камин на террасе", "kruglyy-kamin-na-opore", "Сталь, открытая терраса"],
  ["diamond", "Чёрный бриллиант", "chernyy-brilliant", "Королевский декор"],
  ["pedestal", "Камин-печь на пьедестале", "kamin-pech-na-pedestale", "Панорамное стекло"],
  ["palace", "Дворцовое наследие", "dvortsovoe-nasledie", "Светлая керамика"],
  ["manor", "Дворянская усадьба", "dvoryanskaya-usadba", "Классика из изразцов"],
];
/* the life of one fire, told by scroll: [title, text, °C at the end of the stage] */
const burn = [
  ["Растопка", "Сухие дубовые поленья, полностью открытая тяга. Воздух омывает стекло изнутри — оно остаётся чистым весь вечер.", 320],
  ["Вторичный дожиг", "Около 850 °C в топке догорают газы, которые открытый очаг выпускает в трубу. Больше тепла, почти без дыма.", 850],
  ["Жар", "Шамот и изразец впитывают тепло и отдают его комнате ещё часы после того, как пламя стихнет.", 560],
  ["Угли", "Самое ровное тепло. Современные топки отдают дому до 84% энергии дров — втрое больше открытого камина.", 280],
];
/* facing samples, laid out like a designer's swatches: [file, name, note, link] */
const mats = [
  ["marble", "Мрамор Бьянко", "Порталы собственного производства: классические профили и резьба по вашему эскизу.", "catalog/kamini/"],
  ["emerald", "Изразец изумрудный", "Рельефная глазурь ручной работы — у каждой плитки свой оттенок.", "catalog/izrazcovye-kaminy/"],
  ["black", "Литой чугун", "Дверцы и облицовка из чугуна держат жар и служат десятилетиями.", "catalog/topki/"],
  ["white", "Изразец белый", "Светлая керамика с лепниной для классических интерьеров.", "catalog/izrazcovye-kaminy/"],
];
const steps = [
  ["I", "Замер", "Специалист приезжает с оборудованием, проверяет стены, пол, фундамент и кровлю, планирует камин и дымоход."],
  ["II", "Проект", "Подбираем топку и облицовку под интерьер, показываем 3D-визуализацию и фиксируем смету под ключ."],
  ["III", "Монтаж", "Основание, топка, дымоход и облицовка — бригада устанавливает камин за три–пять дней."],
  ["IV", "Первый огонь", "Разжигаем вместе с вами и передаём камин в сервис: гарантийный и послегарантийный."],
];
---
<Base nav="home">
  <script is:inline slot="head">
    try {
      if (!sessionStorage.getItem("kl-intro") && !matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("intro");
    } catch (e) {}
  </script>

  <!-- intro: a portal is drawn in one bronze line, then the curtain lifts. Once per visit. -->
  <div class="curtain" aria-hidden="true">
    <svg viewBox="0 0 120 160" class="curtain__arch"><path d="M6 156V60a54 54 0 0 1 108 0v96" /></svg>
    <p class="curtain__word">Камин Лайн</p>
    <p class="curtain__sub">с 2006 года</p>
  </div>

  <main>
    <!-- HERO -->
    <section class="hero night" data-hero>
      <div class="hero__media">
        {slides.map(([name, alt], i) => (
          <figure class:list={["hero__slide", { on: i === 0 }]} data-slide>
            <img src={img(name, 1000)} srcset={`${img(name, 640)} 640w, ${img(name, 1000)} 1000w`} sizes="(min-width: 1000px) 52vw, 100vw" alt={alt} fetchpriority={i === 0 ? "high" : "auto"} loading={i === 0 ? "eager" : "lazy"} />
          </figure>
        ))}
        <div class="hero__count" aria-hidden="true"><span data-idx>01</span><i><b data-bar></b></i><span>03</span></div>
      </div>
      <div class="hero__text wrap">
        <p class="eyebrow hero__k" data-greet>Камины и печи под ключ</p>
        <h1 class="h1 hero__t"><span class="ln"><span>Тепло, вокруг</span></span> <span class="ln"><span>которого</span></span> <span class="ln"><span><em>собирается&nbsp;дом</em></span></span></h1>
        <p class="lead hero__lead">Камины, топки и печи лучших европейских мастерских. Порталы из мрамора и камня собственного производства. Монтаж за три–пять дней.</p>
        <div class="hero__ctas">
          <a class="btn" href={url("catalog/")}>Коллекция <Icon name="arrow" /></a>
          <a class="ulink" href={url("salon/#zamer")}>Записаться на замер</a>
        </div>
        <a class="open" href={url("salon/#visit")} data-open hidden><i></i><span></span></a>
      </div>
    </section>

    <!-- STATEMENT -->
    <section class="sec statement">
      <div class="wrap">
        <p class="statement__t" data-in>Двадцать лет мы строим камины для загородных домов, квартир и ресторанов — от подбора топки до первого огня.</p>
        <dl class="facts">
          <div data-in><dt>80+</dt><dd>европейских брендов</dd></div>
          <div data-in style="--d:.08s"><dt>3–5</dt><dd>дней на монтаж</dd></div>
          <div data-in style="--d:.16s"><dt>2006</dt><dd>год основания</dd></div>
        </dl>
      </div>
    </section>

    <!-- COLLECTIONS -->
    <section class="sec">
      <div class="wrap">
        <Chapter k="Коллекции">Выберите <em>свой огонь</em>
          <a slot="more" class="ulink" href={url("catalog/")}>Весь каталог <Icon name="arrow" /></a>
        </Chapter>
      </div>
      <div class="wrap">
        <ol class="ix" data-ix>
          {categories.map((c, i) => {
            const list = products.filter((p) => p.cat === c.id);
            const from = Math.min(...list.map((p) => p.from));
            return (
              <li data-in style={`--d:${i * 0.06}s`}>
                <a class="ix__row" href={url(`catalog/${c.id}/`)} data-src={pimg(catCover[c.id], 960)}>
                  <span class="ix__no">{String(i + 1).padStart(2, "0")}</span>
                  <span class="ix__t">{c.title}</span>
                  <span class="ix__n">{CAT_NOTE[c.id]}</span>
                  <span class="ix__c">{list.length} {plural(list.length, "модель", "модели", "моделей")} · от {rub(from)}</span>
                  <span class="ix__th arch"><img src={pimg(catCover[c.id])} alt="" loading="lazy" decoding="async" /></span>
                </a>
              </li>
            );
          })}
        </ol>
      </div>
      <div class="ix__float arch" data-float aria-hidden="true"></div>
    </section>

    <!-- BAND -->
    <section class="band night">
      <div class="band__img" data-kindle>
        <img src={img("band", 1254)} srcset={`${img("band", 700)} 700w, ${img("band", 1254)} 1254w`} sizes="100vw" alt="Изразцовый камин в гостиной загородного дома" loading="lazy" decoding="async" />
      </div>
      <div class="wrap band__text">
        <p class="eyebrow" data-in>Собственное производство</p>
        <p class="band__q" data-in>Камин выбирают однажды — и на всю жизнь дома</p>
        <a class="ulink" href={url("#works")} data-in>Наши проекты <Icon name="arrow" /></a>
      </div>
    </section>

    <!-- SELECTION -->
    <section class="sec">
      <div class="wrap">
        <Chapter k="Избранное">Модели, к которым <em>возвращаются</em></Chapter>
      </div>
      <div class="rail">{hits.map((p, i) => <ProductCard p={p} d={Math.min(i, 3) * 0.08} />)}</div>
    </section>

    <!-- BURN: one evening of fire, scrubbed by scroll -->
    <section class="burn night" data-burn>
      <div class="burn__pin">
        <div class="burn__hud wrap">
          <Chapter k="Огонь">Как горит <em>камин</em></Chapter>
  <div class="burn__img" aria-hidden="true">
            <img class="burn__cold" src={img("fire", 600)} srcset={`${img("fire", 600)} 600w, ${img("fire", 960)} 960w`} sizes="(min-width: 1000px) 56vw, 100vw" alt="" loading="lazy" decoding="async" />
            <img class="burn__warm" data-warm src={img("fire", 600)} srcset={`${img("fire", 600)} 600w, ${img("fire", 960)} 960w`} sizes="(min-width: 1000px) 56vw, 100vw" alt="" loading="lazy" decoding="async" />
            <img class="burn__ember" data-ember src={img("fire", 600)} srcset={`${img("fire", 600)} 600w, ${img("fire", 960)} 960w`} sizes="(min-width: 1000px) 56vw, 100vw" alt="" loading="lazy" decoding="async" />
          </div>
          <div class="burn__read">
            <p class="burn__deg" aria-hidden="true"><span data-deg>20</span><sup>°C</sup></p>
            <p class="burn__at">в топке</p>
          </div>
          <ol class="burn__stages">
            {burn.map(([t, d], i) => (
              <li class:list={["burn__st", { on: i === 0 }]} data-st>
                <span class="burn__n">{["I", "II", "III", "IV"][i]}</span>
                <h3 class="burn__t">{t}</h3>
                <p class="burn__d">{d}</p>
              </li>
            ))}
          </ol>
          <div class="burn__foot">
            <div class="burn__bar" aria-hidden="true"><i data-burnbar></i></div>
            <button type="button" class="burn__snd" data-sound aria-pressed="false"><span class="snd__b" aria-hidden="true"><i></i><i></i><i></i><i></i></span>Звук огня</button>
          </div>
        </div>
      </div>
    </section>

    <!-- PODBOR -->
    <section class="sec sec--night sec--after-burn night" id="podbor">
      <div class="wrap">
        <Chapter k="Подбор по комнате">Сколько тепла <em>нужно вашему дому</em></Chapter>
        <Podbor compact />
      </div>
    </section>

    <!-- WORKS -->
    <section class="sec" id="works">
      <div class="wrap">
        <Chapter k="Проекты">Интерьеры, в которых <em>живёт огонь</em></Chapter>
      </div>
      <div class="rail works">
        {works.map(([im, t, slug, note], i) => (
          <a class="work" href={url(`product/${slug}/`)}>
            <span class="work__img arch" data-kindle style={`--d:${(i % 3) * 0.15}s`}><img src={img(im, 900)} srcset={`${img(im, 480)} 480w, ${img(im, 900)} 900w`} sizes="(min-width: 1000px) 30vw, 72vw" alt={t} loading="lazy" decoding="async" /></span>
            <span class="work__t">{t}</span>
            <span class="work__n">{note}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- PRODUCTION -->
    <section class="sec">
      <div class="wrap prod">
        <div class="prod__img arch" data-kindle>
          <img src={img("versailles", 900)} srcset={`${img("versailles", 480)} 480w, ${img("versailles", 900)} 900w`} sizes="(min-width: 1000px) 40vw, 100vw" alt="Каминный портал «Версаль» из белого мрамора" loading="lazy" decoding="async" />
        </div>
        <div class="prod__text">
          <Chapter k="Мастерская">Порталы из мрамора и <em>натурального камня</em></Chapter>
          <p class="lead" data-in>Облицовку делаем по вашему эскизу или проекту дизайнера: классика, современная геометрия, минимализм. Каждый портал рождается под конкретную топку и конкретную стену.</p>
          <ul class="prod__list" data-in>
            <li>3D-визуализация камина в вашем интерьере</li>
            <li>Мрамор, гранит, оникс, искусственный камень</li>
            <li>Особые условия для дизайнеров и архитекторов</li>
          </ul>
          <a class="btn btn--ghost" href={url("salon/#zamer")} data-in>Обсудить проект <Icon name="arrow" /></a>
        </div>
      </div>
      <div class="wrap mats" data-mats>
        <p class="mats__k">Образцы облицовки · выберите</p>
        <div class="mats__fan" role="radiogroup" aria-label="Образцы облицовки" data-in>
          {mats.map(([f, n], i) => (
            <button type="button" class="mat" role="radio" aria-checked={i === 0 ? "true" : "false"} aria-label={n} data-mat={i} style={`--i:${i}`}>
              <img src={img(`mat-${f}`, 600)} alt="" loading="lazy" decoding="async" />
            </button>
          ))}
        </div>
        <div class="mats__cap">
          {mats.map(([, n, d, href], i) => (
            <div class:list={["mats__c", { on: i === 0 }]} data-cap>
              <p class="mats__n"><span class="lot">{String(i + 1).padStart(2, "0")}</span> {n}</p>
              <p class="muted">{d}</p>
              <a class="ulink" href={url(href)}>Модели <Icon name="arrow" /></a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- PROCESS -->
    <section class="sec">
      <div class="wrap">
        <Chapter k="Под ключ">От замера до <em>первого огня</em></Chapter>
        <ol class="steps">
          {steps.map(([n, t, d], i) => (
            <li class="step" data-in style={`--d:${i * 0.1}s`}>
              <span class="step__n">{n}</span>
              <h3 class="h3">{t}</h3>
              <p class="muted">{d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="brands">
      <div class="marquee" aria-label="Бренды в каталоге"><div class="marquee__track">{[0, 1].map(() => BRANDS.map((b) => <span>{b}</span>))}</div></div>
    </section>

    <!-- SALON -->
    <section class="salon night">
      <div class="salon__img" data-kindle>
        <img src={img("diamond", 900)} srcset={`${img("diamond", 480)} 480w, ${img("diamond", 900)} 900w`} sizes="(min-width: 1000px) 50vw, 100vw" alt="Камин «Чёрный бриллиант»" loading="lazy" decoding="async" />
      </div>
      <div class="salon__text">
        <Chapter k="Салон">Увидеть пламя <em>вживую</em></Chapter>
        <p class="lead" data-in>Работающие образцы в центре дизайна «Экспострой на Нахимовском». {contacts.address}, {contacts.metro}.</p>
        <p class="salon__hours" data-in>{contacts.hours}</p>
        <div class="salon__ctas" data-in>
          <a class="btn" href={url("salon/#visit")}>Выбрать время визита <Icon name="arrow" /></a>
          <a class="ulink" href={contacts.phoneHref}>{contacts.phone}</a>
        </div>
      </div>
    </section>
  </main>
</Base>

<script>
  /* greeting by the visitor's hour, salon status by Moscow time */
  {
    const h = new Date().getHours();
    const greet = h < 5 ? "Доброй ночи" : h < 12 ? "Доброе утро" : h < 17 ? "Добрый день" : "Добрый вечер";
    const tail = h >= 17 || h < 5 ? "время для огня" : "камины и печи под ключ";
    document.querySelector("[data-greet]")!.textContent = `${greet} — ${tail}`;
    const msk = new Date(new Date().toLocaleString("en-US", { timeZone: "Europe/Moscow" }));
    const day = msk.getDay(), m = msk.getHours() * 60 + msk.getMinutes();
    const close = day === 0 ? 19 : 20;
    const open = m >= 600 && m < close * 60;
    const el = document.querySelector<HTMLElement>("[data-open]")!;
    el.classList.toggle("on", open);
    el.querySelector("span")!.textContent = open ? `Салон открыт до ${close}:00 — в нём горит огонь` : m < 600 ? "Салон откроется сегодня в 10:00" : "Салон откроется завтра в 10:00";
    el.hidden = false;
  }
  /* burn: map the section's scroll to one evening of fire */
  {
    const sec = document.querySelector<HTMLElement>("[data-burn]")!;
    const warm = sec.querySelector<HTMLElement>("[data-warm]")!;
    const ember = sec.querySelector<HTMLElement>("[data-ember]")!;
    const deg = sec.querySelector<HTMLElement>("[data-deg]")!;
    const bar = sec.querySelector<HTMLElement>("[data-burnbar]")!;
    const sts = [...sec.querySelectorAll<HTMLElement>("[data-st]")];
    const T = [20, 320, 850, 560, 280]; // °C at the stage boundaries
    const smooth = (t: number) => t * t * (3 - 2 * t);
    let on = false, ticking = false, cur = -1, lastLv = -1;
    const frame = () => {
      ticking = false;
      const r = sec.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, -r.top / (r.height - innerHeight)));
      const f = p * 4, k = Math.min(3, Math.floor(f)), t = smooth(f - k);
      deg.textContent = String(Math.round((T[k] + (T[k + 1] - T[k]) * t) / 10) * 10);
      warm.style.opacity = String(Math.min(1, p / 0.42));
      ember.style.opacity = String(Math.max(0, (p - 0.6) / 0.35));
      sec.style.setProperty("--z", String(1.12 - p * 0.1));
      bar.style.transform = `scaleX(${p})`;
      if (k !== cur) { cur = k; sts.forEach((s, i) => s.classList.toggle("on", i === k)); }
      const lv = Math.round(Number(deg.textContent) / 85) / 10; // the fire's sound follows its temperature
      if (lv !== lastLv) { lastLv = lv; document.dispatchEvent(new CustomEvent("hearth", { detail: Math.max(0.15, lv) })); }
    };
    const onScroll = () => { if (on && !ticking) { ticking = true; requestAnimationFrame(frame); } };
    new IntersectionObserver(([e]) => {
      on = e.isIntersecting;
      if (on) frame(); else { lastLv = -1; document.dispatchEvent(new CustomEvent("hearth", { detail: 0.55 })); }
    }).observe(sec);
    addEventListener("scroll", onScroll, { passive: true });
  }

  /* facing samples: tap (or hover) brings a sample forward and shows its note */
  {
    const fan = document.querySelector<HTMLElement>("[data-mats]")!;
    const ms = [...fan.querySelectorAll<HTMLElement>("[data-mat]")];
    const caps = [...fan.querySelectorAll<HTMLElement>("[data-cap]")];
    const pick = (k: number) => {
      ms.forEach((m, i) => m.setAttribute("aria-checked", String(i === k)));
      caps.forEach((c, i) => c.classList.toggle("on", i === k));
    };
    ms.forEach((m, i) => {
      m.addEventListener("click", () => pick(i));
      m.addEventListener("pointerenter", (e) => { if (e.pointerType === "mouse") pick(i); });
    });
  }

  /* collection index: a preview window follows the cursor (desktop only) */
  if (matchMedia("(hover: hover) and (min-width: 1000px)").matches) {
    const ix = document.querySelector<HTMLElement>("[data-ix]")!;
    const fl = document.querySelector<HTMLElement>("[data-float]")!;
    const imgs = new Map<string, HTMLImageElement>();
    let tx = 0, ty = 0, x = 0, y = 0, raf = 0;
    const step = () => {
      x += (tx - x) * 0.14; y += (ty - y) * 0.14;
      fl.style.setProperty("--x", `${x}px`); fl.style.setProperty("--y", `${y}px`);
      raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.5 ? requestAnimationFrame(step) : 0;
    };
    ix.addEventListener("pointermove", (e) => {
      tx = e.clientX + 36; ty = e.clientY - 190;
      if (!fl.classList.contains("on")) {
        x = tx; y = ty;
        (e.target as Element).closest(".ix__row")?.dispatchEvent(new Event("pointerenter"));
      }
      if (!raf) raf = requestAnimationFrame(step);
    });
    ix.querySelectorAll<HTMLElement>(".ix__row").forEach((row) => row.addEventListener("pointerenter", () => {
      const src = row.dataset.src!;
      let im = imgs.get(src);
      if (!im) { im = new Image(); im.src = src; im.alt = ""; fl.appendChild(im); imgs.set(src, im); }
      imgs.forEach((o) => o.classList.toggle("on", o === im));
      fl.classList.add("on");
    }));
    ix.addEventListener("pointerleave", () => fl.classList.remove("on"));
    addEventListener("scroll", () => fl.classList.remove("on"), { passive: true });
  }
  const html = document.documentElement;
  const hero = document.querySelector<HTMLElement>("[data-hero]")!;
  const slides = [...hero.querySelectorAll<HTMLElement>("[data-slide]")];
  const idx = hero.querySelector("[data-idx]")!;
  const bar = hero.querySelector<HTMLElement>("[data-bar]")!;
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const HOLD = 6500;
  let i = 0, timer = 0, started = false;

  const show = (n: number) => {
    slides.forEach((s, k) => s.classList.toggle("on", k === n));
    idx.textContent = String(n + 1).padStart(2, "0");
    bar.style.transition = "none"; bar.style.transform = "scaleX(0)"; void bar.offsetWidth;
    bar.style.transition = `transform ${HOLD}ms linear`; bar.style.transform = "scaleX(1)";
  };
  const loop = () => { clearTimeout(timer); timer = window.setTimeout(() => { i = (i + 1) % slides.length; show(i); loop(); }, HOLD); };
  // run the slideshow only while the hero is on screen
  new IntersectionObserver(([e]) => {
    if (reduced || !started) return;
    if (e.isIntersecting) loop(); else clearTimeout(timer);
  }).observe(hero);

  const start = () => {
    started = true;
    hero.classList.add("lit"); // the first room warms up from darkness
    if (!reduced) { show(0); loop(); }
    setTimeout(() => slides.forEach((s) => (s.querySelector("img")!.loading = "eager")), 1500);
  };

  if (html.classList.contains("intro")) {
    let done = false;
    const finish = () => {
      if (done) return; done = true;
      try { sessionStorage.setItem("kl-intro", "1"); } catch {}
      html.classList.add("intro-out");
      setTimeout(start, 300);
      setTimeout(() => html.classList.remove("intro", "intro-out"), 1300);
    };
    requestAnimationFrame(() => html.classList.add("intro-go"));
    setTimeout(finish, 2000);
    document.querySelector(".curtain")!.addEventListener("click", finish);
  } else {
    requestAnimationFrame(start);
  }
</script>

<style is:global>
  .curtain { display: none; }
  html.intro { overflow: hidden; }
  html.intro .curtain { position: fixed; inset: 0; z-index: 300; display: grid; place-content: center; justify-items: center; gap: 16px; background: var(--night); color: var(--cream); cursor: pointer; clip-path: inset(0 0 0 0); transition: clip-path 1.1s var(--ease-io); }
  html.intro-out .curtain { clip-path: inset(0 0 100% 0); }
  .curtain__arch { width: 64px; height: 86px; overflow: visible; }
  .curtain__arch path { fill: none; stroke: var(--bronze-2); stroke-width: 1; stroke-dasharray: 400; stroke-dashoffset: 400; transition: stroke-dashoffset 1.4s var(--ease-io) 0.1s; }
  .intro-go .curtain__arch path { stroke-dashoffset: 0; }
  .curtain__word { font-family: var(--serif); font-weight: 300; font-size: 34px; letter-spacing: 0.04em; opacity: 0; transition: opacity 1s 0.7s; }
  .curtain__sub { font-size: 10px; letter-spacing: 0.32em; text-transform: uppercase; color: var(--cream-2); opacity: 0; transition: opacity 1s 0.9s; }
  .intro-go .curtain__word, .intro-go .curtain__sub { opacity: 1; }
</style>

<style>
  .sec { padding: 96px 0 0; position: relative; }
  .sec--night { padding: 96px 0; margin-top: 96px; }

  /* hero */
  .hero { position: relative; display: flex; flex-direction: column; overflow: hidden; isolation: isolate; padding-top: calc(var(--hdr) + env(safe-area-inset-top)); }
  .hero__media { position: relative; height: 62svh; min-height: 380px; z-index: -1; background: var(--night); overflow: hidden; }
  .hero__media::after { content: ""; position: absolute; inset: 0; background: linear-gradient(0deg, var(--night) 0%, rgba(15, 13, 11, 0) 28%); }
  .hero__slide { position: absolute; inset: 0; opacity: 0; transition: opacity 1.8s var(--ease-io); }
  .hero__slide.on { opacity: 1; }
  .hero__slide img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 70%; transform: scale(1.02); }
  .hero__slide.on img { animation: drift 9s linear both; }
  @keyframes drift { from { transform: scale(1.02); } to { transform: scale(1.1); } }
  /* first light: the room warms up from darkness after the intro */
  .hero .hero__slide:first-child img { filter: brightness(0.12) saturate(0.5); transition: filter 2.6s var(--ease-io); }
  .hero.lit .hero__slide:first-child img { filter: none; }
  .hero__count { position: absolute; right: var(--gut); top: 20px; z-index: 2; display: flex; align-items: center; gap: 12px; font-size: 11px; letter-spacing: 0.16em; color: var(--cream-2); font-variant-numeric: tabular-nums; }
  .hero__count i { position: relative; width: 48px; height: 1px; background: var(--nline); overflow: hidden; }
  .hero__count b { position: absolute; inset: 0; background: var(--bronze-2); transform-origin: left; transform: scaleX(0); }
  .hero__text { position: relative; display: grid; gap: 20px; margin-top: -40px; padding-bottom: 64px; }
  .hero__t { font-size: clamp(46px, 12.6vw, 112px); }
  .ln { display: block; overflow: hidden; padding-bottom: 0.06em; margin-bottom: -0.06em; }
  .ln > span { display: block; transform: translateY(105%); transition: transform 1.3s var(--ease); }
  .hero.lit .ln > span { transform: none; }
  .hero.lit .ln:nth-child(1) > span { transition-delay: 0.55s; }
  .hero.lit .ln:nth-child(2) > span { transition-delay: 0.65s; }
  .hero.lit .ln:nth-child(3) > span { transition-delay: 0.75s; }
  .hero__k, .hero__lead, .hero__ctas { opacity: 0; transform: translateY(12px); transition: opacity 1.2s var(--ease), transform 1.2s var(--ease); }
  .hero.lit .hero__k { opacity: 1; transform: none; transition-delay: 0.4s; }
  .hero.lit .hero__lead { opacity: 1; transform: none; transition-delay: 0.95s; }
  .hero.lit .hero__ctas { opacity: 1; transform: none; transition-delay: 1.1s; }
  .hero__lead { max-width: 30em; }
  .hero__ctas { display: flex; flex-wrap: wrap; align-items: center; gap: 18px 30px; }
  .hero__ctas .ulink { color: var(--cream); }
  .open { display: inline-flex; align-items: center; gap: 12px; font-size: 12.5px; color: var(--cream-2); opacity: 0; transition: opacity 1.2s var(--ease) 1.3s; }
  .hero.lit .open { opacity: 1; }
