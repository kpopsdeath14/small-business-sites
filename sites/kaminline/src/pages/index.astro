    .burn__img { position: absolute; inset: 0 0 0 40%; margin: 0; height: auto; -webkit-mask-image: none; mask-image: none; }
    .burn__pin::after { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, var(--night) 40%, rgba(15, 13, 11, 0.2) 62%, rgba(15, 13, 11, 0) 80%), linear-gradient(0deg, rgba(15, 13, 11, 0.5), transparent 30%); }
    .burn__img img { object-position: 50% 60%; }
    .burn__hud { padding-top: calc(var(--hdr) + 60px); padding-bottom: 60px; grid-template-columns: minmax(0, 520px); grid-template-rows: auto 1fr auto auto; }
    .burn__read { margin-bottom: 34px; }
    .burn__deg { font-size: min(13vw, 200px); }
    .burn__stages { min-height: 120px; }
    .burn__t { font-size: 34px; }
    .sec { padding-top: 160px; }
    .sec--night { padding: 150px 0; margin-top: 160px; }
    .hero { flex-direction: row; align-items: stretch; min-height: 100vh; padding-top: 0; }
    .hero__media { position: absolute; inset: 0 0 0 48%; height: auto; }
    .hero__slide img { object-position: 50% 50%; }
    .hero__media::after { background: linear-gradient(90deg, var(--night) 0%, rgba(15, 13, 11, 0) 22%); }
    .hero__text { width: 48%; max-width: none; margin: 0; gap: 24px; padding: calc(var(--hdr) + 40px) 56px 72px max(var(--gut), calc((100vw - var(--max)) / 2 + var(--gut))); align-content: end; }
    .hero__t { font-size: clamp(64px, 6.4vw, 108px); }
    .hero__count { top: auto; bottom: 40px; }
    .hero__media::after { background: linear-gradient(90deg, var(--night) 0%, rgba(15, 13, 11, 0) 22%); }
