    .works { grid-auto-columns: calc((min(100vw, var(--max)) - 2 * var(--gut) - 2 * 24px) / 3); }
    .steps { grid-template-columns: repeat(4, 1fr); gap: 32px; border: 0; }
    .step { grid-template-columns: 1fr; align-content: start; gap: 14px; padding: 30px 0 0; border-bottom: 0; border-top: 1px solid var(--line); }
    .step .h3, .step p { grid-column: 1; }
    .step__n { grid-row: auto; }
    .prod { grid-template-columns: 0.85fr 1fr; gap: 100px; align-items: center; }
    .mats { grid-template-columns: 1fr 0.85fr; grid-template-rows: auto 1fr; gap: 24px 100px; margin-top: 120px; align-items: center; }
    .mats__k { grid-column: 1 / -1; }
    .mats__fan { --w: 210px; --step: 150px; width: calc(var(--w) + 3 * var(--step)); height: calc(var(--w) * 1.33 + 30px); }
    .mats__n { font-size: 36px; }
    .brands { padding: 160px 0; }
    .salon { grid-template-columns: 1fr 1fr; min-height: 90vh; }
