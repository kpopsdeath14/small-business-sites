  .ix__c { grid-area: c; margin-top: 6px; font-size: 10.5px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--smoke); }
  .ix__th { grid-area: th; aspect-ratio: 4 / 5; overflow: hidden; background: var(--stone); align-self: center; }
  .ix__th img { width: 100%; height: 100%; object-fit: cover; }
