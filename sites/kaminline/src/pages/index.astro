---
import Base from "../layouts/Base.astro";
import ProductCard from "../components/ProductCard.astro";
import Icon from "../components/Icon.astro";
import Flame from "../components/Flame.astro";
import Podbor from "../components/Podbor.astro";
import { products, categories, bySlug, url, img, pimg, contacts, BRANDS, CAT_NOTE } from "../lib/site";

const catCover: Record<string, string> = {};
for (const c of categories) {
  const first = products.find((p) => p.cat === c.id)!;
  catCover[c.id] = first.variants[0].img[0];
}
catCover["kamini"] = bySlug("kamin-pech-na-pedestale").variants[0].img[0];
catCover["electro"] = bySlug("hugo-26-blue-effect-flame").variants[0].img[2] ?? catCover["electro"];
const hits = ["rio-na-drovnike", "seus", "versal", "malahitovaya-klassika", "loki", "tera", "panorama", "3d-hotline"].map(bySlug);
const works = [
  ["malachite", "Малахитовая классика", "malahitovaya-klassika"],
  ["veranda", "Круглый камин на террасе", "kruglyy-kamin-na-opore"],
  ["florence", "Флорентийская мечта", "florentiyskaya-mechta"],
  ["pedestal", "Камин-печь на пьедестале", "kamin-pech-na-pedestale"],
  ["diamond", "Чёрный бриллиант", "chernyy-brilliant"],
  ["palace", "Дворцовое наследие", "dvortsovoe-nasledie"],
  ["versailles", "Портал «Версаль»", "versal"],
  ["manor", "Дворянская усадьба", "dvoryanskaya-usadba"],
];
const steps = [
  ["Замер", "Специалист приезжает с оборудованием: смотрит стены, пол, фундамент и кровлю, планирует камин и дымоход."],
  ["Проект", "Подбираем топку и облицовку под ваш интерьер, показываем 3D-модель и считаем точную смету под ключ."],
  ["Монтаж", "Основание, топка, дымоход и облицовка — наши мастера ставят камин за 3–5 дней."],
  ["Первый огонь", "Разжигаем вместе с вами, объясняем уход. Дальше — гарантия и сервис, в том числе послегарантийный."],
];
---
<Base nav="home">
  <script is:inline slot="head">
    try {
      if (!sessionStorage.getItem("kl-ignite") && !matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("ignite");
    } catch (e) {}
  </script>

  <!-- Розжиг: a spark catches, the flame grows, the room appears. Once per visit. -->
  <div class="ig" aria-hidden="true">
    <span class="ig__spark"></span>
    <Flame class="ig__flame" />
    <p class="ig__word">Камин Лайн</p>
  </div>

  <main>
    <!-- HERO: the lights go down, the fire stays -->
    <section class="hero night">
      <div class="wrap hero__grid">
        <div class="hero__media" data-room>
          <div class="room arch">
            <img src={img("hero", 1024)} srcset={`${img("hero", 640)} 640w, ${img("hero", 1024)} 1024w`} sizes="(min-width: 1000px) 46vw, 100vw" alt="Камин с прямым стеклом в светлой гостиной" fetchpriority="high" />
            <span class="room__dim"></span>
            <span class="room__glow"></span>
            <canvas class="room__embers" data-embers="22" data-x="0.52" data-y="0.62" data-spread="0.12"></canvas>
          </div>
          <button class="room__switch" type="button" data-switch aria-pressed="false">
            <span class="room__ico room__ico--moon"><Icon name="moon" /></span>
            <span class="room__ico room__ico--sun"><Icon name="sun" /></span>
            <span data-switch-label>День</span>
          </button>
        </div>
        <div class="hero__text">
          <p class="eyebrow hero__k">Камины и печи под ключ · с 2006 года</p>
          <h1 class="h1 hero__t">Тепло, вокруг которого <em>собирается&nbsp;дом</em></h1>
          <p class="lead hero__lead">Камины, топки и печи лучших европейских мастерских. Собственное производство порталов из мрамора и камня. Монтаж за 3–5 дней.</p>
          <div class="hero__ctas">
            <a class="btn" href={url("catalog/")}>Выбрать камин <Icon name="arrow" /></a>
            <a class="btn btn--ghost" href={url("salon/#zamer")}>Заявка на замер</a>
          </div>
          <dl class="hero__facts">
            <div><dt>80+</dt><dd>брендов из Европы</dd></div>
            <div><dt>3–5</dt><dd>дней на монтаж</dd></div>
            <div><dt>20</dt><dd>лет у огня</dd></div>
          </dl>
        </div>
      </div>
    </section>

    <!-- CATEGORIES -->
    <section class="sec">
      <div class="wrap">
        <div class="sh">
          <p class="eyebrow" data-in>Каталог</p>
          <h2 class="h2" data-in>Каким будет <em>ваш огонь?</em></h2>
        </div>
        <div class="cats">
          {categories.map((c, i) => (
            <a class="cat" href={url(`catalog/${c.id}/`)} data-in style={`--d:${(i % 3) * 0.06}s`}>
              <span class="cat__img arch"><img src={pimg(catCover[c.id])} alt="" loading="lazy" decoding="async" /></span>
              <span class="cat__t">{c.title}</span>
              <span class="cat__n">{CAT_NOTE[c.id]}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- PODBOR -->
    <section class="sec sec--night night" id="podbor">
      <div class="wrap">
        <div class="sh">
          <p class="eyebrow" data-in>Подбор по комнате</p>
          <h2 class="h2" data-in>Сколько огня <em>нужно вашему дому?</em></h2>
          <p class="lead" data-in>Сдвиньте ползунок — пламя покажет, сколько тепла понадобится, а мы подберём топки и печи нужной мощности.</p>
        </div>
        <Podbor compact />
      </div>
    </section>

    <!-- HITS -->
    <section class="sec">
      <div class="wrap">
        <div class="sh sh--row">
          <div>
            <p class="eyebrow" data-in>Любимые у клиентов</p>
            <h2 class="h2" data-in>Камины, <em>к которым возвращаются</em></h2>
          </div>
          <a class="ulink" href={url("catalog/")} data-in>Весь каталог <Icon name="arrow" /></a>
        </div>
      </div>
      <div class="rail">{hits.map((p, i) => <ProductCard p={p} d={Math.min(i, 3) * 0.06} />)}</div>
    </section>

    <!-- WORKS -->
    <section class="sec works" id="works">
      <div class="wrap">
        <div class="sh">
          <p class="eyebrow" data-in>Наши камины</p>
          <h2 class="h2" data-in>Дома, в которых <em>теперь теплее</em></h2>
        </div>
      </div>
      <div class="rail works__rail">
        {works.map(([im, t, slug]) => (
          <a class="work" href={url(`product/${slug}/`)}>
            <span class="work__img arch" data-rise><img src={img(im, 480)} srcset={`${img(im, 480)} 480w, ${img(im, 900)} 900w`} sizes="(min-width: 1000px) 24vw, 68vw" alt={t} loading="lazy" decoding="async" /></span>
            <span class="work__t">{t}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- STEPS: candles light up one by one -->
    <section class="sec">
      <div class="wrap">
        <div class="sh">
          <p class="eyebrow" data-in>Под ключ</p>
          <h2 class="h2" data-in>От замера <em>до первого огня</em></h2>
        </div>
        <ol class="steps">
          {steps.map(([t, d], i) => (
            <li class="step" data-in style={`--d:${i * 0.12}s`}>
              <span class="step__candle" aria-hidden="true"><i></i></span>
              <span class="step__n">0{i + 1}</span>
              <h3 class="h3">{t}</h3>
              <p class="muted">{d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- OWN PRODUCTION -->
    <section class="sec">
      <div class="wrap prod">
        <div class="prod__img arch" data-rise>
          <img src={img("versailles", 900)} srcset={`${img("versailles", 480)} 480w, ${img("versailles", 900)} 900w`} sizes="(min-width: 1000px) 40vw, 100vw" alt="Каминный портал из белого мрамора" loading="lazy" decoding="async" />
        </div>
        <div class="prod__text">
          <p class="eyebrow" data-in>Собственное производство</p>
          <h2 class="h2" data-in>Порталы из мрамора <em>и натурального камня</em></h2>
          <p class="lead" data-in>Делаем облицовки по вашему эскизу или проекту дизайнера: классика, лофт, минимализм. Каждый портал рождается под конкретную топку и конкретную стену.</p>
          <ul class="prod__list" data-in>
            <li>3D-визуализация будущего камина в вашем интерьере</li>
            <li>Мрамор, гранит, оникс, искусственный камень</li>
            <li>Специальные условия для дизайнеров и архитекторов</li>
          </ul>
          <a class="btn btn--ghost" href={url("salon/#zamer")} data-in>Обсудить проект <Icon name="arrow" /></a>
        </div>
      </div>
    </section>

    <!-- BRANDS -->
    <section class="brands">
      <div class="marquee" aria-label="Бренды в каталоге">
        <div class="marquee__track">{[0, 1].map(() => BRANDS.map((b) => <span>{b}</span>))}</div>
      </div>
    </section>

    <!-- SALON -->
    <section class="sec sec--night night salon">
      <canvas class="embers" data-embers="6" data-y="1.02" data-spread="1.2"></canvas>
      <div class="wrap salon__in">
        <p class="eyebrow" data-in>Салон</p>
        <h2 class="h2" data-in>Посидите у живого огня, <em>прежде чем выбрать</em></h2>
        <p class="lead" data-in>Работающие образцы в {contacts.salon}: {contacts.address}, {contacts.metro}.</p>
        <p class="salon__hours" data-in><Icon name="pin" /> {contacts.hours}</p>
        <div class="hero__ctas" data-in>
          <a class="btn" href={url("salon/#visit")}>Выбрать время визита <Icon name="arrow" /></a>
          <a class="btn btn--ghost" href={contacts.phoneHref}>{contacts.phone}</a>
        </div>
      </div>
    </section>
  </main>
</Base>

<script>
  const html = document.documentElement;
  const room = document.querySelector<HTMLElement>("[data-room]")!;
  const scene = room.querySelector<HTMLElement>(".room")!;
  const glow = room.querySelector<HTMLElement>(".room__glow")!;
  const sw = room.querySelector<HTMLButtonElement>("[data-switch]")!;
  const label = room.querySelector("[data-switch-label]")!;
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

  // firelight: an irregular flicker (two slow sines + a little noise)
  let raf = 0, t0 = performance.now(), on = false;
  const flicker = (t: number) => {
    const s = (t - t0) / 1000;
    const v = 0.78 + Math.sin(s * 5.3) * 0.08 + Math.sin(s * 11.7 + 1.3) * 0.06 + (Math.random() - 0.5) * 0.08;
    glow.style.opacity = v.toFixed(3);
    glow.style.transform = `scale(${(1 + Math.sin(s * 3.1) * 0.03).toFixed(3)})`;
    raf = requestAnimationFrame(flicker);
  };
  new IntersectionObserver(([e]) => { on = e.isIntersecting; cancelAnimationFrame(raf); if (on && scene.classList.contains("eve") && !reduced) raf = requestAnimationFrame(flicker); }).observe(room);

  const setEve = (eve: boolean) => {
    scene.classList.toggle("eve", eve);
    sw.setAttribute("aria-pressed", String(eve));
    label.textContent = eve ? "Вечер" : "День";
    cancelAnimationFrame(raf);
    if (eve && on && !reduced) raf = requestAnimationFrame(flicker);
  };
  sw.addEventListener("click", () => setEve(!scene.classList.contains("eve")));

  const start = () => {
    html.classList.add("hero-on");
    setTimeout(() => setEve(true), reduced ? 0 : 1100); // "the lights go down"
  };

  if (html.classList.contains("ignite")) {
    const ig = document.querySelector<HTMLElement>(".ig")!;
    let done = false;
    const finish = () => {
      if (done) return; done = true;
      try { sessionStorage.setItem("kl-ignite", "1"); } catch {}
      html.classList.add("ignite-out");
      setTimeout(start, 250);
      setTimeout(() => html.classList.remove("ignite", "ignite-out"), 1000);
    };
    requestAnimationFrame(() => html.classList.add("ignite-go"));
    setTimeout(finish, 2100);
    ig.addEventListener("click", finish);
  } else {
    start();
  }
</script>

<style is:global>
  /* ---------- ignite intro ---------- */
  .ig { display: none; }
  html.ignite { overflow: hidden; }
  html.ignite .ig { position: fixed; inset: 0; z-index: 300; display: grid; place-content: center; justify-items: center; gap: 10px; background: radial-gradient(60% 50% at 50% 60%, #22150e 0%, #0d0907 70%); cursor: pointer; transition: opacity 0.8s var(--ease-io), visibility 0s 0.8s; }
  html.ignite-out .ig { opacity: 0; visibility: hidden; }
  .ig__flame { width: 150px; --heat: 0; }
  .ignite-go .ig__flame { --heat: 1; }
  .ig .flame__body, .ig .flame__glow { transition-duration: 1.4s !important; transition-delay: 0.45s; }
  .ig__spark { position: absolute; left: 50%; top: calc(50% + 28px); width: 6px; height: 6px; margin-left: -3px; border-radius: 50%; background: #ffe2a6; box-shadow: 0 0 16px 6px rgba(255, 170, 80, 0.9); opacity: 0; }
  .ignite-go .ig__spark { animation: strike 0.6s 0.1s var(--ease) both; }
  @keyframes strike { 0% { opacity: 0; transform: translate(-60px, 10px) scale(0.4); } 40% { opacity: 1; } 100% { opacity: 0; transform: translate(0, 0) scale(1.6); } }
  .ig__word { font-family: var(--serif); font-size: 28px; color: var(--cream); opacity: 0; transform: translateY(8px); transition: opacity 0.8s 1.1s, transform 0.9s 1.1s var(--ease); }
  .ignite-go .ig__word { opacity: 1; transform: none; }
</style>

<style>
  .sec { padding: 84px 0 0; position: relative; }
  .sec--night { padding: 84px 0; margin-top: 84px; overflow: hidden; }
  .sh--row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 16px; }
  .sh--row > div { display: grid; gap: 14px; }

  /* hero */
  .hero { padding: calc(var(--hdr) + 10px) 0 56px; overflow: hidden; }
  .hero__grid { display: grid; gap: 30px; }
  .hero__media { position: relative; }
  .room { position: relative; aspect-ratio: 1 / 1.04; background: #2a2019; isolation: isolate; }
  .room img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 60%; transform: scale(1.06); transition: transform 2.4s var(--ease), filter 1.8s var(--ease-io); }
  :global(.hero-on) .room img { transform: none; }
  .room__dim { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(14, 9, 6, 0.55), rgba(14, 9, 6, 0.25) 55%, rgba(14, 9, 6, 0.55)); opacity: 0; transition: opacity 1.8s var(--ease-io); }
  .room__glow { position: absolute; inset: -10%; background: radial-gradient(28% 26% at 52% 70%, rgba(255, 176, 90, 0.9), rgba(255, 120, 40, 0.35) 45%, rgba(255, 100, 30, 0) 75%); mix-blend-mode: screen; opacity: 0; transition: opacity 1.6s; pointer-events: none; }
  .room__embers { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transition: opacity 1.2s 0.6s; }
  .room.eve img { filter: brightness(0.5) saturate(1.15) sepia(0.12); }
  .room.eve .room__dim { opacity: 1; }
  .room.eve .room__glow { opacity: 0.8; }
  .room.eve .room__embers { opacity: 1; }
  .room__switch { position: absolute; right: 14px; bottom: 14px; z-index: 3; display: inline-flex; align-items: center; gap: 8px; height: 40px; padding: 0 14px 0 6px; border-radius: 999px; background: rgba(20, 15, 12, 0.6); color: var(--cream); font-size: 13px; font-weight: 600; backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); box-shadow: inset 0 0 0 1px rgba(243, 231, 214, 0.18); }
  .room__ico { width: 28px; height: 28px; display: grid; place-content: center; border-radius: 50%; background: rgba(243, 231, 214, 0.12); }
  .room__ico :global(svg) { width: 16px; height: 16px; }
  .room__switch[aria-pressed="true"] .room__ico--sun, .room__switch[aria-pressed="false"] .room__ico--moon { display: none; }
  .room__switch[aria-pressed="true"] .room__ico { background: rgba(242, 162, 74, 0.25); color: #ffd28c; }

  .hero__text { display: grid; gap: 18px; align-content: center; }
  .hero__k, .hero__t, .hero__lead, .hero__ctas, .hero__facts { opacity: 0; transform: translateY(14px); transition: opacity 0.9s var(--ease), transform 1s var(--ease); }
  :global(.hero-on) .hero__k { opacity: 1; transform: none; transition-delay: 0.1s; }
  :global(.hero-on) .hero__t { opacity: 1; transform: none; transition-delay: 0.2s; }
  :global(.hero-on) .hero__lead { opacity: 1; transform: none; transition-delay: 0.35s; }
  :global(.hero-on) .hero__ctas { opacity: 1; transform: none; transition-delay: 0.45s; }
  :global(.hero-on) .hero__facts { opacity: 1; transform: none; transition-delay: 0.55s; }
  :global(html:not(.js)) .hero__text > * { opacity: 1; transform: none; }
  .hero__ctas { display: grid; gap: 10px; }
  .hero__facts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; padding-top: 18px; border-top: 1px solid var(--nline); }
  .hero__facts dt { font-family: var(--serif); font-size: 30px; line-height: 1; background: var(--glow); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .hero__facts dd { font-size: 12.5px; color: var(--cream-2); margin-top: 6px; line-height: 1.35; }

  /* categories */
  .cats { display: grid; grid-auto-flow: column; grid-auto-columns: 44%; gap: 12px; margin: 0 calc(var(--gut) * -1); padding: 0 var(--gut) 4px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding: 0 var(--gut); scrollbar-width: none; }
  .cats::-webkit-scrollbar { display: none; }
  .cat { scroll-snap-align: start; }
  .cat { display: grid; gap: 6px; }
  .cat__img { aspect-ratio: 4 / 5; background: var(--sand); }
  .cat__img img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease); }
  @media (hover: hover) { .cat:hover .cat__img img { transform: scale(1.05); } }
  .cat__t { font-family: var(--serif); font-size: 21px; margin-top: 6px; }
  .cat__n { font-size: 13.5px; color: var(--smoke); line-height: 1.4; }

  /* works */
  .works__rail { grid-auto-columns: 66%; }
  .work { display: grid; gap: 10px; }
  .work__img { aspect-ratio: 4 / 5; background: var(--sand); }
  .work__img img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease); }
  @media (hover: hover) { .work:hover .work__img img { transform: scale(1.04); } }
  .work__t { font-family: var(--serif); font-size: 18px; }

  /* steps */
  .steps { display: grid; gap: 0; border-top: 1px solid var(--line); }
  .step { position: relative; display: grid; grid-template-columns: 44px 1fr; gap: 4px 14px; padding: 22px 0; border-bottom: 1px solid var(--line); }
  .step .h3, .step p { grid-column: 2; }
  .step__n { position: absolute; right: 0; top: 24px; font-family: var(--serif); color: var(--smoke); }
  .step__candle { grid-row: span 2; position: relative; width: 14px; height: 40px; margin: 2px auto 0; }
  .step__candle::before { content: ""; position: absolute; left: 3px; right: 3px; bottom: 0; height: 22px; border-radius: 3px 3px 2px 2px; background: linear-gradient(90deg, #efe2cf, #fbf3e6, #e4d4bd); box-shadow: inset 0 -2px 0 rgba(0, 0, 0, 0.05); }
  .step__candle i { position: absolute; left: 50%; bottom: 22px; width: 8px; height: 13px; margin-left: -4px; border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%; background: radial-gradient(circle at 50% 70%, #fff4cf, #ffb547 55%, #f06a1d); box-shadow: 0 0 12px 3px rgba(255, 170, 80, 0.5); transform-origin: 50% 100%; transform: scale(0); transition: transform 0.7s var(--ease); transition-delay: calc(var(--d) + 0.3s); }
  .step.in .step__candle i { transform: scale(1); animation: candle 1.6s ease-in-out infinite alternate; animation-delay: calc(var(--d) + 1s); }
  @keyframes candle { 0% { transform: scale(1) skewX(-3deg); } 50% { transform: scale(0.94, 1.08) skewX(4deg); } 100% { transform: scale(1.04, 0.96) skewX(-2deg); } }

  /* production */
  .prod { display: grid; gap: 30px; }
  .prod__img { aspect-ratio: 4 / 5; background: var(--sand); }
  .prod__img img { width: 100%; height: 100%; object-fit: cover; }
  .prod__text { display: grid; gap: 18px; align-content: center; justify-items: start; }
  .prod__list { display: grid; gap: 10px; }
  .prod__list li { position: relative; padding-left: 26px; color: var(--ink-2); }
  .prod__list li::before { content: ""; position: absolute; left: 4px; top: 0.55em; width: 9px; height: 9px; border-radius: 50%; background: var(--ember); box-shadow: 0 0 10px rgba(242, 162, 74, 0.7); }

  .brands { padding: 84px 0 0; }

  .salon { text-align: center; }
  .salon__in { position: relative; display: grid; gap: 18px; justify-items: center; }
  .salon .lead { margin: 0 auto; }
  .salon__hours { display: inline-flex; align-items: center; gap: 8px; color: var(--cream-2); font-size: 14.5px; }
  .salon__hours :global(svg) { width: 16px; height: 16px; color: var(--flame); }
  .salon .hero__ctas { opacity: 1; transform: none; width: 100%; max-width: 420px; }

  @media (min-width: 640px) {
    .cats { grid-auto-columns: 30%; }
    .works__rail { grid-auto-columns: 38%; }
    .hero__ctas { display: flex; flex-wrap: wrap; }
  }
  @media (min-width: 1000px) {
    .sec { padding-top: 140px; }
