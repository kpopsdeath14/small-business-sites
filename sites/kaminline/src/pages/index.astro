  @keyframes breathe { 0%, 100% { opacity: 0; transform: scale(0.6); } 50% { opacity: 0.7; transform: scale(1); } }

  /* statement */
  .statement__t { font-family: var(--serif); font-weight: 300; font-size: clamp(28px, 6.8vw, 54px); line-height: 1.22; max-width: 22em; }
  .facts { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 48px; border-top: 1px solid var(--line); }
  .facts div { padding: 22px 12px 0 0; }
