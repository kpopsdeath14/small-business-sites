  .burn__st.on { opacity: 1; transform: none; }
  .burn__n { grid-row: span 2; font-family: var(--serif); font-style: italic; font-size: 22px; color: var(--bronze-2); line-height: 1.2; }
  .burn__t { font-family: var(--serif); font-weight: 400; font-size: 28px; line-height: 1.1; }
  .burn__d { font-size: 14px; line-height: 1.6; color: var(--cream-2); max-width: 30em; }
  .burn__bar { position: relative; height: 1px; margin-top: 22px; background: var(--nline); }
