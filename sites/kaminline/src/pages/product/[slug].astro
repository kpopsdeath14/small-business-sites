---
import Base from "../../layouts/Base.astro";
import ProductCard from "../../components/ProductCard.astro";
import Icon from "../../components/Icon.astro";
import { products, bySlug, url, pimg, rub, catTitle, area } from "../../lib/site";

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug } }));
}
const p = bySlug(Astro.params.slug!);
const v = p.variants[0];
const multi = p.variants.length > 1;
const related = products.filter((x) => x.cat === p.cat && x.slug !== p.slug).concat(products.filter((x) => x.cat !== p.cat)).slice(0, 8);
const vdata = p.variants.map((x) => ({ id: x.id, l: x.label, p: x.price, o: x.old, img: x.img, sc: x.scene }));
const flames = p.kw ? Math.min(5, Math.max(1, Math.round(p.kw / 2))) : 0;
const desc = `${p.name}${p.sub ? ` — ${p.sub.toLowerCase()}` : ""}. Цена ${rub(p.from)}. Замер, проект и монтаж под ключ от «Камин Лайн».`;
---
<Base title={`${p.name} — купить в Камин Лайн`} description={desc} nav="catalog">
  <main class="pp">
    <div class="wrap">
      <nav class="crumbs" aria-label="Навигация">
        <a href={url()}>Главная</a><span>/</span><a href={url("catalog/")}>Каталог</a><span>/</span><a href={url(`catalog/${p.cat}/`)}>{catTitle(p.cat)}</a>
      </nav>
    </div>

    <div class="wrap pp__grid">
      <section class="gal" aria-label="Фотографии" data-gal>
        <div class="gal__frame">
          <div class="gal__track" data-track>
            {v.img.map((id, i) => (
              <figure class:list={["gal__slide", { scene: v.scene[i] }]}><img src={pimg(id, 960)} srcset={`${pimg(id)} 480w, ${pimg(id, 960)} 960w`} sizes="(min-width: 1000px) 46vw, 100vw" alt={`${p.name}, фото ${i + 1}`} loading={i === 0 ? "eager" : "lazy"} decoding="async" /></figure>
            ))}
          </div>
        </div>
        <div class="gal__dots" data-dots aria-hidden="true">{v.img.map((_, i) => <i class:list={{ on: i === 0 }}></i>)}</div>
        <div class="gal__thumbs" data-thumbs>
          {v.img.map((id, i) => <button type="button" class:list={{ on: i === 0 }} data-i={i} aria-label={`Фото ${i + 1}`}><img src={pimg(id)} alt="" loading="lazy" /></button>)}
        </div>
      </section>

      <section class="buy">
        <p class="eyebrow">{catTitle(p.cat)}{p.country && ` · ${p.country}`}</p>
        <h1 class="h2 buy__t">{p.name}</h1>
        {p.sub && <p class="lead buy__sub">{p.sub}</p>}

        <div class="buy__price">
          <p class="buy__p" data-price>{rub(v.price)}</p>
          <s class="buy__old" data-old hidden={!v.old}>{v.old ? rub(v.old) : ""}</s>
        </div>

        {multi && (
          <div class="vpick">
            <p class="muted">Вариант</p>
            <div class="vpick__row" role="radiogroup" aria-label="Вариант">
              {p.variants.map((x, i) => (
                <button type="button" role="radio" aria-checked={i === 0 ? "true" : "false"} data-v={x.id}>
                  {x.sw[0] && <i style={`background:${x.sw[0]}`}></i>}{x.label}
                </button>
              ))}
            </div>
          </div>
        )}

        <div class="buy__act" data-buybox>
          <div class="qty" role="group" aria-label="Количество">
            <button type="button" data-q="-1" aria-label="Меньше">−</button><output data-qv></output><button type="button" data-q="1" aria-label="Больше">+</button>
          </div>
          <button class="btn buy__add" type="button" data-add={v.id}>В корзину <Icon name="bag" /></button>
        </div>
        <a class="btn btn--ghost btn--block" href={url(`salon/?p=${encodeURIComponent(p.name)}#zamer`)}>Заявка на замер</a>

        {p.kw && (
          <div class="heat">
            <p class="heat__v">{area(p.kw)}<small> м²</small></p>
            <p class="heat__t">Обогреет помещение до {area(p.kw)} м²<span>{p.kw} кВт · {(p.fuel || "дрова").toLowerCase()}</span></p>
          </div>
        )}

        <ul class="perks">
          <li><span>Замер и проект</span><span>Специалист приедет, проверит стены, пол и дымоход, покажет 3D-модель</span></li>
          <li><span>Монтаж</span><span>Топка, дымоход и облицовка — за 3–5 дней</span></li>
          <li><span>Гарантия</span><span>{p.warranty ? `${p.warranty} от производителя` : "На изделие и на нашу работу"}, сервис и после неё</span></li>
        </ul>
      </section>
    </div>

    {(p.desc.length > 0 || p.specs.length > 0) && (
      <section class="wrap info">
        {p.desc.length > 0 && (
          <div class="info__desc">
            <p class="eyebrow" data-in>О модели</p>
            {p.desc.map((d, i) => <p class:list={["lead", { "info__first": i === 0 }]} data-in>{d}</p>)}
          </div>
        )}
        {p.specs.length > 0 && (
          <div>
            <p class="eyebrow" data-in>Характеристики</p>
            <div class="acc">
              {p.specs.map((g, i) => (
                <details open={i < 2}>
                  <summary>{g.g}<i></i></summary>
                  <dl class="spec">{g.rows.map(([k, val]) => <div><dt>{k}</dt><dd>{val}</dd></div>)}</dl>
                </details>
              ))}
            </div>
          </div>
        )}
      </section>
    )}

    <section class="rel">
      <div class="wrap"><div class="sh"><p class="eyebrow">Коллекция</p><h2 class="h2">Вам может <em>понравиться</em></h2></div></div>
      <div class="rail">{related.map((x, i) => <ProductCard p={x} d={Math.min(i, 3) * 0.06} />)}</div>
    </section>

    <div class="sbar" data-sbar>
      <div><p class="sbar__n">{p.name}</p><p class="sbar__p" data-price>{rub(v.price)}</p></div>
      <button class="btn" type="button" data-add={v.id}>В корзину</button>
    </div>
    <script is:inline type="application/json" id="pdata" set:html={JSON.stringify({ v: vdata })} />
  </main>
</Base>

<script>
  import { cart, rollPrice, gear, BASE } from "../../scripts/cart";
  import { syncButtons } from "../../scripts/app";
  const D = JSON.parse(document.getElementById("pdata")!.textContent!) as { v: { id: string; l: string; p: number; o: number | null; img: string[]; sc: boolean[] }[] };
  const $ = <T extends Element = HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const $$ = <T extends Element = HTMLElement>(s: string) => [...document.querySelectorAll<T>(s)];
  const pimg = (id: string, w = 480) => `${BASE}/p/${id}-${w}.webp`;
  const rub = (n: number) => n.toLocaleString("ru-RU").replace(/\s/g, " ") + " ₽";

  // gallery
  const track = $("[data-track]");
  let n = D.v[0].img.length;
  const cur = () => Math.round(track.scrollLeft / track.clientWidth);
  const setIdx = (i: number) => {
    $$("[data-dots] i").forEach((d, j) => d.classList.toggle("on", j === i));
    $$("[data-thumbs] button").forEach((b, j) => b.classList.toggle("on", j === i));
  };
  track.addEventListener("scroll", () => requestAnimationFrame(() => setIdx(cur())), { passive: true });
  $("[data-thumbs]").addEventListener("click", (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>("[data-i]");
    if (b) track.scrollTo({ left: Number(b.dataset.i) * track.clientWidth, behavior: "smooth" });
  });
  // stepper appears only once the item is in the cart and edits the cart directly
  const qv = $("[data-qv]");
  const act = $("[data-buybox]");
  const adds = $$<HTMLElement>("[data-add]").filter((b) => !b.closest(".card"));
  const curId = () => adds[0].dataset.add!;
  const inCartQ = () => cart.lines().find((l) => l.id === curId())?.q;
  $$("[data-q]").forEach((b) => b.addEventListener("click", () => {
    const cq = inCartQ(); if (cq === undefined) return;
    const nq = cq + Number(b.dataset.q);
    if (nq < 1) cart.remove(curId()); else cart.set(curId(), Math.min(99, nq));
  }));
  const showQ = () => {
    const cq = inCartQ();
    act.classList.toggle("has-qty", cq !== undefined);
    if (cq === undefined) return;
    const shown = Number(qv.textContent);
    if (cq !== shown) { qv.textContent = String(cq); if (shown) gear(qv, cq > shown ? 1 : -1); }
  };
  document.addEventListener("cart:sync", showQ);
  showQ();

  // variants
  const pick = (id: string, push = true) => {
    const v = D.v.find((x) => x.id === id); if (!v) return;
    $$(".vpick__row [data-v]").forEach((b) => b.setAttribute("aria-checked", String(b.dataset.v === id)));
    $$("[data-price]").forEach((el) => rollPrice(el, v.p));
    const old = $("[data-old]"); old.hidden = !v.o; old.textContent = v.o ? rub(v.o) : "";
    adds.forEach((a) => (a.dataset.add = v.id));
    syncButtons();
    n = v.img.length;
    track.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 180, easing: "ease-in", fill: "forwards" }).onfinish = () => {
      track.innerHTML = v.img.map((im, i) => `<figure class="gal__slide${v.sc[i] ? " scene" : ""}"><img src="${pimg(im, 960)}" srcset="${pimg(im)} 480w, ${pimg(im, 960)} 960w" sizes="(min-width: 1000px) 46vw, 100vw" alt="Фото ${i + 1}" decoding="async"></figure>`).join("");
      $("[data-dots]").innerHTML = v.img.map((_, i) => `<i class="${i ? "" : "on"}"></i>`).join("");
      $("[data-thumbs]").innerHTML = v.img.map((im, i) => `<button type="button" class="${i ? "" : "on"}" data-i="${i}" aria-label="Фото ${i + 1}"><img src="${pimg(im)}" alt=""></button>`).join("");
      track.scrollLeft = 0;
      const first = track.querySelector("img")!;
      const show = () => track.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 420, easing: "cubic-bezier(.22,1,.36,1)", fill: "forwards" });
      first.complete ? show() : first.addEventListener("load", show, { once: true });
    };
    if (push) history.replaceState(null, "", `?v=${id}`);
  };
  $$(".vpick__row [data-v]").forEach((b) => b.addEventListener("click", () => pick(b.dataset.v!)));
  const pre = new URLSearchParams(location.search).get("v");
  if (pre && pre !== D.v[0].id) pick(pre, false);

  const sbar = $("[data-sbar]");
  new IntersectionObserver(([e]) => {
    const on = !e.isIntersecting && e.boundingClientRect.top < 0;
    sbar.classList.toggle("on", on);
    document.body.classList.toggle("has-sbar", on && innerWidth < 1000);
  }).observe(act);
</script>

<style>
  .pp { padding-top: calc(var(--hdr) + 16px); }
  .pp__grid { display: grid; gap: 26px; }

  .gal { position: relative; }
  .gal__frame { position: relative; aspect-ratio: 4 / 5; background: var(--stone); overflow: hidden; }
  .gal__track { display: flex; height: 100%; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; overscroll-behavior-x: contain; touch-action: pan-x pan-y; }
  .gal__track::-webkit-scrollbar { display: none; }
  .gal :global(.gal__slide) { flex: 0 0 100%; height: 100%; scroll-snap-align: center; }
  .gal :global(.gal__slide img) { width: 100%; height: 100%; object-fit: cover; }
  .gal__dots { display: flex; justify-content: center; gap: 6px; margin-top: 12px; }
  .gal__dots :global(i) { width: 18px; height: 1px; background: var(--line-2); transition: background 0.4s, width 0.5s var(--ease); }
  .gal__dots :global(i.on) { width: 34px; background: var(--ink); }
  .gal__thumbs { display: none; }

  .buy { display: grid; gap: 16px; align-content: start; }
  .buy__t { font-size: clamp(32px, 8vw, 54px); }
  .buy__sub { margin-top: -6px; }
  .buy__price { display: flex; align-items: baseline; gap: 12px; padding: 14px 0; border-block: 1px solid var(--line); }
  .buy__p { font-family: var(--serif); font-weight: 300; font-size: 40px; font-variant-numeric: lining-nums tabular-nums; }
  .buy__old { color: var(--smoke); font-size: 16px; }
  .vpick { display: grid; gap: 10px; }
  .vpick__row { display: flex; flex-wrap: wrap; gap: 8px; }
  .vpick__row button { display: inline-flex; align-items: center; gap: 10px; min-height: 46px; padding: 0 18px; border: 1px solid var(--line-2); font-size: 14px; transition: border-color 0.3s, background 0.3s, color 0.3s; }
  .vpick__row button i { width: 12px; height: 12px; box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.18); }
  .vpick__row button[aria-checked="true"] { border-color: var(--ink); box-shadow: inset 0 0 0 1px var(--ink); }
  .buy__act { display: grid; grid-template-columns: 1fr; gap: 8px; }
  .buy__act .qty { display: none; height: 54px; }
  .buy__act.has-qty { grid-template-columns: auto 1fr; }
  .buy__act.has-qty .qty { display: inline-grid; }

  .heat { display: grid; grid-template-columns: auto 1fr; gap: 20px; align-items: center; padding: 18px 0; border-block: 1px solid var(--line); }
  .heat__v { font-family: var(--serif); font-weight: 300; font-size: 54px; line-height: 1; color: var(--bronze); }
  .heat__v small { font-size: 22px; }
  .heat__t { font-size: 14.5px; line-height: 1.5; }
  .heat__t span { display: block; font-size: 10.5px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--smoke); margin-top: 4px; }
  .perks { display: grid; border-top: 1px solid var(--line); }
  .perks li { display: grid; grid-template-columns: 112px 1fr; gap: 12px; padding: 13px 0; border-bottom: 1px solid var(--line); font-size: 14px; color: var(--ink-2); }
  .perks li span:first-child { font-size: 10.5px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink); padding-top: 3px; }

  .info { display: grid; gap: 48px; margin-top: 72px; }
  .info__desc { display: grid; gap: 16px; }
  .info__first { font-family: var(--serif); font-weight: 300; font-size: 26px; line-height: 1.4; color: var(--ink); }
  .spec { display: grid; padding-bottom: 14px; }
  .spec div { display: flex; justify-content: space-between; gap: 16px; padding: 9px 0; border-bottom: 1px dashed var(--line); font-size: 14.5px; }
  .spec div:last-child { border-bottom: 0; }
  .spec dt { color: var(--smoke); }
  .spec dd { text-align: right; font-weight: 500; }
  .rel { margin-top: 88px; }

  .sbar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 90; display: flex; align-items: center; justify-content: space-between; gap: 14px; padding: 10px var(--gut) calc(10px + env(safe-area-inset-bottom)); background: rgba(250, 246, 240, 0.92); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border-top: 1px solid var(--line); transform: translateY(105%); transition: transform 0.5s var(--ease); }
  .sbar.on { transform: none; }
  .sbar > div { min-width: 0; }
  .sbar__n { font-size: 13px; color: var(--smoke); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .sbar__p { font-family: var(--serif); font-size: 22px; font-variant-numeric: tabular-nums; }
  .sbar .btn { min-height: 48px; padding: 0 22px; flex: none; }
  .sbar .btn :global(.btn__go) { display: none; }

  @media (min-width: 1000px) {
    .pp { padding-top: calc(var(--hdr) + 30px); }
    .pp__grid { grid-template-columns: 1fr 1fr; gap: 72px; align-items: start; }
    .gal { position: sticky; top: calc(var(--hdr) + 24px); }
    .gal__dots { display: none; }
    .gal__thumbs { display: grid; grid-template-columns: repeat(6, 1fr); gap: 8px; margin-top: 10px; }
    .gal__thumbs :global(button) { aspect-ratio: 4 / 5; overflow: hidden; opacity: 0.5; transition: opacity 0.3s; background: var(--stone); }
    .gal__thumbs :global(button.on), .gal__thumbs :global(button:hover) { opacity: 1; }
    .gal__thumbs :global(img) { width: 100%; height: 100%; object-fit: cover; }
    .buy { padding-top: 12px; }
    .info { grid-template-columns: 1.1fr 1fr; gap: 80px; margin-top: 120px; align-items: start; }
    .rel { margin-top: 140px; }
    .sbar { display: none; }
  }
</style>
