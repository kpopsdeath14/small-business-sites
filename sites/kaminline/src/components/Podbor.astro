---
// Room calculator: drag the area, the flame grows, matching wood-burning models appear.
// Rule of thumb from stove makers: ~1 kW of heat per 10 m² (ceilings up to ~2.7 m).
import Flame from "./Flame.astro";
import Icon from "./Icon.astro";
import { products, pimg, url, rub } from "../lib/site";

interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const wood = products.filter((p) => p.kw && p.kw >= 5).map((p) => ({ s: p.slug, n: p.name, kw: p.kw, p: p.from, i: p.variants[0].img[0], c: p.cat }));
const decor = products.filter((p) => p.cat === "biokamini" || p.cat === "electro").map((p) => ({ s: p.slug, n: p.name, kw: 0, p: p.from, i: p.variants[0].img[0], c: p.cat }));
---
<div class:list={["pb", { "pb--compact": compact }]} data-podbor>
  <div class="pb__stage">
    <canvas class="pb__embers" data-embers="14" data-x="0.5" data-y="0.62" data-spread="0.18"></canvas>
    <Flame class="pb__flame" />
    <p class="pb__kw"><span data-kw>3</span><small> кВт</small></p>
  </div>

  <div class="pb__ctl">
    <div class="pb__row">
      <label class="pb__label" for="pb-area">Площадь комнаты</label>
      <output class="pb__val" for="pb-area"><span data-area>30</span> м²</output>
    </div>
    <input id="pb-area" class="pb__range" type="range" min="10" max="150" step="5" value="30" />
    <div class="pb__ticks" aria-hidden="true"><span>10</span><span>50</span><span>100</span><span>150 м²</span></div>

    <div class="pb__seg" role="radiogroup" aria-label="Что важнее">
      <label><input type="radio" name="pb-mode" value="heat" checked /><span>Греть дом</span></label>
      <label><input type="radio" name="pb-mode" value="decor" /><span>Атмосфера без дымохода</span></label>
    </div>

    <p class="pb__note" data-note></p>
    {!compact && <div class="pb__list" data-list></div>}
    {compact && <a class="btn btn--cream pb__go" href={url("podbor/")} data-go>Показать подходящие <Icon name="arrow" /></a>}
  </div>
</div>

<script is:inline type="application/json" id="pb-data" set:html={JSON.stringify({ wood, decor, base: url("") })} />

<script>
  const root = document.querySelector<HTMLElement>("[data-podbor]")!;
  const D = JSON.parse(document.getElementById("pb-data")!.textContent!) as { base: string; wood: { s: string; n: string; kw: number; p: number; i: string; c: string }[]; decor: { s: string; n: string; kw: number; p: number; i: string; c: string }[] };
  const range = root.querySelector<HTMLInputElement>(".pb__range")!;
  const flame = root.querySelector<HTMLElement>(".flame")!;
  const out = root.querySelector("[data-area]")!;
  const kwEl = root.querySelector("[data-kw]")!;
  const note = root.querySelector("[data-note]")!;
  const listEl = root.querySelector<HTMLElement>("[data-list]");
  const go = root.querySelector<HTMLAnchorElement>("[data-go]");
  const rub = (n: number) => n.toLocaleString("ru-RU").replace(/\s/g, " ") + " ₽";
  const img = (id: string) => `${D.base}p/${id}-480.webp`;
  const qs = new URLSearchParams(location.search);
  if (qs.get("a")) range.value = qs.get("a")!;
  if (qs.get("m") === "decor") root.querySelector<HTMLInputElement>('input[value="decor"]')!.checked = true;

  let shown = "";
  function update() {
    const a = Number(range.value);
    const mode = root.querySelector<HTMLInputElement>('input[name="pb-mode"]:checked')!.value;
    const need = Math.max(3, Math.ceil(a / 10));
    out.textContent = String(a);
    kwEl.textContent = mode === "heat" ? String(need) : "—";
    const heat = mode === "heat" ? Math.min(1, 0.25 + (a - 10) / 140 * 0.75) : 0.45;
    flame.style.setProperty("--heat", heat.toFixed(2));
    range.style.setProperty("--p", `${((a - 10) / 140) * 100}%`);
    let picks: typeof D.wood = [];
    if (mode === "heat") {
      const fit = D.wood.filter((x) => x.kw >= need).sort((x, y) => x.kw - y.kw || x.p - y.p);
      const minKw = fit.length ? fit[0].kw : 0;
      picks = fit.filter((x) => x.kw <= Math.max(need, minKw) + 1);
      const cnt = (n: number) => `${n} ${n === 1 ? "модель" : n < 5 ? "модели" : "моделей"}`;
      note.textContent = !fit.length
        ? `Для ${a} м² нужно около ${need} кВт — больше, чем даёт одна топка из каталога. Подберём мощную печь или систему с теплообменником на замере.`
        : need < minKw
          ? `Для ${a} м² хватит ${need} кВт. Самые компактные дровяные модели — от ${minKw} кВт: их топят вполсилы, и в комнате не жарко. Подходят ${cnt(picks.length)}.`
          : `Для ${a} м² нужно около ${need} кВт. Подходят ${cnt(picks.length)} — топки и печи на дровах.`;
    } else {
      picks = D.decor.slice().sort((x, y) => x.p - y.p);
      note.textContent = "Био- и электрокамины не требуют дымохода и согласований — живой огонь или 3D-пламя для квартиры. Это атмосфера, а не отопление.";
    }
    if (go) go.href = `${D.base}podbor/?a=${a}&m=${mode}`;
    if (!listEl) return;
    const key = picks.map((p) => p.s).join(",");
    if (key === shown) return;
    shown = key;
    listEl.innerHTML = picks.slice(0, 8).map((p, i) => `
      <a class="pb__item" href="${D.base}product/${p.s}/" style="--d:${i * 0.05}s">
        <span class="pb__img"><img src="${img(p.i)}" alt="" loading="lazy"></span>
        <span class="pb__n">${p.n}</span>
        <span class="pb__m">${p.kw ? `${p.kw} кВт · до ${p.kw * 10} м²` : "без дымохода"}</span>
        <span class="pb__p">от ${rub(p.p)}</span>
      </a>`).join("");
  }
  range.addEventListener("input", update);
  root.addEventListener("change", update);
  update();
</script>

<style>
  .pb { display: grid; gap: 22px; }
  .pb__stage { position: relative; height: 300px; display: grid; place-items: end center; border-radius: 999px 999px 24px 24px; overflow: hidden; background: radial-gradient(70% 55% at 50% 100%, #3a2216 0%, #1b130e 60%, #140f0c 100%); box-shadow: inset 0 0 0 1px rgba(243, 231, 214, 0.08); }
  .pb__stage::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 24px; background: linear-gradient(0deg, #0c0907, transparent); }
  .pb__embers { position: absolute; inset: 0; width: 100%; height: 100%; }
  .pb :global(.pb__flame) { width: 190px; margin-bottom: 4px; }
  .pb__kw { position: absolute; left: 50%; top: 22%; transform: translateX(-50%); font-family: var(--serif); font-size: 44px; line-height: 1; color: var(--cream); text-shadow: 0 0 24px rgba(242, 162, 74, 0.5); }
  .pb__kw small { font-family: var(--sans); font-size: 15px; color: var(--cream-2); }
  .pb__ctl { display: grid; gap: 14px; align-content: start; }
  .pb__row { display: flex; justify-content: space-between; align-items: baseline; }
  .pb__label { font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--cream-2); }
  .pb__val { font-family: var(--serif); font-size: 34px; }
  .pb__range { --p: 14%; -webkit-appearance: none; appearance: none; width: 100%; height: 34px; background: transparent; cursor: pointer; }
  .pb__range::-webkit-slider-runnable-track { height: 4px; border-radius: 4px; background: linear-gradient(90deg, #f6c46b, #ee8a33 var(--p), rgba(243, 231, 214, 0.16) var(--p)); }
  .pb__range::-moz-range-track { height: 4px; border-radius: 4px; background: linear-gradient(90deg, #f6c46b, #ee8a33 var(--p), rgba(243, 231, 214, 0.16) var(--p)); }
  .pb__range::-webkit-slider-thumb { -webkit-appearance: none; width: 30px; height: 30px; margin-top: -13px; border-radius: 50%; background: radial-gradient(circle at 40% 35%, #ffe2a6, #f2a24a 55%, #c9521f); box-shadow: 0 0 0 6px rgba(242, 162, 74, 0.18), 0 0 22px rgba(242, 162, 74, 0.7); }
  .pb__range::-moz-range-thumb { width: 30px; height: 30px; border: 0; border-radius: 50%; background: radial-gradient(circle at 40% 35%, #ffe2a6, #f2a24a 55%, #c9521f); box-shadow: 0 0 0 6px rgba(242, 162, 74, 0.18), 0 0 22px rgba(242, 162, 74, 0.7); }
  .pb__ticks { display: flex; justify-content: space-between; margin-top: -8px; font-size: 12px; color: var(--cream-2); }
  .pb__seg { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; padding: 5px; border-radius: 999px; background: rgba(243, 231, 214, 0.07); }
  .pb__seg label { position: relative; cursor: pointer; }
  .pb__seg input { position: absolute; opacity: 0; pointer-events: none; }
  .pb__seg span { display: grid; place-content: center; min-height: 44px; padding: 6px 10px; border-radius: 999px; text-align: center; font-size: 13.5px; line-height: 1.2; color: var(--cream-2); transition: background 0.35s, color 0.35s; }
  .pb__seg input:checked + span { background: var(--cream); color: var(--night); }
  .pb__note { font-size: 15px; color: var(--cream-2); line-height: 1.55; min-height: 3.1em; }
  .pb__go { justify-self: start; }
  .pb__list { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 6px; }
  .pb :global(.pb__item) { display: grid; gap: 4px; padding: 8px 8px 12px; border-radius: 120px 120px 16px 16px; background: rgba(243, 231, 214, 0.05); border: 1px solid var(--nline); animation: pbIn 0.6s var(--ease) both; animation-delay: var(--d); transition: border-color 0.3s, background 0.3s; }
  @media (hover: hover) { .pb :global(.pb__item:hover) { border-color: rgba(242, 162, 74, 0.5); background: rgba(243, 231, 214, 0.08); } }
  @keyframes pbIn { from { opacity: 0; transform: translateY(10px); } }
  .pb :global(.pb__img) { aspect-ratio: 4 / 5; border-radius: 120px 120px 10px 10px; overflow: hidden; background: var(--sand); }
  .pb :global(.pb__img img) { width: 100%; height: 100%; object-fit: cover; }
  .pb :global(.pb__n) { font-family: var(--serif); font-size: 16px; line-height: 1.2; margin-top: 4px; }
  .pb :global(.pb__m) { font-size: 12.5px; color: var(--flame); }
  .pb :global(.pb__p) { font-size: 14px; font-weight: 600; }
  @media (min-width: 900px) {
    .pb { grid-template-columns: 0.9fr 1.1fr; gap: 56px; align-items: start; }
    .pb__stage { height: 440px; position: sticky; top: calc(var(--hdr) + 24px); }
    .pb :global(.pb__flame) { width: 260px; }
    .pb__list { grid-template-columns: repeat(3, 1fr); }
    .pb--compact .pb__stage { position: relative; top: 0; }
  }
</style>
