---
interface Props { name: "arrow" | "bag" | "close" | "plus" | "phone" | "tg" | "check" | "flame" | "moon" | "sun" | "pin" | "mail"; class?: string }
const { name, class: cls } = Astro.props;
---
<svg class={cls} width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === "arrow" && <path d="M5 12h14M13 6l6 6-6 6" />}
  {name === "bag" && <><path d="M5 8h14l-1.2 12H6.2z" /><path d="M9 8V6.5a3 3 0 0 1 6 0V8" /></>}
  {name === "close" && <path d="M6 6l12 12M18 6L6 18" />}
  {name === "plus" && <path d="M12 5v14M5 12h14" />}
  {name === "check" && <path d="M5 12.5l4.5 4.5L19 7.5" />}
  {name === "phone" && <path d="M6.6 10.8a15 15 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z" />}
  {name === "tg" && <path d="M21 4.5L3.5 11.3c-.9.4-.9 1.6.1 1.9l4.3 1.4 1.7 5.2c.2.7 1.1.9 1.6.3l2.4-2.5 4.4 3.3c.6.4 1.4.1 1.6-.6L22.2 5.6c.2-.8-.5-1.4-1.2-1.1zM9.5 14.4l8-6.2" />}
  {name === "flame" && <path d="M12 21c3.6 0 6-2.4 6-5.6 0-3.4-2.6-5.2-3.4-8.4-.3 1.6-1.1 2.7-2.2 3.3.2-2.9-.9-5.6-3.4-7.3.2 3.4-3.1 5.6-3.1 9.6C5.9 18.4 8.5 21 12 21z" />}
  {name === "moon" && <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" />}
  {name === "sun" && <><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" /></>}
  {name === "pin" && <><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" /></>}
  {name === "mail" && <><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3.5 6l8.5 7 8.5-7" /></>}
</svg>
