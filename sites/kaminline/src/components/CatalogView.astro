---
import Base from "../layouts/Base.astro";
import ProductCard from "./ProductCard.astro";
import Icon from "./Icon.astro";
import { products, categories, url, catTitle, CAT_NOTE } from "../lib/site";

interface Props { cat?: string }
const { cat } = Astro.props;
const list = cat ? products.filter((p) => p.cat === cat) : products;
const title = cat ? catTitle(cat) : "Каталог";
const note = cat ? CAT_NOTE[cat] : "Камины, топки, печи, био- и электрокамины лучших европейских мастерских";
---
<Base title={`${title} — Камин Лайн`} description={`${title}: ${note}. Проект, монтаж за 3–5 дней и сервис.`} nav="catalog">
  <main>
    <section class="ph">
      <div class="wrap">
        <nav class="crumbs" aria-label="Навигация">
          <a href={url()}>Главная</a><span>/</span>
          {cat ? <><a href={url("catalog/")}>Каталог</a><span>/</span><span>{title}</span></> : <span>Каталог</span>}
        </nav>
        <div class="cv-head">
          <h1 class="h1" data-in>{cat ? title : <>Коллекция</>}</h1>
          <p class="lead" data-in>{note}</p>
        </div>
      </div>
    </section>

    <div class="bar">
      <nav class="chips wrap" aria-label="Категории">
        <a href={url("catalog/")} aria-current={!cat ? "page" : undefined}>Все <sup>{products.length}</sup></a>
        {categories.map((c) => (
          <a href={url(`catalog/${c.id}/`)} aria-current={cat === c.id ? "page" : undefined}>{c.title} <sup>{products.filter((p) => p.cat === c.id).length}</sup></a>
        ))}
      </nav>
    </div>

    <section class="wrap list">
      <div class="list__meta">
        <p class="muted"><span class="num">{list.length}</span> {list.length % 10 === 1 && list.length !== 11 ? "модель" : [2, 3, 4].includes(list.length % 10) && ![12, 13, 14].includes(list.length) ? "модели" : "моделей"}</p>
        <label class="sort">
          <span class="muted">Порядок</span>
          <select data-sort>
            <option value="pop">Как в салоне</option>
            <option value="asc">Сначала доступнее</option>
            <option value="desc">Сначала дороже</option>
          </select>
        </label>
      </div>
      <div class="grid" data-grid>
        {list.map((p, i) => <ProductCard p={p} d={(i % 4) * 0.05} eager={i < 4} showCat={!cat} />)}
      </div>
      <aside class="hint night" data-in>
        <div>
          <p class="eyebrow">Не уверены, что выбрать?</p>
          <p class="h3">Подберём камин под площадь и задачу</p>
        </div>
        <a class="btn" href={url("podbor/")}>Подбор по площади <Icon name="arrow" /></a>
      </aside>
    </section>
  </main>
</Base>

<script>
  const grid = document.querySelector<HTMLElement>("[data-grid]")!;
  const sel = document.querySelector<HTMLSelectElement>("[data-sort]")!;
  const cards = [...grid.children] as HTMLElement[];
  sel.addEventListener("change", () => {
    const v = sel.value;
    const sorted = v === "pop" ? cards : [...cards].sort((a, b) => (Number(a.dataset.price) - Number(b.dataset.price)) * (v === "asc" ? 1 : -1));
    grid.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 160, fill: "forwards" }).onfinish = () => {
      sorted.forEach((c) => grid.appendChild(c));
      grid.animate([{ opacity: 0, transform: "translateY(8px)" }, { opacity: 1, transform: "none" }], { duration: 500, easing: "cubic-bezier(.22,1,.36,1)", fill: "forwards" });
    };
  });
  const chips = document.querySelector<HTMLElement>(".chips")!;
  const act = chips.querySelector<HTMLElement>('[aria-current="page"]');
  if (act) chips.scrollLeft = act.offsetLeft - (chips.clientWidth - act.offsetWidth) / 2;
</script>

<style>
  .cv-head { display: grid; gap: 14px; }
  .bar { position: sticky; top: calc(var(--hdr) + env(safe-area-inset-top)); z-index: 50; background: rgba(243, 238, 231, 0.9); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border-block: 1px solid var(--line); }
  .chips { display: flex; gap: 28px; overflow-x: auto; padding-block: 0; scrollbar-width: none; }
  .chips::-webkit-scrollbar { display: none; }
  .chips a { position: relative; flex: none; display: inline-flex; align-items: center; gap: 6px; height: 54px; font-size: 11px; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase; color: var(--smoke); transition: color 0.3s; }
  .chips a::after { content: ""; position: absolute; left: 0; right: 0; bottom: -1px; height: 1px; background: var(--ink); transform: scaleX(0); transition: transform 0.6s var(--ease); }
  .chips a:hover, .chips a[aria-current] { color: var(--ink); }
  .chips a[aria-current]::after { transform: none; }
  .chips sup { font-size: 9px; letter-spacing: 0; color: var(--bronze); }
  .list { padding-top: 22px; }
  .list__meta { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; font-size: 14px; }
  .sort { display: inline-flex; align-items: center; gap: 8px; }
  .sort select { -webkit-appearance: none; appearance: none; border: 0; background: transparent; font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; padding: 6px 18px 6px 0; background-image: linear-gradient(45deg, transparent 50%, currentColor 50%), linear-gradient(135deg, currentColor 50%, transparent 50%); background-position: right 6px center, right 2px center; background-size: 4px 4px; background-repeat: no-repeat; }
  .hint { display: grid; gap: 22px; margin-top: 72px; padding: 36px 26px; }
  .hint .h3 { margin-top: 10px; }
  .hint .btn { justify-self: start; }
  @media (min-width: 1000px) {
    .cv-head { grid-template-columns: 1.2fr 1fr; align-items: end; gap: 60px; }
    .list { padding-top: 34px; }
    .hint { grid-template-columns: 1fr auto; align-items: center; padding: 36px 44px; margin-top: 90px; }
  }
</style>
