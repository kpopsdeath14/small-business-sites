---
// A hand-drawn three-tongue flame on logs. Pure SVG + CSS, no images.
// `--heat` (0..1) scales the flame — used by the room calculator and the checkout finale.
interface Props { class?: string; logs?: boolean }
const { class: cls, logs = true } = Astro.props;
const u = Math.random().toString(36).slice(2, 7); // gradient ids must be unique per instance
---
<div class:list={["flame", cls]} aria-hidden="true">
  <span class="flame__glow"></span>
  <svg viewBox="0 0 200 240" class="flame__svg">
    <defs>
      <radialGradient id={`fl-out-${u}`} cx="50%" cy="85%" r="75%">
        <stop offset="0" stop-color="#ffd27a" /><stop offset=".45" stop-color="#f28a2e" /><stop offset="1" stop-color="#b8330e" stop-opacity=".0" />
      </radialGradient>
      <radialGradient id={`fl-mid-${u}`} cx="50%" cy="88%" r="70%">
        <stop offset="0" stop-color="#fff2c9" /><stop offset=".5" stop-color="#ffb347" /><stop offset="1" stop-color="#f06a1d" stop-opacity=".0" />
      </radialGradient>
      <radialGradient id={`fl-core-${u}`} cx="50%" cy="90%" r="65%">
        <stop offset="0" stop-color="#ffffff" /><stop offset=".55" stop-color="#ffe7a6" /><stop offset="1" stop-color="#ffc35c" stop-opacity="0" />
      </radialGradient>
    </defs>
    <g class="flame__body">
      <path class="t t1" d="M100 214c-44 0-66-30-58-66 6-28 28-40 30-74 18 22 20 42 18 58 10-10 16-26 14-52 30 26 46 58 44 92-2 26-20 42-48 42z" fill={`url(#fl-out-${u})`} />
      <path class="t t2" d="M100 214c-30 0-46-22-40-48 5-20 20-30 22-52 12 16 14 30 12 42 8-8 12-20 10-38 22 20 32 42 30 64-2 20-16 32-34 32z" fill={`url(#fl-mid-${u})`} />
      <path class="t t3" d="M100 214c-17 0-27-13-23-29 3-12 12-19 13-33 8 10 9 19 8 27 5-5 8-12 7-23 13 12 19 26 18 38-1 13-10 20-23 20z" fill={`url(#fl-core-${u})`} />
    </g>
    {logs && (
      <g class="flame__logs">
        <rect x="34" y="208" width="132" height="18" rx="9" transform="rotate(-8 100 217)" fill="#3a2418" />
        <rect x="34" y="208" width="132" height="18" rx="9" transform="rotate(8 100 217)" fill="#4a2e1e" />
        <ellipse cx="100" cy="214" rx="46" ry="6" fill="#ff8a3a" opacity=".55" class="flame__coal" />
      </g>
    )}
  </svg>
</div>

<style>
  .flame { --heat: 1; position: relative; width: 100%; aspect-ratio: 200 / 240; }
  .flame__svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .flame__glow { position: absolute; left: 50%; bottom: 4%; width: 140%; aspect-ratio: 1; transform: translateX(-50%) scale(calc(0.4 + var(--heat) * 0.6)); border-radius: 50%; background: radial-gradient(closest-side, rgba(255, 170, 80, 0.45), rgba(255, 120, 40, 0.12) 55%, transparent); filter: blur(6px); transition: transform 0.8s var(--ease); animation: glow 2.6s ease-in-out infinite alternate; }
  .flame__body { transform-origin: 100px 214px; transform: scale(calc(0.25 + var(--heat) * 0.75)); transition: transform 0.9s var(--ease); mix-blend-mode: screen; }
  .t { transform-box: fill-box; transform-origin: 50% 100%; }
  .t1 { animation: t1 1.7s ease-in-out infinite alternate; }
  .t2 { animation: t2 1.25s ease-in-out infinite alternate; }
  .t3 { animation: t3 0.9s ease-in-out infinite alternate; }
  @keyframes t1 { 0% { transform: scale(1, 0.96) skewX(-2deg); } 50% { transform: scale(0.97, 1.04) skewX(3deg); } 100% { transform: scale(1.02, 0.99) skewX(-4deg); } }
  @keyframes t2 { 0% { transform: scale(1, 1) skewX(3deg); } 60% { transform: scale(0.95, 1.07) skewX(-3deg); } 100% { transform: scale(1.03, 0.97) skewX(2deg); } }
  @keyframes t3 { 0% { transform: scale(0.96, 1.02); } 100% { transform: scale(1.04, 0.94) skewX(-3deg); } }
  @keyframes glow { 0% { opacity: 0.85; } 40% { opacity: 1; } 70% { opacity: 0.78; } 100% { opacity: 0.95; } }
  .flame__coal { animation: coal 1.6s ease-in-out infinite alternate; }
  @keyframes coal { to { opacity: 0.9; } }
</style>
