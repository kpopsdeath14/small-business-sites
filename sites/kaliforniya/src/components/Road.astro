---
/**
 * Delivery as a road trip: type your city and a van drives out of Yoshkar-Ola; a green highway
 * sign counts the kilometres (straight-line distance) while the road scrolls under it.
 * Facts are theirs: free to the carrier's pick-up point, pay on receipt, KIT/PEK/SDEK/DPD/Post.
 */
// [city, lat, lon]
const cities: [string, number, number][] = [
  ["Москва", 55.75, 37.62], ["Санкт-Петербург", 59.94, 30.31], ["Казань", 55.79, 49.12], ["Нижний Новгород", 56.33, 44.0], ["Чебоксары", 56.14, 47.25], ["Самара", 53.2, 50.15], ["Уфа", 54.74, 55.97], ["Екатеринбург", 56.84, 60.6], ["Пермь", 58.01, 56.25], ["Киров", 58.6, 49.66], ["Ижевск", 56.85, 53.2], ["Ульяновск", 54.32, 48.4], ["Саратов", 51.53, 46.03], ["Волгоград", 48.71, 44.51], ["Воронеж", 51.66, 39.2], ["Ростов-на-Дону", 47.24, 39.7], ["Краснодар", 45.04, 38.98], ["Сочи", 43.6, 39.73], ["Ярославль", 57.63, 39.87], ["Владимир", 56.13, 40.41], ["Иваново", 57.0, 40.97], ["Тула", 54.2, 37.62], ["Рязань", 54.63, 39.74], ["Пенза", 53.2, 45.0], ["Оренбург", 51.77, 55.1], ["Челябинск", 55.16, 61.4], ["Тюмень", 57.15, 65.53], ["Омск", 54.99, 73.37], ["Новосибирск", 55.03, 82.92], ["Красноярск", 56.01, 92.85], ["Иркутск", 52.29, 104.3], ["Хабаровск", 48.48, 135.08], ["Владивосток", 43.12, 131.89], ["Калининград", 54.71, 20.51], ["Мурманск", 68.97, 33.07], ["Архангельск", 64.54, 40.54], ["Вологда", 59.22, 39.89], ["Тверь", 56.86, 35.9], ["Смоленск", 54.78, 32.05], ["Белгород", 50.6, 36.59], ["Астрахань", 46.35, 48.04], ["Махачкала", 42.98, 47.5], ["Ставрополь", 45.04, 41.97], ["Симферополь", 44.95, 34.1], ["Сыктывкар", 61.67, 50.84], ["Набережные Челны", 55.74, 52.4], ["Тольятти", 53.51, 49.42], ["Йошкар-Ола", 56.63, 47.89],
];
---
<div class="rd" data-rd>
  <div class="rd__scene">
    <svg class="rd__hills" viewBox="0 0 400 120" preserveAspectRatio="none" aria-hidden="true"><path d="M0 80 C 60 40, 110 70, 170 50 S 290 30, 400 60 V120 H0Z" fill="#e6b48a" /><path d="M0 95 C 80 70, 150 95, 230 78 S 340 70, 400 88 V120 H0Z" fill="#d9976a" /></svg>
    <i class="rd__sun"></i>
    <div class="rd__road"><i class="rd__lines"></i></div>
    <svg class="rd__van" viewBox="0 0 120 60" aria-hidden="true">
      <rect x="4" y="12" width="78" height="34" rx="6" fill="#fff" stroke="#1f2328" stroke-width="2.5" />
      <path d="M82 22 H100 L114 36 V46 H82 Z" fill="#f2b544" stroke="#1f2328" stroke-width="2.5" stroke-linejoin="round" />
      <path d="M88 26 H99 L108 35 H88 Z" fill="#9fd0ef" />
      <text x="43" y="33" text-anchor="middle" font-size="8.5" font-weight="700" fill="#c65a35" font-family="Montserrat Alternates, sans-serif">Калифорния</text>
      <circle cx="26" cy="48" r="8" fill="#1f2328" class="rd__wh" /><circle cx="96" cy="48" r="8" fill="#1f2328" class="rd__wh" />
      <circle cx="26" cy="48" r="3" fill="#ccc" /><circle cx="96" cy="48" r="3" fill="#ccc" />
    </svg>
    <div class="rd__sign" aria-live="polite">
      <p><span>Йошкар-Ола</span><b class="num">0</b></p>
      <p><span data-to>Ваш город</span><b class="num" data-km>—</b></p>
      <small>км по прямой</small>
    </div>
  </div>
  <form class="rd__form" data-form>
    <label class="field"><span>Куда везём?</span><input class="input" list="rd-cities" placeholder="Начните вводить город" data-city autocomplete="address-level2" /></label>
    <datalist id="rd-cities">{cities.map(([c]) => <option value={c} />)}</datalist>
    <button class="btn" type="submit">В путь</button>
  </form>
  <ul class="rd__facts">
    <li><b>0 ₽</b>до пункта выдачи ТК в вашем городе</li>
    <li><b>SMS</b>когда заказ приедет</li>
    <li><b>При получении</b>оплата наличными или картой</li>
    <li><b>КИТ · ПЭК · СДЭК · DPD · Почта</b>на выбор</li>
  </ul>
  <p class="rd__fine">Для Якутии, Дальнего Востока, Крыма и ещё нескольких регионов условия доставки уточнит менеджер.</p>
</div>

<script define:vars={{ cities }}>
  const el = document.querySelector("[data-rd]");
  const input = el.querySelector("[data-city]"), km = el.querySelector("[data-km]"), to = el.querySelector("[data-to]");
  const [, la0, lo0] = cities.find((c) => c[0] === "Йошкар-Ола");
  const rad = (d) => (d * Math.PI) / 180;
  const dist = (a, b) => { const dl = rad(b[0] - a[0]), dn = rad(b[1] - a[1]); const h = Math.sin(dl / 2) ** 2 + Math.cos(rad(a[0])) * Math.cos(rad(b[0])) * Math.sin(dn / 2) ** 2; return 2 * 6371 * Math.asin(Math.sqrt(h)); };
  let raf = 0;
  function go(name) {
    const c = cities.find((x) => x[0].toLowerCase() === name.trim().toLowerCase());
    if (!c) { to.textContent = name.trim() || "Ваш город"; km.textContent = "—"; el.classList.remove("drive"); return; }
    const d = Math.round(dist([la0, lo0], [c[1], c[2]]));
    to.textContent = c[0];
    el.classList.remove("drive"); void el.offsetWidth; el.classList.add("drive");
    const t0 = performance.now(), T = Math.min(3600, 900 + d * 0.9);
    cancelAnimationFrame(raf);
    const run = (t) => { const k = Math.min(1, (t - t0) / T), e = 1 - Math.pow(1 - k, 3); km.textContent = Math.round(d * e).toLocaleString("ru-RU"); if (k < 1) raf = requestAnimationFrame(run); else el.classList.add("arrived"); };
    el.classList.remove("arrived");
    raf = requestAnimationFrame(run);
  }
  el.querySelector("[data-form]").addEventListener("submit", (e) => { e.preventDefault(); go(input.value); });
  input.addEventListener("change", () => go(input.value));
</script>

<style>
  .rd { display: grid; gap: 16px; }
  .rd__scene { position: relative; aspect-ratio: 16 / 8; border-radius: 22px; overflow: hidden; background: linear-gradient(180deg, #f6c58e, #f5dcb8 60%); }
  .rd__scene > * { position: absolute; }
  .rd__sun { width: 13%; aspect-ratio: 1; border-radius: 50%; left: 12%; top: 14%; background: radial-gradient(circle, #fff3c4, #ffc35a 60%, #f39a3d); }
  .rd__hills { left: 0; right: 0; bottom: 26%; width: 100%; height: 40%; }
  .rd__road { left: 0; right: 0; bottom: 0; height: 30%; background: #4a4a4f; }
  .rd__lines { position: absolute; left: 0; right: 0; top: 46%; height: 6%; background: repeating-linear-gradient(90deg, #f2d06b 0 40px, transparent 40px 80px); }
  .drive:not(.arrived) .rd__lines { animation: road 0.5s linear infinite; }
  @keyframes road { to { background-position: -80px 0; } }
  .rd__van { left: 6%; bottom: 8%; width: 24%; max-width: 260px; transition: left 1.2s var(--ease); }
  .drive:not(.arrived) .rd__van { animation: bounce 0.35s ease-in-out infinite alternate; }
  @keyframes bounce { to { transform: translateY(-2px); } }
  .drive:not(.arrived) .rd__wh { animation: none; }
  .arrived .rd__van { left: 36%; }
  /* the highway sign, green with white letters, on two posts */
  .rd__sign { right: 6%; top: 10%; min-width: 46%; padding: 10px 14px 8px; border-radius: 8px; background: #1e6b45; color: #fff; box-shadow: inset 0 0 0 3px #fff, 0 6px 14px rgba(0, 0, 0, 0.2); font-weight: 600; }
  .rd__sign::before, .rd__sign::after { content: ""; position: absolute; top: 100%; width: 5px; height: 200%; background: #8a8f96; z-index: -1; }
  .rd__sign::before { left: 22%; } .rd__sign::after { right: 22%; }
  .rd__sign p { display: flex; justify-content: space-between; gap: 14px; font-size: clamp(13px, 3.6vw, 18px); line-height: 1.5; }
  .rd__sign b { font-weight: 700; }
  .rd__sign small { display: block; text-align: right; font-size: 10.5px; opacity: 0.75; }
  .rd__form { display: grid; grid-template-columns: 1fr auto; gap: 8px; align-items: end; }
  .rd__facts { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .rd__facts li { padding: 14px; border-radius: 16px; background: #fff; font-size: 14px; color: var(--ink-2); line-height: 1.35; }
  .rd__facts b { display: block; font-family: var(--display); font-size: 17px; color: var(--pacific); margin-bottom: 2px; }
  .rd__fine { font-size: 13px; color: var(--mute); }
  @media (min-width: 1000px) { .rd__facts { grid-template-columns: repeat(4, 1fr); } .rd__scene { aspect-ratio: 16 / 5; } .rd__van { width: 18%; } .rd__sign { min-width: 30%; } }
</style>
