---
import Base from "../layouts/Base.astro";
import Intro from "../components/Intro.astro";
import Calc from "../components/Calc.astro";
import Craft from "../components/Craft.astro";
import { img, pimg, url, contacts, rub } from "../lib/site";

// our stairs, tagged by look so the gallery can filter
const works: [string, string, string][] = [
  ["mod2", "light", "Белая на больцах, гнутая тетива"], ["st-097", "curve", "Винтовая, вид сверху"], ["st-013", "dark", "Тёмная гнутая лестница"],
  ["st-117", "light", "Светлая с забежными"], ["st-049", "honey", "Г-образная, поворот с забежными"], ["mod3", "light", "Белая на больцах у окна"],
  ["st-016", "dark", "Тёмная, взгляд в пролёт"], ["st-096", "curve", "Гнутый поручень, улитка"], ["st-104", "honey", "Столб и поручень"],
  ["st-000", "dark", "Классика: белые балясины"], ["st-121", "light", "Светлые забежные"], ["st-045", "curve", "Круглый пролёт"],
  ["st-012", "dark", "Тёмная, поворот 180°"], ["st-064", "honey", "Забежные ступени сверху"], ["mod4", "light", "Белая с подсветкой потолка"],
  ["st-047", "honey", "Овальное ограждение пролёта"], ["st-123", "light", "Светлая гнутая"], ["st-126", "dark", "Ступени на бетонном марше"],
  ["st-086", "detail", "Завиток поручня"], ["st-107", "detail", "Столб с шаром"], ["st-078", "detail", "Фигурные ступени"], ["st-113", "detail", "Профиль ступени"],
];
const filters = [["all", "Все"], ["light", "Светлые"], ["dark", "Тёмные"], ["honey", "Медовые"], ["curve", "Гнутые и винтовые"], ["detail", "Детали"]];
const renders = [71, 74, 78, 80, 82, 83, 84, 85, 72];
const more = [
  ["door-hram", "Двери исторические", "Для храмов и старых домов — по образцу и обмерам.", ""],
  ["win-hist", "Окна исторические", "Арочные и слуховые окна из дерева — для реставрации и храмов.", ""],
  ["analoy", "Изделия для храмов", "Аналои, престолы, полки для икон, церковные лавки.", ""],
  ["bath-door", "Банные двери", "ГОСТ со стеклом «бронза», 1,5–2 м × 0,7 м.", `от ${rub(9545)}`],
  ["bath-lavka", "Банные лавки", "Лавки «Дуэт» из хвои, 1–2 м, в сборе.", `от ${rub(3570)}`],
  ["aged-table", "Мебель со старением", "Стол, лавка и табуреты под палисандр — новая линейка.", ""],
  ["door-in", "Входные утеплённые двери", "Массив с уплотнителем для дома и дачи.", ""],
  ["door-slide", "Раздвижные двери и арки", "Деревянные перегородки, арки, межкомнатные двери.", ""],
];
---
<Base>
  <Intro />
  <main>
    <section class="hero wrap">
      <div class="hero__txt">
        <p class="kick" data-in><b>Ясень</b> · Кунгур, с {contacts.since} года</p>
        <h1 class="h1" data-in style="--d:.06s">Лестницы <i>из массива</i> — от расчёта до <span class="hl">последней ступени</span></h1>
        <p class="read" data-in style="--d:.12s">Проектируем, делаем и ставим деревянные лестницы для дома: из клеёной сосны, а на заказ — из ясеня, дуба и ильма. Посчитайте свою прямо здесь — по нашему прайсу.</p>
        <div class="hero__cta" data-in style="--d:.18s">
          <a class="btn" href="#calc">Посчитать лестницу</a>
          <a class="btn btn--line" href="#works">Наши лестницы</a>
        </div>
      </div>
      <figure class="hero__ph" data-in style="--d:.1s">
        <img src={img("mod1", 1200)} srcset={`${img("mod1", 600)} 600w, ${img("mod1", 1200)} 1200w`} sizes="(min-width: 1000px) 40vw, 92vw" alt="Белая лестница на больцах с гнутой тетивой работы «Ясеня»" width="1200" height="1500" fetchpriority="high" />
        <figcaption class="mono">Лестница на больцах работы «Ясеня»</figcaption>
      </figure>
      <ul class="hero__facts mono" data-in>
        <li><b>8–10 %</b>влажность после наших сушильных камер</li>
        <li><b>1–2 дня</b>установка лестницы</li>
        <li><b>3D</b>проект до изготовления</li>
      </ul>
    </section>

    <section class="sec" id="calc">
      <div class="wrap">
        <div class="sh" data-in>
          <p class="kick">01 · Посчитать лестницу</p>
          <h2 class="h2">Сколько ступеней <i>и во сколько</i> обойдётся</h2>
          <p class="read">Укажите высоту от пола до пола и форму. Посчитаем подъём по формуле удобного шага, нарисуем марш и соберём смету деталей по прайсу «Ясеня».</p>
        </div>
        <Calc />
      </div>
    </section>

    <section class="sec project" id="project">
      <div class="wrap">
        <div class="sh" data-in>
          <p class="kick">02 · 3D-проект</p>
          <h2 class="h2">Сначала <i>чертёж</i>, потом дерево</h2>
          <p class="read">В 80% заявок о лестнице вспоминают, когда дом уже построен и выдержать ГОСТ трудно. Мы начинаем с проекта: подбираем марш под проём, считаем ступени и показываем лестницу в 3D — до первого реза.</p>
        </div>
        <blockquote class="project__q" data-in>
          <p>«Спасибо вам. Вы были правы, настояв на данном варианте».</p>
          <cite class="mono">— из благодарностей заказчиков, с которыми начали с проекта</cite>
        </blockquote>
      </div>
      <div class="project__rail" data-in>
        {renders.map((r) => <img src={img(`r-${r}`, 600)} srcset={`${img(`r-${r}`, 600)} 600w, ${img(`r-${r}`, 1200)} 1200w`} sizes="(min-width: 1000px) 30vw, 72vw" alt="3D-проект лестницы «Ясеня»" loading="lazy" width="600" height="600" />)}
      </div>
    </section>

    <section class="sec works" id="works">
      <div class="wrap">
        <div class="sh" data-in>
          <p class="kick">03 · Наши лестницы</p>
          <h2 class="h2">Поднимитесь <i>по нашим</i></h2>
        </div>
        <div class="works__f" role="radiogroup" aria-label="Фильтр">
          {filters.map(([id, t], i) => <button type="button" role="radio" aria-checked={i === 0 ? "true" : "false"} data-f={id}>{t}</button>)}
        </div>
        <!-- the gallery climbs: each card sits a step higher than the one before -->
        <ul class="works__g" data-works>
          {works.map(([ph, tag, cap], i) => (
            <li data-tag={tag} style={`--k:${i % 4}`}>
              <button type="button" data-zoom={ph} aria-label={cap}>
                <img src={img(ph, 600)} alt={cap} loading="lazy" width="600" height="450" />
                <span class="mono">{cap}</span>
              </button>
            </li>
          ))}
        </ul>
      </div>
      <div class="zoom" data-zoombox hidden>
        <button class="zoom__x" type="button" aria-label="Закрыть" data-zclose><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 5l14 14M19 5L5 19" /></svg></button>
        <img alt="" data-zimg />
        <p class="mono" data-zcap></p>
      </div>
    </section>

    <section class="sec craft" id="craft">
      <div class="wrap">
        <div class="sh" data-in>
          <p class="kick">04 · Как делаем</p>
          <h2 class="h2">Срез <i>одной ступени</i></h2>
        </div>
        <Craft />
      </div>
    </section>

    <section class="sec more" id="more">
      <div class="wrap">
        <div class="sh" data-in>
          <p class="kick">05 · Мастерская</p>
          <h2 class="h2">А ещё <i>двери, окна</i> и мебель</h2>
          <p class="read">Тот же цех, та же сушка и та же клеёная древесина — для храмов, бань, домов и дач.</p>
        </div>
        <ul class="more__g">
          {more.map(([ph, t, d, pr], i) => (
            <li data-in style={`--d:${(i % 4) * 0.05}s`}>
              <img src={pimg(ph, 480)} srcset={`${pimg(ph, 480)} 480w, ${pimg(ph, 960)} 960w`} sizes="(min-width: 1000px) 22vw, 46vw" alt={t} loading="lazy" width="480" height="480" />
              <p class="more__t">{t}</p>
              <p class="more__d">{d}</p>
              {pr && <p class="mono more__p">{pr}</p>}
            </li>
          ))}
        </ul>
        <a class="btn btn--line" href={`mailto:${contacts.email}?subject=${encodeURIComponent("Вопрос по изделию")}`} data-in>Спросить про изделие</a>
      </div>
    </section>
  </main>
</Base>

<script>
  // gallery filter
  const g = document.querySelector<HTMLElement>("[data-works]")!;
  const fs = [...document.querySelectorAll<HTMLButtonElement>("[data-f]")];
  fs.forEach((b) => b.addEventListener("click", () => {
    fs.forEach((x) => x.setAttribute("aria-checked", String(x === b)));
    const f = b.dataset.f!;
    let k = 0;
    g.querySelectorAll<HTMLElement>("li").forEach((li) => { const show = f === "all" || li.dataset.tag === f; li.hidden = !show; if (show) li.style.setProperty("--k", String(k++ % 4)); });
  }));
  // zoom
  const box = document.querySelector<HTMLElement>("[data-zoombox]")!;
  const zi = box.querySelector<HTMLImageElement>("[data-zimg]")!;
  let last: HTMLElement | null = null;
  g.querySelectorAll<HTMLButtonElement>("[data-zoom]").forEach((b) => b.addEventListener("click", () => {
    last = b; zi.src = (b.querySelector("img") as HTMLImageElement).src.replace("-600.webp", "-1200.webp"); zi.alt = b.getAttribute("aria-label")!;
    box.querySelector("[data-zcap]")!.textContent = b.getAttribute("aria-label");
    box.hidden = false; document.documentElement.classList.add("zoom-open"); box.querySelector<HTMLButtonElement>("[data-zclose]")!.focus();
  }));
  const close = () => { box.hidden = true; document.documentElement.classList.remove("zoom-open"); last?.focus(); };
  box.addEventListener("click", (e) => { if (e.target === box || (e.target as HTMLElement).closest("[data-zclose]")) close(); });
  addEventListener("keydown", (e) => { if (e.key === "Escape" && !box.hidden) close(); });
</script>

<style>
  .hero { padding-top: calc(var(--hdr) + env(safe-area-inset-top) + 22px); padding-bottom: 20px; display: grid; gap: 26px; }
  .hero__txt { display: grid; gap: 18px; }
  .hl { background: linear-gradient(transparent 62%, rgba(201, 140, 74, 0.45) 62%); }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 10px; }
  .hero__cta .btn { flex: 1 1 200px; }
  .hero__ph { position: relative; }
  .hero__ph::before { content: ""; position: absolute; z-index: -1; left: 18%; right: 0; top: 9%; bottom: -14px; background: linear-gradient(135deg, var(--leaf), var(--forest)); box-shadow: inset -6px 0 0 var(--honey); }
  .hero__ph img { position: relative; width: 88% !important; box-shadow: 0 24px 50px -24px rgba(30, 58, 40, 0.55); }
  .hero__ph figcaption { margin-top: 22px !important; }
  .hero__ph img { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 60%; }
  .hero__ph figcaption { margin-top: 8px; font-size: 13px; color: var(--mute); }
  .hero__facts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; padding-top: 16px; border-top: 1.5px solid var(--ink); font-size: 12.5px; line-height: 1.35; color: var(--ink-2); }
  .hero__facts b { display: block; font-weight: 400; font-size: 21px; color: var(--ink); margin-bottom: 4px; }

  .project { background: var(--warm); }
  .project .kick b, .project .h2 i { color: #9a5b22; }
  .project__q { border-left-color: var(--honey) !important; }
  .project__q { margin: 0 0 32px; padding-left: 18px; border-left: 3px solid var(--leaf); max-width: 34em; }
  .project__q p { font-family: var(--display); font-style: italic; font-size: clamp(22px, 5vw, 32px); line-height: 1.25; }
  .project__q cite { display: block; margin-top: 10px; font-style: normal; font-size: 13px; color: var(--mute); }
  .project__rail { display: grid; grid-auto-flow: column; grid-auto-columns: 72%; gap: 10px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--gut); padding: 0 var(--gut); scrollbar-width: none; }
  .project__rail::-webkit-scrollbar { display: none; }
  .project__rail img { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; background: #fff; scroll-snap-align: start; }

  .works__f { display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; margin: 0 calc(var(--gut) * -1) 26px; padding: 0 var(--gut); }
  .works__f::-webkit-scrollbar { display: none; }
  .works__f button { flex: none; min-height: 42px; padding: 0 16px; box-shadow: inset 0 0 0 1.5px var(--line); font-size: 15px; transition: background 0.25s, color 0.25s, box-shadow 0.25s; }
  .works__f [aria-checked="true"] { background: var(--ink); color: var(--paper); box-shadow: none; }
  .works__g { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; align-items: start; }
  /* every card in a row of four sits one step lower than the previous */
  .works__g li { animation: wk 0.6s var(--ease) both; }
  @keyframes wk { from { opacity: 0; transform: translateY(16px); } }
  .works__g button { display: grid; gap: 6px; width: 100%; text-align: left; }
  .works__g img { width: 100%; height: auto; aspect-ratio: 3 / 4; object-fit: cover; transition: transform 0.8s var(--ease), filter 0.5s; }
  @media (hover: hover) { .works__g button:hover img { transform: scale(1.02); } }
  .works__g span { font-size: 12.5px; color: var(--ink-2); line-height: 1.3; }
  .zoom { position: fixed; inset: 0; z-index: 200; display: grid; place-items: center; align-content: center; gap: 10px; padding: 50px 12px; background: rgba(246, 245, 241, 0.97); }
  .zoom img { max-width: 100%; max-height: 80vh; object-fit: contain; }
  .zoom p { font-size: 13px; color: var(--ink-2); }
  .zoom__x { position: absolute; top: calc(env(safe-area-inset-top) + 8px); right: 8px; width: 46px; height: 46px; display: grid; place-content: center; }
  .zoom__x svg { width: 24px; height: 24px; }
  :global(html.zoom-open) { overflow: hidden; }

  .craft { background: var(--forest); color: #f1ecdf; --paper: var(--forest); --ink-2: #c9d3bf; --line: rgba(241, 236, 223, 0.16); }
  .craft .kick, .craft .read { color: #c9d3bf; }
  .craft .h2 i { color: #e0b06e; }
  .more__g { display: grid; grid-template-columns: 1fr 1fr; gap: 26px 12px; margin-bottom: 34px; }
  .more__g img { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; background: #fff; margin-bottom: 10px; }
  .more__t { font-family: var(--display); font-weight: 500; font-size: 19px; line-height: 1.2; }
  .more__d { font-size: 14.5px; color: var(--ink-2); line-height: 1.45; margin-top: 4px; }
  .more__p { font-size: 15px; margin-top: 6px; color: var(--leaf); }

  @media (min-width: 1000px) {
    .hero { grid-template-columns: 1.15fr 1fr; grid-template-rows: 1fr auto; column-gap: 60px; min-height: 100svh; align-items: center; padding-top: calc(var(--hdr) + 30px); }
    .hero__ph { grid-row: 1 / 3; grid-column: 2; }
    .hero__ph img { aspect-ratio: auto; height: calc(100svh - var(--hdr) - 90px); width: 100%; }
    .hero__facts { grid-column: 1; align-self: end; }
    .project__rail { grid-auto-columns: 30%; padding: 0 calc((100vw - min(100vw, var(--max))) / 2 + var(--gut)); }
    .works__g { grid-template-columns: repeat(4, 1fr); gap: 16px; }
    .more__g { grid-template-columns: repeat(4, 1fr); gap: 34px 20px; }
  }
</style>
