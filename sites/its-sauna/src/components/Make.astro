---
/**
 * «Сауна за три дня»: the sauna hourglass from the wall turns into the scroll indicator of the
 * workshop story — the sand runs down while you read from the linden stack to the first steam.
 */
import { img } from "../lib/site";
const steps = [
  { ph: "make1", t: "Липа на складе", d: "Вагонка из липы сорта «Экстра», абаши и канадский кедр. Липа не греется до ожога и пахнет мёдом.", n: "День 1" },
  { ph: "make2", t: "Щиты в цеху", d: "Цех готовых саун работает с 1997 года и выпускает от 10 до 30 саун в месяц. Производство сертифицировано.", n: "День 1–2" },
  { ph: "make3", t: "Полки по чертежу", d: "Нижний полок задвигается под верхний: удобно и париться, и убирать. Подспинники и подголовники — из того же дерева.", n: "День 2–3" },
  { ph: "pol1", t: "Первый пар", d: "Сауна собирается из щитов за день-два, без шума и пыли — вашими руками или нашими мастерами. Изготовление — от трёх дней.", n: "День 3" },
];
---
<div class="mk" data-mk>
  <div class="mk__stick">
    <!-- the hourglass: a linden frame, two glass bulbs, sand that runs with the scroll -->
    <svg class="mk__hg" viewBox="0 0 80 140" aria-hidden="true">
      <defs>
        <clipPath id="hg-top"><path d="M18 14 C18 44 38 56 40 70 C42 56 62 44 62 14 Z" /></clipPath>
        <clipPath id="hg-bot"><path d="M18 126 C18 96 38 84 40 70 C42 84 62 96 62 126 Z" /></clipPath>
      </defs>
      <rect x="6" y="4" width="68" height="10" rx="3" class="mk__wood" />
      <rect x="6" y="126" width="68" height="10" rx="3" class="mk__wood" />
      <rect x="10" y="14" width="5" height="112" rx="2" class="mk__post" />
      <rect x="65" y="14" width="5" height="112" rx="2" class="mk__post" />
      <g clip-path="url(#hg-top)"><rect class="mk__sand" x="0" y="14" width="80" height="56" data-top /></g>
      <g clip-path="url(#hg-bot)"><rect class="mk__sand" x="0" y="126" width="80" height="0" data-bot /></g>
      <path class="mk__stream" d="M40 70V124" data-stream />
      <path class="mk__glass" d="M18 14 C18 44 38 56 40 70 C42 56 62 44 62 14 M18 126 C18 96 38 84 40 70 C42 84 62 96 62 126" />
    </svg>
    <p class="mk__day mono" data-day>День 1</p>
  </div>
  <ol class="mk__list">
    {steps.map((s, i) => (
      <li class="mk__it" data-step={i}>
        <img src={img(s.ph, 600)} srcset={`${img(s.ph, 600)} 600w, ${img(s.ph, 1200)} 1200w`} sizes="(min-width: 1000px) 40vw, 92vw" alt={s.t} loading="lazy" width="600" height="450" />
        <div>
          <p class="mono mk__n">{s.n}</p>
          <p class="h3">{s.t}</p>
          <p class="read">{s.d}</p>
        </div>
      </li>
    ))}
  </ol>
</div>

<script>
  const el = document.querySelector<HTMLElement>("[data-mk]")!;
  const top = el.querySelector<SVGRectElement>("[data-top]")!, bot = el.querySelector<SVGRectElement>("[data-bot]")!;
  const stream = el.querySelector<SVGPathElement>("[data-stream]")!;
  const day = el.querySelector<HTMLElement>("[data-day]")!;
  const steps = [...el.querySelectorAll<HTMLElement>("[data-step]")];
  let tk = false, shown = "";
  const frame = () => {
    tk = false;
    const r = el.getBoundingClientRect();
    const p = Math.min(1, Math.max(0, (innerHeight * 0.5 - r.top) / (r.height - innerHeight * 0.3)));
    // sand: the top bulb empties from its surface, the bottom one fills from the floor
    top.setAttribute("y", String(14 + 56 * p)); top.setAttribute("height", String(56 * (1 - p)));
    bot.setAttribute("y", String(126 - 56 * p)); bot.setAttribute("height", String(56 * p));
    stream.style.opacity = p > 0.01 && p < 0.99 ? "1" : "0";
    let i = 0; steps.forEach((s, k) => { if (s.getBoundingClientRect().top < innerHeight * 0.6) i = k; });
    steps.forEach((s, k) => s.classList.toggle("on", k === i));
    const t = p >= 0.99 ? "Готово — можно париться" : `День ${Math.min(3, 1 + Math.floor(p * 3))} из 3`;
    if (t !== shown) { shown = t; day.textContent = t; }
  };
  addEventListener("scroll", () => { if (!tk) { tk = true; requestAnimationFrame(frame); } }, { passive: true });
  frame();
</script>

<style>
  .mk { display: grid; }
  .mk__stick { position: sticky; top: calc(var(--hdr) + env(safe-area-inset-top) + 10px); z-index: 5; justify-self: end; display: flex; align-items: center; gap: 10px; padding: 6px 14px 6px 8px; margin-bottom: 20px; border-radius: 40px; background: rgba(245, 236, 220, 0.9); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); box-shadow: 0 6px 20px rgba(27, 20, 16, 0.12); }
  .mk__hg { width: 26px; height: auto; }
  .mk__day { font-size: 11px; color: var(--ink-2); }
  .mk__wood { fill: #c9955a; }
  .mk__post { fill: #b9874f; }
  .mk__sand { fill: #d9a865; }
  .mk__stream { stroke: #d9a865; stroke-width: 1.4; stroke-dasharray: 3 3; animation: run 0.5s linear infinite; transition: opacity 0.3s; }
  @keyframes run { to { stroke-dashoffset: -6; } }
  .mk__glass { fill: rgba(255, 255, 255, 0.25); stroke: rgba(36, 26, 20, 0.45); stroke-width: 1.2; }
  .mk__list { display: grid; gap: 48px; }
  .mk__it { display: grid; gap: 16px; }
  .mk__it img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 3px; }
  .mk__it > div { display: grid; gap: 8px; }
  .mk__n { font-size: 11px; color: var(--ember); text-transform: uppercase; letter-spacing: 0.06em; }
  @media (min-width: 1000px) {
    .mk { grid-template-columns: 220px 1fr; gap: 60px; }
    .mk__stick { top: calc(var(--hdr) + 60px); align-self: start; justify-self: center; flex-direction: column; gap: 18px; padding: 0; margin: 0; background: none; box-shadow: none; backdrop-filter: none; }
    .mk__hg { width: 120px; }
    .mk__day { font-size: 13px; text-align: center; }
    .mk__list { gap: 90px; }
    .mk__it { grid-template-columns: 1.2fr 1fr; gap: 36px; align-items: center; opacity: 0.35; transition: opacity 0.6s; }
    .mk__it.on { opacity: 1; }
  }
</style>
