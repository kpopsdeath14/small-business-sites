---
// Finish scene, top-down: a silver-and-black car #63 with a turquoise helmet crosses the
// chequered line, then spins a donut around its front axle, laying real tyre marks and smoke,
// while fireworks go off behind. Starts on `finale:go`.
---
<div class="finale" data-finale aria-hidden="true">
  <canvas class="finale__fx" data-fx></canvas>
  <svg class="finale__scene" viewBox="0 0 400 240" preserveAspectRatio="xMidYMid slice">
    <defs>
      <linearGradient id="fin-body" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#e6e9ee" /><stop offset=".5" stop-color="#aeb4bd" /><stop offset="1" stop-color="#7d838c" />
      </linearGradient>
      <pattern id="fin-cheq" width="8" height="8" patternUnits="userSpaceOnUse">
        <rect width="8" height="8" fill="#0b0c0e" /><rect width="4" height="4" fill="#e9ecf0" /><rect x="4" y="4" width="4" height="4" fill="#e9ecf0" />
      </pattern>
      <filter id="fin-smoke" x="-60%" y="-60%" width="220%" height="220%"><feGaussianBlur stdDeviation="5" /></filter>
    </defs>

    <!-- track -->
    <rect class="finale__track" x="-10" y="58" width="420" height="124" />
    <path class="finale__kerb" d="M-10 58 H410 M-10 182 H410" />
    <path class="finale__dash" d="M-10 120 H410" />
    <rect x="252" y="58" width="12" height="124" fill="url(#fin-cheq)" />
    <text class="finale__label" x="270" y="72">FINISH</text>

    <g data-skids>
      <path class="skid" data-skid="0" d="" />
      <path class="skid" data-skid="1" d="" />
    </g>
    <g data-smoke filter="url(#fin-smoke)"></g>

    <!-- car, drawn nose-right in a 200×80 box -->
    <g data-car>
      <g transform="translate(-100 -40)">
        <rect x="16" y="2" width="28" height="17" rx="4" fill="#0c0d0f" />
        <rect x="16" y="61" width="28" height="17" rx="4" fill="#0c0d0f" />
        <rect x="139" y="5" width="23" height="15" rx="4" fill="#0c0d0f" />
        <rect x="139" y="60" width="23" height="15" rx="4" fill="#0c0d0f" />
        <path d="M44 12 L62 26 M44 68 L62 54 M141 14 L126 32 M151 14 L134 34 M141 66 L126 48 M151 66 L134 46" stroke="#8a9099" stroke-width="1.6" />
        <path d="M26 22 L122 26 L122 54 L26 58 Z" fill="#101114" />
        <rect x="2" y="11" width="16" height="58" rx="2" fill="#17191d" />
        <rect x="2" y="11" width="3" height="58" fill="#00d2be" />
        <path d="M176 3 L186 5 L191 8 L191 72 L186 75 L176 77 L173 73 L181 40 L173 7 Z" fill="#17191d" />
        <path d="M188 7 L191 8 L191 72 L188 73 Z" fill="#00d2be" />
        <path d="M22 30 C30 20 60 14 84 16 C100 17 110 24 122 30 L186 36 L186 44 L122 50 C110 56 100 63 84 64 C60 66 30 60 22 50 Z" fill="url(#fin-body)" />
        <path d="M186 36 L193 38.6 L193 41.4 L186 44 Z" fill="#17191d" />
        <path d="M28 36.5 L98 33 L98 47 L28 43.5 Z" fill="#15171a" />
        <path d="M40 24 C60 19 80 18 96 21 M40 56 C60 61 80 62 96 59" stroke="#00d2be" stroke-width="1.6" fill="none" />
        <text x="62" y="40.5" class="finale__no">63</text>
        <rect x="110" y="20" width="7" height="4" rx="1" fill="#17191d" />
        <rect x="110" y="56" width="7" height="4" rx="1" fill="#17191d" />
        <ellipse cx="105" cy="40" rx="13.5" ry="7.5" fill="#050506" />
        <circle cx="102" cy="40" r="6" fill="#00d2be" />
        <path d="M97 40 H107" stroke="#e9fffb" stroke-width="1.4" />
        <path d="M113 32.5 Q124 40 113 47.5 M113 40 H124" stroke="#26292e" stroke-width="2.6" fill="none" stroke-linecap="round" />
      </g>
    </g>
  </svg>
  <p class="finale__tag tag"><span>#63</span> Победный бублик</p>
</div>

<script>
  const root = document.querySelector<HTMLElement>("[data-finale]")!;
  const cv = root.querySelector<HTMLCanvasElement>("[data-fx]")!;
  const car = root.querySelector<SVGGElement>("[data-car]")!;
  const skids = [...root.querySelectorAll<SVGPathElement>("[data-skid]")];
  const smoke = root.querySelector<SVGGElement>("[data-smoke]")!;
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

  const S = 0.56;                  // car scale in the scene
  const Y = 120;                   // racing line
  const X_END = 214;               // car centre when it stops (nose past the line)
  const PIV = { x: 51 * S, y: 0 }; // front axle, relative to the car centre
  const REAR = [{ x: -69 * S, y: -28 * S }, { x: -69 * S, y: 28 * S }];

  const rot = (p: { x: number; y: number }, a: number) => ({ x: p.x * Math.cos(a) - p.y * Math.sin(a), y: p.x * Math.sin(a) + p.y * Math.cos(a) });
  const ease = (t: number) => 1 - Math.pow(1 - t, 3);
  const easeIO = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
  const place = (cx: number, cy: number, a: number) =>
    car.setAttribute("transform", `translate(${cx.toFixed(2)} ${cy.toFixed(2)}) rotate(${((a * 180) / Math.PI).toFixed(2)}) scale(${S})`);

  // ---- fireworks (canvas over the scene, screen-blended) ----
  type P = { x: number; y: number; vx: number; vy: number; life: number; max: number; c: string };
  const COLS = ["#00d2be", "#ffffff", "#ff2d20", "#c9ced6"];
  let parts: P[] = [];
  function burst() {
    const w = cv.width, h = cv.height;
    const x = w * (0.12 + Math.random() * 0.76), y = h * (0.06 + Math.random() * 0.2);
    const c = COLS[Math.floor(Math.random() * COLS.length)];
    const n = 50 + Math.floor(Math.random() * 18);
    for (let i = 0; i < n; i++) {
      const a = (i / n) * Math.PI * 2, s = 1.3 + Math.random() * 2;
      parts.push({ x, y, vx: Math.cos(a) * s, vy: Math.sin(a) * s, life: 0, max: 55 + Math.random() * 25, c: Math.random() < 0.2 ? "#fff" : c });
    }
  }
  function fx() {
    const ctx = cv.getContext("2d")!, dpr = devicePixelRatio || 1;
    ctx.globalCompositeOperation = "destination-out";
    ctx.fillStyle = "rgba(0,0,0,0.24)";
    ctx.fillRect(0, 0, cv.width, cv.height);
    ctx.globalCompositeOperation = "lighter";
    parts = parts.filter((p) => p.life < p.max);
    for (const p of parts) {
      p.life++; p.vx *= 0.975; p.vy = p.vy * 0.975 + 0.035;
      p.x += p.vx * dpr; p.y += p.vy * dpr;
      ctx.globalAlpha = Math.max(0, 1 - p.life / p.max);
      ctx.fillStyle = p.c;
      ctx.beginPath(); ctx.arc(p.x, p.y, 1.5 * dpr, 0, 7); ctx.fill();
    }
    ctx.globalAlpha = 1;
    requestAnimationFrame(fx);
  }

  function puff(x: number, y: number) {
    const c = document.createElementNS("http://www.w3.org/2000/svg", "circle");
    c.setAttribute("cx", x.toFixed(1)); c.setAttribute("cy", y.toFixed(1)); c.setAttribute("r", "7");
    c.setAttribute("class", "puff");
    smoke.appendChild(c);
    c.addEventListener("animationend", () => c.remove());
  }

  function run() {
    const T1 = 1500, T2 = 2300, TURN = -Math.PI * 2.15;
    const pts: string[][] = [[], []];
    const pivot = { x: X_END + PIV.x, y: Y };
    let t0 = 0, lastPuff = 0, fired = false;
    const step = (t: number) => {
      if (!t0) t0 = t;
      const e = t - t0;
      if (e < T1) {
        const k = ease(e / T1);
        place(-80 + (X_END + 80) * k, Y, 0);
        if (!fired && k > 0.82) { fired = true; root.classList.add("crossed"); [0, 380, 760, 1250].forEach((d) => setTimeout(burst, d)); }
      } else {
        const k = Math.min(1, (e - T1) / T2);
        const a = TURN * easeIO(k);
        const c = rot({ x: -PIV.x, y: 0 }, a);
        const cx = pivot.x + c.x, cy = pivot.y + c.y;
        place(cx, cy, a);
        if (k > 0.03 && k < 0.97) {
          const doPuff = t - lastPuff > 70;
          REAR.forEach((r, i) => {
            const w = rot(r, a);
            pts[i].push(`${(cx + w.x).toFixed(1)} ${(cy + w.y).toFixed(1)}`);
            skids[i].setAttribute("d", "M" + pts[i].join(" L"));
            if (doPuff) puff(cx + w.x, cy + w.y);
          });
          if (doPuff) lastPuff = t;
        }
        if (k >= 1) { setInterval(() => document.visibilityState === "visible" && burst(), 2400); return; }
      }
      requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  }

  function finalPose() {
    place(X_END, Y, 0);
    const pivot = { x: X_END + PIV.x, y: Y };
    REAR.forEach((r, i) => {
      const pts: string[] = [];
      for (let k = 0; k <= 60; k++) {
        const a = (-Math.PI * 2 * k) / 60, c = rot({ x: -PIV.x, y: 0 }, a), w = rot(r, a);
        pts.push(`${(pivot.x + c.x + w.x).toFixed(1)} ${(pivot.y + c.y + w.y).toFixed(1)}`);
      }
      skids[i].setAttribute("d", "M" + pts.join(" L"));
    });
    root.classList.add("crossed");
  }

  place(-80, Y, 0);
  document.addEventListener("finale:go", () => {
    root.classList.add("go");
    if (reduced) { finalPose(); return; }
    const r = cv.getBoundingClientRect(), dpr = devicePixelRatio || 1;
    cv.width = r.width * dpr; cv.height = r.height * dpr;
    fx();
    run();
  });
</script>

<style>
  .finale { position: relative; width: 100%; aspect-ratio: 16 / 10; overflow: hidden; background: #08090b; border: 1px solid var(--line); isolation: isolate; }
  .finale__fx { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 2; pointer-events: none; mix-blend-mode: screen; }
  .finale__scene { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 1; }
  .finale__track { fill: #121418; }
  .finale__kerb { stroke: #ff2d20; stroke-width: 3; stroke-dasharray: 14 14; }
  .finale__dash { stroke: rgba(236, 240, 245, 0.08); stroke-width: 1.5; stroke-dasharray: 18 16; }
  .finale__label { font-family: var(--mono); font-size: 8px; letter-spacing: 0.2em; fill: rgba(236, 240, 245, 0.45); }
  .finale__no { font-family: var(--display); font-size: 10px; font-weight: 600; fill: #e9ecf0; text-anchor: middle; dominant-baseline: central; }
  .skid { fill: none; stroke: #000; stroke-width: 6; stroke-linecap: round; stroke-linejoin: round; opacity: 0.75; }
  .finale :global(.puff) { fill: #d9dde3; opacity: 0; transform-box: fill-box; transform-origin: center; animation: puff 1.8s ease-out forwards; }
  @keyframes puff { 0% { opacity: 0.45; transform: scale(0.6); } 100% { opacity: 0; transform: scale(3.2) translateY(-6px); } }
  .finale__tag { position: absolute; left: 14px; bottom: 12px; z-index: 3; display: flex; gap: 8px; color: var(--mute); opacity: 0; transition: opacity 0.6s 0.4s; }
  .finale__tag span { color: #041312; background: #00d2be; padding: 0 6px; }
  .crossed .finale__tag { opacity: 1; }
</style>
