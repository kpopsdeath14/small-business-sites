---
import "@fontsource-variable/unbounded";
import "@fontsource-variable/inter-tight";
import "@fontsource/jetbrains-mono/400.css";
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import { url, contacts, categories, cartIndex, BASE, img } from "../lib/site";

interface Props { title?: string; description?: string; nav?: string }
const {
  title = "RSEAT Russia — гоночные симуляторы",
  description = "Эксклюзивный дистрибьютор RSEAT в России. Гоночные кокпиты, motion-платформы D‑BOX, рули и педали Fanatec. Доставка, монтаж и настройка под ключ. Тест-драйв в шоуруме в Москве.",
  nav = "",
} = Astro.props;
const year = new Date().getFullYear();
const links = [
  ["catalog", "Каталог", url("catalog/")],
  ["cockpits", "Кокпиты", url("catalog/cockpits/")],
  ["motion", "Motion", url("catalog/motion/")],
  ["wheels", "Рули", url("catalog/wheels/")],
  ["showroom", "Шоурум", url("showroom/")],
  ["service", "Сервис", url("service/")],
];
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#060708" />
    <link rel="icon" type="image/svg+xml" href={`${BASE}/favicon.svg`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(img("hero-wide", 1600), Astro.site).href} />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <slot name="head" />
  </head>
  <body>
    <header class="hdr">
      <div class="wrap hdr__in">
        <a href={url()} class="logo" aria-label="RSEAT Russia — на главную">
          <svg class="logo__mark" viewBox="0 0 22 22" aria-hidden="true"><circle cx="11" cy="11" r="10.25" fill="none" stroke="currentColor" stroke-opacity=".35" stroke-width="1" /><circle cx="11" cy="11" r="5.5" fill="#ff2d20" /></svg>
          <span class="logo__word">RSEAT</span>
          <span class="logo__sub">Russia</span>
        </a>
        <nav class="nav" aria-label="Основное меню">
          {links.map(([id, label, href]) => <a href={href} aria-current={nav === id ? "page" : undefined}>{label}</a>)}
        </nav>
        <a href={url("cart/")} class="hdr__btn" data-open-cart aria-label="Корзина">
          <Icon name="cart" />
          <span class="cart-count" data-cart-count>0</span>
        </a>
        <button class="hdr__btn burger" type="button" aria-label="Меню" aria-expanded="false" aria-controls="menu"><span></span><span></span></button>
      </div>
      <div class="rpm" aria-hidden="true">{Array.from({ length: 15 }, () => <i></i>)}</div>
    </header>

    <div class="menu" id="menu" aria-hidden="true">
      <nav class="menu__nav" aria-label="Меню">
        {links.map(([, label, href], i) => <a href={href} style={`--i:${i}`}>{label}<span class="tag">0{i + 1}</span></a>)}
        <a href={url("cart/")} style={`--i:${links.length}`}>Корзина<span class="tag" data-cart-count-text>0</span></a>
      </nav>
      <div class="menu__foot">
        <a href={contacts.phoneHref} class="menu__phone">{contacts.phone}</a>
        <p class="tag">Шоурум: Москва, {contacts.locations[0].address}</p>
      </div>
    </div>

    <slot />

    <footer class="ftr">
      <div class="wrap">
        <div class="ftr__grid">
          <div class="ftr__col">
            <p class="tag tag--red">RSEAT Russia</p>
            <p class="ftr__big">Эксклюзивный дистрибьютор RSEAT в России</p>
          </div>
          <div class="ftr__col">
            <p class="tag">Каталог</p>
            {categories.map((c) => <a href={url(`catalog/${c.id}/`)}>{c.title}</a>)}
          </div>
          <div class="ftr__col">
            <p class="tag">Клиентам</p>
            <a href={url("showroom/#book")}>Тест-драйв и шоурум</a>
            <a href={url("service/#delivery")}>Доставка и оплата</a>
            <a href={url("service/#warranty")}>Гарантия</a>
            <a href={url("showroom/#rent")}>Аренда для мероприятий</a>
            <a href={url("cart/")}>Корзина</a>
          </div>
          <div class="ftr__col">
            <p class="tag">Связь</p>
            <a href={contacts.phoneHref}>{contacts.phone}</a>
            <a href={`mailto:${contacts.email}`}>{contacts.email}</a>
            <a href={`https://wa.me/${contacts.whatsapp}`} target="_blank" rel="noopener">WhatsApp</a>
            <a href={contacts.youtube} target="_blank" rel="noopener">YouTube</a>
            <a href={contacts.instagram} target="_blank" rel="noopener">Instagram</a>
          </div>
        </div>
        <div class="ftr__base">
          <p class="tag">© 2014–{year} SimRacing Shop</p>
          <p class="tag">Москва · Самара</p>
        </div>
      </div>
    </footer>

    <div class="scrim" data-close-cart></div>
    <aside class="drawer" aria-label="Корзина" aria-hidden="true">
      <div class="drawer__head">
        <p class="tag">Корзина · <span data-cart-count-text>0</span></p>
        <button class="close" type="button" data-close-cart aria-label="Закрыть"><Icon name="close" /></button>
      </div>
      <div class="drawer__list" data-cart-list></div>
      <div class="drawer__foot">
        <div data-dtrack></div>
        <div class="drawer__sum"><span class="tag">Итого</span><strong data-cart-total>0 ₽</strong></div>
        <a class="btn btn--block" href={url("checkout/")}>Оформить заказ <Icon name="arrow" class="btn__ar" /></a>
        <a class="ulink drawer__all" href={url("cart/")}>Перейти в корзину</a>
      </div>
    </aside>
    <div class="radio" role="status" aria-live="polite">
      <span class="radio__no num"></span>
      <div class="radio__body">
        <p class="tag radio__h">Радио <span class="radio__wave" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></span></p>
        <p class="radio__q"></p>
        <p class="radio__t"></p>
      </div>
    </div>
    <div class="pit" role="status" aria-live="polite">
      <span class="pit__img studio"><img src="data:image/gif;base64,R0lGODlhAQABAAAAACw=" alt="" /></span>
      <div class="pit__body">
        <p class="tag pit__t"><span class="pit__dot"></span>Пит-стоп · <span class="pit__time num">0.00</span> с</p>
        <p class="pit__n"></p>
        <p class="pit__v"></p>
        <p class="pit__r"><span class="radio__wave" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span class="pit__rq"></span></p>
      </div>
      <div class="pit__act">
        <a class="pit__go" href={url("checkout/")}>Оформить</a>
        <button type="button" class="pit__x" aria-label="Скрыть">✕</button>
      </div>
    </div>

    <script is:inline type="application/json" id="cart-index" set:html={JSON.stringify({ base: BASE, items: cartIndex })} />
    <script>
      import "../scripts/app.ts";
    </script>
  </body>
</html>
