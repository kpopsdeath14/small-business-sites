---
import Base from "../../layouts/Base.astro";
import ProductCard from "../../components/ProductCard.astro";
import Icon from "../../components/Icon.astro";
import { products, bySlug, url, pimg, rub, catTitle, wa, contacts } from "../../lib/site";

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug } }));
}
const p = bySlug(Astro.params.slug!);
const v = p.variants[0];
const multi = p.variants.length > 1;
const related = products.filter((x) => x.cat === p.cat && x.slug !== p.slug).concat(products.filter((x) => x.cat !== p.cat && x.cat === "cockpits")).slice(0, 8);
const vdata = p.variants.map((x) => ({ id: x.id, n: x.labelRu, p: x.price, st: x.stock, img: x.img }));
const buyText = (label: string) => `Здравствуйте! Хочу купить ${p.name}${label ? `, ${label.toLowerCase()}` : ""}.`;
const sw = (s: string[]) => (s.length > 1 ? `background:linear-gradient(135deg, ${s[0]} 50%, ${s[1]} 50%)` : `background:${s[0]}`);
const desc = `${p.name} — ${p.sub || catTitle(p.cat)}. Цена ${rub(p.from)}. Доставка, монтаж и настройка под ключ от RSEAT Russia.`;
---
<Base title={`${p.name} — купить в RSEAT Russia`} description={desc} nav={["cockpits", "motion", "wheels"].includes(p.cat) ? p.cat : "catalog"}>
  <main class="pp">
    <div class="wrap pp__crumbs">
      <nav class="crumbs tag" aria-label="Навигация">
        <a href={url()}>Главная</a><span>/</span><a href={url("catalog/")}>Каталог</a><span>/</span><a href={url(`catalog/${p.cat}/`)}>{catTitle(p.cat)}</a>
      </nav>
    </div>

    <div class="wrap pp__grid">
      <!-- gallery -->
      <section class="gal" aria-label="Фотографии">
        <div class="gal__track studio" data-track>
          {v.img.map((id, i) => (
            <figure class="gal__slide"><img src={pimg(id, 1200)} srcset={`${pimg(id, 600)} 600w, ${pimg(id, 1200)} 1200w`} sizes="(min-width: 1000px) 56vw, 100vw" alt={`${p.name}, фото ${i + 1}`} loading={i === 0 ? "eager" : "lazy"} decoding="async" /></figure>
          ))}
        </div>
        <span class="gal__frame" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        <p class="gal__count tag num" data-count>01 / {String(v.img.length).padStart(2, "0")}</p>
        <div class="gal__dots" data-dots aria-hidden="true">{v.img.map((_, i) => <i class:list={{ on: i === 0 }}></i>)}</div>
        <div class="gal__thumbs" data-thumbs>
          {v.img.map((id, i) => <button type="button" class:list={["studio", { on: i === 0 }]} data-i={i} aria-label={`Фото ${i + 1}`}><img src={pimg(id)} alt="" loading="lazy" /></button>)}
        </div>
      </section>
      {multi && (
          <div class="gal__sw" role="radiogroup" aria-label="Исполнение">
            <p class="tag gal__swname" data-vname>{v.labelRu}</p>
            <div class="gal__swrow">
              {p.variants.map((x, i) => (
                <button type="button" role="radio" aria-checked={i === 0 ? "true" : "false"} aria-label={x.labelRu} data-v={x.id} style={sw(x.swatch)}></button>
              ))}
            </div>
          </div>
        )}

      <!-- buy box -->
      <section class="buy">
        <p class="tag buy__cat">{catTitle(p.cat)}</p>
        <h1 class="d2 buy__t">{p.name}</h1>
        {p.sub && <p class="buy__sub">{p.sub}</p>}

        <div class="buy__price-row">
          <p class="buy__price" data-price>{rub(v.price)}</p>
          <span class:list={["stock", { "stock--pre": v.stock !== "in" }]} data-stock>{v.stock === "in" ? "В наличии" : "Под заказ · 2–3 нед."}</span>
        </div>

        {multi && (
          <div class="vpick">
            <p class="tag">Исполнение — <span class="vpick__name" data-vname>{v.labelRu}</span></p>
            <div class="vpick__sw" role="radiogroup" aria-label="Исполнение">
              {p.variants.map((x, i) => (
                <button type="button" role="radio" aria-checked={i === 0 ? "true" : "false"} aria-label={x.labelRu} title={x.labelRu} data-v={x.id} style={sw(x.swatch)}></button>
              ))}
            </div>
          </div>
        )}

        <div class="buy__act" data-buybox>
          <div class="qty" role="group" aria-label="Количество">
            <button type="button" data-q="-1" aria-label="Меньше">−</button><output data-qv></output><button type="button" data-q="1" aria-label="Больше">+</button>
          </div>
          <button class="btn buy__add" type="button" data-add={v.id}>В корзину <Icon name="cart" class="btn__ar" /></button>
        </div>
        <a class="btn btn--ghost btn--block buy__one" data-one href={wa(buyText(multi ? v.labelRu : ""))} target="_blank" rel="noopener">Купить в один клик <Icon name="wa" class="btn__ar" /></a>

        <ul class="perks">
          <li><span class="tag">Доставка</span><span>Бесплатно от 200 000 ₽. Со склада в Москве — за рабочие сутки</span></li>
          <li><span class="tag">Монтаж</span><span>Сборка, подключение и настройка под ваш рост</span></li>
          <li><span class="tag">Тест-драйв</span><span>Попробуйте вживую в шоуруме — <a href={url("showroom/")}>записаться</a></span></li>
        </ul>
      </section>
    </div>

    {p.features.length > 0 && (
      <section class="wrap feats">
        {p.features.map((f, i) => (
          <div class="feat ticks" data-in style={`--d:${i * 0.06}s`}>
            <span class="tag tag--red num">0{i + 1}</span>
            <h3>{f.t}</h3>
            <p>{f.d}</p>
          </div>
        ))}
      </section>
    )}

    {(p.sections.length > 0 || p.faq.length > 0) && (
      <section class="wrap info">
        {p.sections.length > 0 && (
          <div>
            <div class="sh__top"><span class="tag">[i]</span><span class="tag">Характеристики</span></div>
            <div class="acc">
              {p.sections.map((s, i) => (
                <details open={i === 0}>
                  <summary>{s.t}<i></i></summary>
                  <div class="rich" set:html={s.h} />
                </details>
              ))}
            </div>
          </div>
        )}
        {p.faq.length > 0 && (
          <div>
            <div class="sh__top"><span class="tag">[?]</span><span class="tag">Вопросы</span></div>
            <div class="acc">
              {p.faq.map((f) => (
                <details>
                  <summary>{f.q}<i></i></summary>
                  <div class="rich" set:html={f.a} />
                </details>
              ))}
            </div>
          </div>
        )}
      </section>
    )}

    <section class="rel">
      <div class="wrap">
        <div class="sh">
          <div class="sh__top"><span class="tag">[+]</span><span class="tag">Дополните комплект</span></div>
          <h2 class="d2" data-in>С этим <b>выбирают</b></h2>
        </div>
      </div>
      <div class="rail">{related.map((x, i) => <ProductCard p={x} d={Math.min(i, 3) * 0.06} />)}</div>
    </section>

    <!-- mobile sticky buy bar -->
    <div class="sbar" data-sbar>
      <div>
        <p class="sbar__n">{p.name}</p>
        <p class="sbar__p" data-price>{rub(v.price)}</p>
      </div>
      <button class="btn" type="button" data-add={v.id}>В корзину</button>
    </div>
    <script is:inline type="application/json" id="pdata" set:html={JSON.stringify({ name: p.name, multi, v: vdata, wa: contacts.whatsapp })} />
  </main>
</Base>

<script>
  import { rollPrice, cart, gear } from "../../scripts/cart";
  import { syncButtons } from "../../scripts/app";
  const D = JSON.parse(document.getElementById("pdata")!.textContent!) as { name: string; multi: boolean; wa: string; v: { id: string; n: string; p: number; st: string; img: string[] }[] };
  const base = (document.querySelector('link[rel="icon"]') as HTMLLinkElement).getAttribute("href")!.replace(/\/favicon\.svg$/, "");
  const pimg = (id: string, w = 600) => `${base}/p/${id}-${w}.webp`;
  const rub = (n: number) => n.toLocaleString("ru-RU").replace(/\s/g, " ") + " ₽";
  const $ = <T extends Element = HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const $$ = <T extends Element = HTMLElement>(s: string) => [...document.querySelectorAll<T>(s)];

  const track = $("[data-track]");
  const thumbs = $("[data-thumbs]");
  const count = $("[data-count]");
  let n = D.v[0].img.length;

  // gallery: swipe on phones, thumbnails on desktop
  const cur = () => Math.round(track.scrollLeft / track.clientWidth);
  const setCount = (i: number) => {
    count.textContent = `${String(i + 1).padStart(2, "0")} / ${String(n).padStart(2, "0")}`;
    $$(".gal__thumbs button").forEach((b, j) => b.classList.toggle("on", j === i));
    $$("[data-dots] i").forEach((d, j) => d.classList.toggle("on", j === i));
  };
  track.addEventListener("scroll", () => requestAnimationFrame(() => setCount(cur())), { passive: true });
  thumbs.addEventListener("click", (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>("[data-i]");
    if (b) track.scrollTo({ left: Number(b.dataset.i) * track.clientWidth, behavior: "smooth" });
  });

  // quantity: the stepper only exists once the item is in the cart, and it edits the cart directly
  const qv = $("[data-qv]");
  const act = $("[data-buybox]");
  const adds = $$<HTMLElement>("[data-add]").filter((b) => b.closest(".pp") && !b.closest(".card"));
  const curId = () => adds[0].dataset.add!;
  const inCartQ = () => cart.lines().find((l) => l.id === curId())?.q;
  $$("[data-q]").forEach((b) => b.addEventListener("click", () => {
    const cq = inCartQ();
    if (cq === undefined) return;
    const nq = cq + Number(b.dataset.q);
    if (nq < 1) cart.remove(curId());
    else cart.set(curId(), Math.min(99, nq));
  }));
  const showQ = () => {
    const cq = inCartQ();
    act.classList.toggle("has-qty", cq !== undefined);
    if (cq === undefined) return;
    const shown = Number(qv.textContent);
    if (cq !== shown) { qv.textContent = String(cq); if (shown) gear(qv, cq > shown ? 1 : -1); }
  };
  document.addEventListener("cart:sync", showQ);
  showQ();

  // variants
  const one = $<HTMLAnchorElement>("[data-one]");
  const pick = (id: string, push = true) => {
    const v = D.v.find((x) => x.id === id);
    if (!v) return;
    $$("[data-v]").forEach((b) => b.setAttribute("aria-checked", String(b.dataset.v === id)));
    $$("[data-vname]").forEach((nm) => (nm.textContent = v.n));
    $$("[data-price]").forEach((el) => rollPrice(el, v.p));
    const st = $("[data-stock]");
    st.textContent = v.st === "in" ? "В наличии" : "Под заказ · 2–3 нед.";
    st.classList.toggle("stock--pre", v.st !== "in");
    adds.forEach((a) => (a.dataset.add = v.id));
    syncButtons();
    one.href = `https://wa.me/${D.wa}?text=${encodeURIComponent(`Здравствуйте! Хочу купить ${D.name}${D.multi ? `, ${v.n.toLowerCase()}` : ""}.`)}`;
    n = v.img.length;
    track.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 180, easing: "ease-in", fill: "forwards" }).onfinish = () => {
      track.innerHTML = v.img.map((im, i) => `<figure class="gal__slide"><img src="${pimg(im, 1200)}" srcset="${pimg(im)} 600w, ${pimg(im, 1200)} 1200w" sizes="(min-width: 1000px) 56vw, 100vw" alt="${D.name}, фото ${i + 1}" decoding="async"></figure>`).join("");
      thumbs.innerHTML = v.img.map((im, i) => `<button type="button" class="studio${i ? "" : " on"}" data-i="${i}" aria-label="Фото ${i + 1}"><img src="${pimg(im)}" alt=""></button>`).join("");
      $("[data-dots]").innerHTML = v.img.map(() => "<i></i>").join("");
      track.scrollLeft = 0;
      setCount(0);
      const first = track.querySelector("img")!;
      const show = () => track.animate([{ opacity: 0, transform: "scale(1.015)" }, { opacity: 1, transform: "none" }], { duration: 420, easing: "cubic-bezier(.16,1,.3,1)", fill: "forwards" });
      first.complete ? show() : first.addEventListener("load", show, { once: true });
    };
    if (push) history.replaceState(null, "", `?v=${id}`);
  };
  $$(".vpick__sw [data-v], .gal__sw [data-v]").forEach((b) => b.addEventListener("click", () => pick(b.dataset.v!)));
  const pre = new URLSearchParams(location.search).get("v");
  if (pre && pre !== D.v[0].id) pick(pre, false);

  // sticky bar appears when the main buy box scrolls away (phones)
  const sbar = $("[data-sbar]");
  new IntersectionObserver(([e]) => {
    const on = !e.isIntersecting && e.boundingClientRect.top < 0;
    sbar.classList.toggle("on", on);
    document.body.classList.toggle("has-sbar", on && innerWidth < 1000);
  }).observe($("[data-buybox]"));
</script>

<style>
  .pp { padding-top: calc(var(--hdr) + 14px); }
  .pp__crumbs { padding-top: 6px; }
  .pp__crumbs .crumbs { margin-bottom: 14px; }
  .pp__grid { display: grid; gap: 26px; }

  .gal { position: relative; margin: 0 calc(var(--gut) * -1); }
  .gal__track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; aspect-ratio: 1; }
  .gal__track::-webkit-scrollbar { display: none; }
  .gal :global(.gal__slide) { flex: 0 0 100%; scroll-snap-align: center; display: grid; place-items: center; }
  .gal :global(.gal__slide img) { width: 100%; height: 100%; object-fit: contain; }
  .gal__count { position: absolute; left: var(--gut); bottom: 14px; color: #333; }
  .gal__frame i { position: absolute; width: 12px; height: 12px; border: 0 solid rgba(0, 0, 0, 0.35); }
  .gal__frame i:nth-child(1) { left: 12px; top: 12px; border-width: 1px 0 0 1px; }
  .gal__frame i:nth-child(2) { right: 12px; top: 12px; border-width: 1px 1px 0 0; }
  .gal__frame i:nth-child(3) { left: 12px; bottom: 12px; border-width: 0 0 1px 1px; display: none; }
  .gal__frame i:nth-child(4) { right: 12px; bottom: 12px; border-width: 0 1px 1px 0; }
  .gal__thumbs { display: none; }
  .gal__track { -webkit-overflow-scrolling: touch; touch-action: pan-x pan-y; overscroll-behavior-x: contain; }
  .gal :global(.gal__slide img) { mix-blend-mode: normal; }
  .gal__frame, .gal__count, .gal__dots { pointer-events: none; }
  .gal__dots { position: absolute; right: var(--gut); bottom: 18px; display: flex; gap: 5px; }
  .gal__dots :global(i) { width: 14px; height: 2px; background: rgba(0, 0, 0, 0.2); transition: background 0.3s, width 0.4s var(--ease); }
  .gal__dots :global(i.on) { width: 26px; background: #111; }
  .gal__sw { display: grid; gap: 8px; margin: -26px calc(var(--gut) * -1) 0; padding: 12px var(--gut) 14px; background: var(--bg-2); border-bottom: 1px solid var(--line); }
  .gal__swname { color: var(--text); }
  .gal__swrow { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; padding: 4px 4px 4px 4px; margin: -4px; }
  .gal__swrow::-webkit-scrollbar { display: none; }
  .gal__swrow button { position: relative; flex: none; width: 34px; height: 34px; box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.2); }
  .gal__swrow button::after { content: ""; position: absolute; inset: -4px; border: 1px solid var(--text); opacity: 0; transform: scale(0.85); transition: opacity 0.3s, transform 0.45s var(--ease); }
  .gal__swrow button[aria-checked="true"]::after { opacity: 1; transform: none; }
  .vpick { display: none; }

  .buy { display: grid; gap: 16px; align-content: start; }
  .buy__cat { color: var(--red); }
  .buy__t { font-size: clamp(28px, 7.6vw, 52px); }
  .buy__sub { color: var(--mute); font-size: 15px; margin-top: -4px; }
  .buy__price-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 16px 0; border-block: 1px solid var(--line); }
  .buy__price { font-family: var(--display); font-weight: 300; font-size: 30px; letter-spacing: -0.03em; }
  .buy__price-row .stock { background: var(--panel-2); color: var(--text); white-space: nowrap; flex: none; }
  .vpick { gap: 12px; }
  .vpick__name { color: var(--text); }
  .vpick__sw { display: flex; flex-wrap: wrap; gap: 8px; }
  .vpick__sw button { position: relative; width: 38px; height: 38px; box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.2); transition: transform 0.4s var(--ease); }
  .vpick__sw button::after { content: ""; position: absolute; inset: -5px; border: 1px solid var(--text); opacity: 0; transform: scale(0.85); transition: opacity 0.35s, transform 0.5s var(--ease); }
  .vpick__sw button[aria-checked="true"]::after { opacity: 1; transform: none; }
  .vpick__sw button:active { transform: scale(0.9); }
  .buy__act { display: grid; grid-template-columns: 1fr; gap: 8px; margin-top: 4px; }
  .buy__act .qty { display: none; height: 54px; grid-template-columns: 36px 34px 36px; }
  .buy__act.has-qty { grid-template-columns: auto 1fr; }
  .buy__act.has-qty .qty { display: inline-grid; animation: qtyIn 0.45s var(--ease); }
  @keyframes qtyIn { from { opacity: 0; transform: translateX(-8px); } }
  .perks { display: grid; border-top: 1px solid var(--line); margin-top: 6px; }
  .perks li { display: grid; grid-template-columns: 92px 1fr; gap: 12px; padding: 13px 0; border-bottom: 1px solid var(--line); font-size: 13.5px; color: var(--mute); }
  .perks .tag { color: var(--dim); font-size: 9.5px; padding-top: 3px; }
  .perks a { color: var(--text); text-decoration: underline; text-underline-offset: 3px; }

  .feats { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 56px; }
  .feat { padding: 18px 14px; background: var(--panel); border: 1px solid var(--line); display: grid; gap: 8px; align-content: start; }
  .feat h3 { font-family: var(--display); font-weight: 400; font-size: 14px; letter-spacing: -0.02em; }
  .feat p { color: var(--mute); font-size: 12.5px; line-height: 1.45; }

  .info { display: grid; gap: 48px; margin-top: 64px; }
  .info .sh__top { margin-bottom: 8px; }
  .rel { margin-top: 88px; }

  .sbar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 90; display: flex; align-items: center; justify-content: space-between; gap: 14px; padding: 10px var(--gut) calc(10px + env(safe-area-inset-bottom)); background: rgba(11, 12, 14, 0.88); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); border-top: 1px solid var(--line); transform: translateY(105%); transition: transform 0.6s var(--ease); }
  .sbar.on { transform: none; }
  .sbar > div { min-width: 0; }
  .sbar__n { font-size: 12px; color: var(--mute); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .sbar__p { font-weight: 600; font-variant-numeric: tabular-nums; }
  .sbar .btn { min-height: 46px; flex: none; }
  .sbar .btn :global(.btn__go) { display: none; }

  @media (min-width: 640px) {
    .feats { grid-template-columns: repeat(4, 1fr); }
  }
  @media (min-width: 1000px) {
    .pp { padding-top: calc(var(--hdr) + 28px); }
    .pp__grid { grid-template-columns: 1.25fr 1fr; gap: 64px; align-items: start; }
    .gal { margin: 0; position: sticky; top: calc(var(--hdr) + 24px); }
    .gal__frame i:nth-child(3) { display: block; }
    .gal__count { left: 20px; bottom: 18px; }
    .gal__sw, .gal__dots { display: none; }
    .vpick { display: grid; }
    .gal__thumbs { display: grid; grid-template-columns: repeat(6, 1fr); gap: 8px; margin-top: 8px; }
    .gal__thumbs :global(button) { aspect-ratio: 1; opacity: 0.55; transition: opacity 0.3s; outline: 1px solid transparent; outline-offset: -1px; }
    .gal__thumbs :global(button.on), .gal__thumbs :global(button:hover) { opacity: 1; }
    .gal__thumbs :global(button.on) { outline-color: var(--red); }
    .gal__thumbs :global(img) { width: 100%; height: 100%; object-fit: contain; }
    .buy { padding-top: 8px; }
    .info { grid-template-columns: 1fr 1fr; gap: 64px; margin-top: 110px; align-items: start; }
    .info > div:only-child { grid-column: 1 / -1; max-width: 900px; }
    .feats { margin-top: 110px; }
    .rel { margin-top: 140px; }
    .sbar { display: none; }
  }
</style>
