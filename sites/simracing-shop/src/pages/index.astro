---
import Base from "../layouts/Base.astro";
import ProductCard from "../components/ProductCard.astro";
import Icon from "../components/Icon.astro";
import { products, categories, bySlug, url, img, srcset, pimg, rub, contacts, wa } from "../lib/site";

const flagship = bySlug("a1-pro-formula");
const motion = bySlug("rs-formula-m4a-full-motion");
const popular = ["a1-pro-gt", "rs-formula-v2", "p1", "s1", "fanatec-dd2-professional", "fanatec-clubsport-pedals-v3", "rs-stand-t3xl", "buttkicker-gamer-2"].map(bySlug);
const catCover: Record<string, string> = { cockpits: "p1", solutions: "rs-formula-turnkey", motion: "rs-formula-m4a-full-motion", wheels: "fanatec-podium-steering-wheel-porsche-911-gt3-r", pedals: "fanatec-clubsport-pedals-v3", shifters: "fanatec-clubsport-shifter-sq-v1-5", stands: "rs-stand-t3xl", accessories: "buttkicker-gamer-2" };
const catCount = (id: string) => products.filter((p) => p.cat === id).length;
const specs = [
  ["Рама", "Алюминий 6063-T6"],
  ["Стенка профиля", "3,3 мм"],
  ["Рост пилота", "127–210 см"],
  ["Предсборка", "95 %"],
  ["Гарантия", "5 лет"],
  ["Производство", "Евросоюз"],
];
const steps = [
  ["Подбор", "Разбираем задачи, пространство и платформу — PC, PlayStation или Xbox. Собираем комплект под вас."],
  ["Тест-драйв", "20–30 минут на любом симуляторе в шоуруме. Бесплатно."],
  ["Доставка и монтаж", "Привозим, собираем и подключаем. Со склада в Москве — в течение рабочих суток."],
  ["Настройка", "Эргономика под ваш рост, софт, калибровка руля и педалей. Обучаем пилотированию."],
];
const installs = [5, 8, 27, 10, 4, 11, 12, 19, 3];
---
<Base nav="home">
  <script is:inline slot="head">
    try {
      if (!sessionStorage.getItem("rseat-lights") && !matchMedia("(prefers-reduced-motion: reduce)").matches)
        document.documentElement.classList.add("lights-on");
    } catch (e) {}
  </script>
  <!-- F1 start: five pairs of reds, one by one, then all out. Once per session. -->
  <div class="lights" aria-hidden="true">
    <div class="lights__gantry">
      {[0, 1, 2, 3, 4].map(() => <span class="pod"><i></i><i></i></span>)}
    </div>
    <p class="tag lights__cap" data-lcap>Внимание · старт</p>
    <p class="tag lights__skip">Коснитесь, чтобы пропустить</p>
  </div>
  <main>
    <!-- HERO -->
    <section class="hero">
      <div class="hero__media" data-power>
        <picture>
          <source media="(min-width: 900px)" srcset={srcset("hero-wide", [1600, 2400])} sizes="100vw" />
          <img src={img("hero-tall", 1150)} srcset={srcset("hero-tall", [800, 1150])} sizes="100vw" alt="Гоночный кокпит RSEAT C1 с рулевой базой в тёмной студии" fetchpriority="high" />
        </picture>
        <span class="hero__scan" aria-hidden="true"></span>
        <span class="hero__frame" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
      </div>
      <div class="wrap hero__body">
        <p class="tag hero__k" data-in style="--d:.35s"><span class="live"></span>Эксклюзивный дистрибьютор RSEAT · с 2014</p>
        <h1 class="d1 hero__t">
          <span class="ln"><span>Точность</span></span>
          <span class="ln"><span><b>гоночного</b></span></span>
          <span class="ln"><span><b>болида</b> — дома</span></span>
        </h1>
        <p class="lead hero__lead" data-in style="--d:.6s">Кокпиты RSEAT, motion-платформы D‑BOX и рули Fanatec. Подбор, доставка, монтаж и настройка под ключ.</p>
        <div class="hero__ctas" data-in style="--d:.7s">
          <a class="btn" href={url("catalog/")}>Каталог <Icon name="arrow" class="btn__ar" /></a>
          <a class="btn btn--ghost" href={url("showroom/")}>Тест-драйв <Icon name="arrow" class="btn__ar" /></a>
        </div>
      </div>
      <dl class="hero__hud wrap" data-in style="--d:.8s">
        <div><dt class="tag">Производство</dt><dd>Евросоюз</dd></div>
        <div><dt class="tag">География</dt><dd><span class="num" data-count="90">90</span> стран</dd></div>
        <div><dt class="tag">Гарантия</dt><dd>до <span class="num" data-count="5">5</span> лет</dd></div>
      </dl>
    </section>

    <!-- CATEGORIES -->
    <section class="sec">
      <div class="wrap">
        <div class="sh">
          <div class="sh__top"><span class="tag">[01]</span><span class="tag">Каталог</span></div>
          <div class="sh__row">
            <h2 class="d2" data-in>Всё для <b>пилота</b></h2>
            <p class="lead" data-in>Шасси, кресла и motion-платформы RSEAT. Рули, педали и коробки передач Fanatec и Thrustmaster. Стойки под один или три экрана.</p>
          </div>
        </div>
        <div class="cats">
          {categories.map((c, i) => {
            const cover = bySlug(catCover[c.id]);
            return (
              <a class:list={["cat", { "cat--hero": i === 0, "cat--wide": i === categories.length - 1 }]} href={url(`catalog/${c.id}/`)} data-in style={`--d:${(i % 4) * 0.06}s`}>
                <span class="cat__media studio ticks">
                  <img src={pimg(cover.variants[0].img[0], i === 0 ? 1200 : 600)} alt="" loading="lazy" decoding="async" />
                </span>
                <span class="cat__body">
                  <span class="tag">{String(i + 1).padStart(2, "0")} · {catCount(c.id)} поз.</span>
                  <span class="cat__t">{c.title}</span>
                  <span class="cat__n">{c.note}</span>
                </span>
                <Icon name="arrow" class="cat__ar" />
              </a>
            );
          })}
        </div>
      </div>
    </section>

    <!-- FLAGSHIP CONFIGURATOR -->
    <section class="sec sec--flag" id="flagship">
      <div class="wrap">
        <div class="sh">
          <div class="sh__top"><span class="tag">[02]</span><span class="tag">Флагман</span></div>
        </div>
        <div class="cfg">
          <div class="cfg__stage studio ticks" data-wipe>
            {flagship.variants.map((v, i) => (
              <img class:list={["cfg__img", { on: i === 0 }]} data-v={v.id} src={pimg(v.img[0], 1200)} srcset={`${pimg(v.img[0], 600)} 600w, ${pimg(v.img[0], 1200)} 1200w`} sizes="(min-width: 1000px) 58vw, 100vw" alt={`RSEAT A1 PRO Formula — ${v.labelRu.toLowerCase()}`} loading="lazy" decoding="async" />
            ))}
            <span class="cfg__badge tag">A1 · PRO · F</span>
          </div>
          <div class="cfg__info">
            <h2 class="d2" data-in>A1 PRO <b>Formula</b></h2>
            <p class="lead" data-in>Формульная посадка на экструдированном алюминии. Нулевой прогиб при максимальной нагрузке, готовность к D‑BOX G5.</p>
            <dl class="specs" data-in>
              {specs.map(([k, v]) => <div><dt class="tag">{k}</dt><dd>{v}</dd></div>)}
            </dl>
            <div class="cfg__pick" data-in>
              <p class="tag">Цвет рамы — <span class="cfg__name">{flagship.variants[0].labelRu}</span></p>
              <div class="sw" role="radiogroup" aria-label="Цвет рамы">
                {flagship.variants.map((v, i) => (
                  <button type="button" role="radio" aria-checked={i === 0 ? "true" : "false"} aria-label={v.labelRu} data-v={v.id} data-name={v.labelRu} style={`--c:${v.swatch[0]}`}></button>
                ))}
              </div>
            </div>
            <div class="cfg__buy" data-in>
              <p class="cfg__price">{rub(flagship.variants[0].price)}</p>
              <button class="btn" type="button" data-add={flagship.variants[0].id}>В корзину <Icon name="cart" class="btn__ar" /></button>
              <a class="ulink" href={url(`product/${flagship.slug}/`)}>Все характеристики</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- POPULAR -->
    <section class="sec">
      <div class="wrap">
        <div class="sh">
          <div class="sh__top"><span class="tag">[03]</span><span class="tag">Выбор пилотов</span></div>
          <div class="sh__row">
            <h2 class="d2" data-in>Популярное</h2>
            <a class="ulink sh__more" href={url("catalog/")} data-in>Весь каталог <Icon name="arrow" class="btn__ar" /></a>
          </div>
        </div>
      </div>
      <div class="rail">
        {popular.map((p, i) => <ProductCard p={p} d={Math.min(i, 3) * 0.06} />)}
      </div>
    </section>

    <!-- MOTION -->
    <section class="motion">
      <div class="motion__media" data-wipe>
        <img src={img("p1-dark", 1150)} srcset={srcset("p1-dark", [900, 1150])} sizes="(min-width: 1000px) 62vw, 100vw" alt="Кокпит RSEAT в тёмной студии" loading="lazy" decoding="async" data-par />
      </div>
      <div class="wrap motion__body">
        <div class="sh__top"><span class="tag">[04]</span><span class="tag">Motion · D‑BOX</span></div>
        <h2 class="d2" data-in>Каждый поребрик — <b>в кресле</b></h2>
        <p class="lead" data-in>Платформа D‑BOX 4250i на четырёх актуаторах передаёт крен, торможение, удары и вибрацию дороги. Любой RS1 можно развить до флагмана с системой движения.</p>
        <div class="motion__row" data-in>
          <div><p class="tag">{motion.name}</p><p class="motion__p">{rub(motion.from)}</p></div>
        </div>
        <div class="motion__ctas" data-in>
          <a class="btn btn--light" href={url(`product/${motion.slug}/`)}>Смотреть систему <Icon name="arrow" class="btn__ar" /></a>
          <a class="btn btn--ghost" href={wa("Здравствуйте! Хочу обсудить motion-симулятор D‑BOX.")} target="_blank" rel="noopener">Консультация <Icon name="wa" class="btn__ar" /></a>
        </div>
      </div>
    </section>

    <!-- TURNKEY -->
    <section class="sec">
      <div class="wrap">
        <div class="sh">
          <div class="sh__top"><span class="tag">[05]</span><span class="tag">Под ключ</span></div>
          <div class="sh__row">
            <h2 class="d2" data-in>От звонка <b>до первого круга</b></h2>
            <p class="lead" data-in>Мы не просто продаём оборудование: консультируем по технике и спорту, монтируем, настраиваем и обучаем. Среди клиентов — первые лица, крупные компании и звёзды шоу-бизнеса.</p>
          </div>
        </div>
        <ol class="steps">
          {steps.map(([t, d], i) => (
            <li class="ticks" data-in style={`--d:${i * 0.08}s`}>
              <span class="steps__n num">0{i + 1}<i></i></span>
              <h3 class="d3">{t}</h3>
              <p>{d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- INSTALLS -->
    <section class="sec sec--tight">
      <div class="wrap">
        <div class="sh">
          <div class="sh__top"><span class="tag">[06]</span><span class="tag">Инсталляции</span></div>
          <div class="sh__row">
            <h2 class="d2" data-in>Собрано <b>у клиентов</b></h2>
            <p class="lead" data-in>Кабинеты, офисы и клубы. Реализованные комплекты — от&nbsp;254&nbsp;920 до&nbsp;956&nbsp;069&nbsp;₽.</p>
          </div>
        </div>
      </div>
      <div class="rail film">
        {installs.map((n) => (
          <figure class="film__i" data-wipe>
            <img src={img(`inst-${n}`, 960)} alt="Гоночный симулятор RSEAT у клиента" loading="lazy" decoding="async" />
          </figure>
        ))}
      </div>
    </section>

    <!-- SHOWROOM CTA -->
    <section class="sec">
      <div class="wrap">
        <div class="show ticks">
          <div class="show__media" data-wipe>
            <img src={img("showroom", 1250)} srcset={srcset("showroom", [1000, 1250])} sizes="(min-width: 1000px) 50vw, 100vw" alt="Кокпит RSEAT B1 в шоуруме" loading="lazy" decoding="async" />
          </div>
          <div class="show__body">
            <div class="sh__top"><span class="tag">[07]</span><span class="tag">Шоурум</span></div>
            <h2 class="d2" data-in>Сядьте <b>за руль</b></h2>
            <p class="lead" data-in>Бесплатный тест-драйв 20–30 минут на любом симуляторе. Покажем качество вживую и подберём комплектацию.</p>
            <ul class="show__loc" data-in>
              {contacts.locations.map((l) => <li><span class="tag">{l.kind}</span><span>{l.city}, {l.address}</span></li>)}
            </ul>
            <div class="show__ctas" data-in>
              <a class="btn" href={wa("Здравствуйте! Хочу записаться на тест-драйв в шоуруме RSEAT.")} target="_blank" rel="noopener">Записаться <Icon name="wa" class="btn__ar" /></a>
              <a class="btn btn--ghost" href={contacts.phoneHref}>{contacts.phone} <Icon name="phone" class="btn__ar" /></a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Base>

<script>
  import { items, rollPrice } from "../scripts/cart";
  import { syncButtons } from "../scripts/app";
  const $$ = <T extends Element = HTMLElement>(s: string, el: ParentNode = document) => [...el.querySelectorAll<T>(s)];
  const rub = (n: number) => n.toLocaleString("ru-RU").replace(/\s/g, " ") + " ₽";

  // hero power-on once fonts/image are ready
  const hero = document.querySelector(".hero")!;
  const go = () => requestAnimationFrame(() => hero.classList.add("on"));
  const im = hero.querySelector("img")!;
  const html = document.documentElement;
  if (html.classList.contains("lights-on")) {
    const pods = $$(".pod");
    const cap = document.querySelector("[data-lcap]")!;
    const timers: number[] = [];
    let done = false;
    const out = () => {
      if (done) return;
      done = true;
      timers.forEach(clearTimeout);
      pods.forEach((p) => p.classList.remove("on"));
      cap.textContent = "Поехали";
      html.classList.add("lights-out");
      try { sessionStorage.setItem("rseat-lights", "1"); } catch {}
      setTimeout(go, 280);
      setTimeout(() => html.classList.remove("lights-on", "lights-out"), 1200);
    };
    pods.forEach((p, i) => timers.push(window.setTimeout(() => p.classList.add("on"), 450 + i * 340)));
    // like the real start: a short, unpredictable hold before lights out
    timers.push(window.setTimeout(out, 450 + 4 * 340 + 450 + Math.random() * 550));
    document.querySelector(".lights")!.addEventListener("click", out);
    addEventListener("keydown", out, { once: true });
  } else {
    im.complete ? go() : (im.addEventListener("load", go, { once: true }), setTimeout(go, 1200));
  }

  // counters
  const cio = new IntersectionObserver((es) => es.forEach((e) => {
    if (!e.isIntersecting) return;
    cio.unobserve(e.target);
    const el = e.target as HTMLElement, to = Number(el.dataset.count), t0 = performance.now();
    const tick = (t: number) => { const k = Math.min(1, (t - t0) / 1400); el.textContent = String(Math.round(to * (1 - Math.pow(1 - k, 4)))); if (k < 1) requestAnimationFrame(tick); };
    requestAnimationFrame(tick);
  }));
  $$("[data-count]").forEach((el) => cio.observe(el));

  // configurator
  const cfg = document.querySelector("#flagship")!;
  const imgs = $$<HTMLImageElement>(".cfg__img", cfg);
  const name = cfg.querySelector(".cfg__name")!;
  const price = cfg.querySelector(".cfg__price")!;
  const add = cfg.querySelector<HTMLElement>("[data-add]")!;
  const sws = $$<HTMLButtonElement>(".sw button", cfg);
  new IntersectionObserver((es, o) => { if (es[0].isIntersecting) { imgs.forEach((i) => (i.loading = "eager")); o.disconnect(); } }, { rootMargin: "800px" }).observe(cfg);
  const pick = (b: HTMLButtonElement) => {
    const id = b.dataset.v!;
    sws.forEach((s) => s.setAttribute("aria-checked", String(s === b)));
    imgs.forEach((i) => i.classList.toggle("on", i.dataset.v === id));
    name.textContent = b.dataset.name!;
    rollPrice(price as HTMLElement, items[id].p);
    add.dataset.add = id;
    syncButtons();
  };
  sws.forEach((s, i) => {
    s.addEventListener("click", () => pick(s));
    s.addEventListener("keydown", (e) => {
      const d = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
      if (!d) return;
      e.preventDefault();
      const n = sws[(i + d + sws.length) % sws.length]; n.focus(); pick(n);
    });
  });

  // gentle parallax on the motion image
  const par = document.querySelector<HTMLElement>("[data-par]");
  if (par && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    let tick = false;
    const upd = () => {
      tick = false;
      const r = par.parentElement!.getBoundingClientRect();
      if (r.bottom < 0 || r.top > innerHeight) return;
      par.style.transform = `translate3d(0, ${((r.top + r.height / 2 - innerHeight / 2) * -0.08).toFixed(1)}px, 0) scale(1.12)`;
    };
    addEventListener("scroll", () => { if (!tick) { tick = true; requestAnimationFrame(upd); } }, { passive: true });
    upd();
  }
</script>

<style is:global>
  .lights { display: none; }
  html.lights-on { overflow: hidden; }
  html.lights-on .lights {
    position: fixed;
    inset: 0;
    z-index: 300;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 22px;
    background: radial-gradient(60% 50% at 50% 45%, #111215 0%, var(--bg) 70%);
    cursor: pointer;
  }
  html.lights-out .lights { opacity: 0; visibility: hidden; transition: opacity 0.75s var(--ease-io) 0.2s, visibility 0s 1s; }
  .lights__gantry { position: relative; display: flex; gap: 8px; padding: 10px; background: #0c0d0f; border: 1px solid var(--line); }
  .lights__gantry::before { content: ""; position: absolute; left: -36%; right: -36%; top: 50%; height: 1px; background: linear-gradient(90deg, transparent, var(--line-2) 20%, var(--line-2) 80%, transparent); z-index: -1; }
  .pod { display: grid; gap: 7px; padding: 7px; background: #050506; border-radius: 4px; box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.04); }
  .pod i { width: clamp(22px, 7.2vw, 36px); aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle at 35% 30%, #2a1311, #110706 70%); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.05); transition: background 0.06s, box-shadow 0.06s; }
  .pod.on i { background: radial-gradient(circle at 35% 30%, #ff8d82, #ff2d20 45%, #b0140b); box-shadow: 0 0 18px 3px rgba(255, 45, 32, 0.55), 0 0 64px 10px rgba(255, 45, 32, 0.16); }
  .lights__cap { color: var(--text); letter-spacing: 0.3em; }
  .lights__skip { position: fixed; bottom: calc(24px + env(safe-area-inset-bottom)); left: 0; right: 0; text-align: center; color: var(--dim); }
  .js .hero:not(.on) [data-in].in { opacity: 0; transform: translateY(22px); }
</style>

<style>
  /* hero */
  .hero { position: relative; min-height: 100svh; display: flex; flex-direction: column; justify-content: flex-end; padding-top: var(--hdr); overflow: hidden; isolation: isolate; }
  .hero__media { position: absolute; inset: calc(var(--hdr) + env(safe-area-inset-top)) 0 auto; height: 60svh; z-index: -1; clip-path: inset(49.5% 0 49.5% 0); filter: brightness(2.2) saturate(0); transition: clip-path 0.8s var(--ease-io), filter 1s var(--ease); }
  .hero.on .hero__media { clip-path: inset(0); filter: none; }
  .hero__media img { width: 100%; height: 100%; object-fit: cover; object-position: 30% 55%; transform: scale(1.08); transition: transform 2.8s var(--ease); }
  .hero.on .hero__media img { transform: none; }
  .hero__media::after { content: ""; position: absolute; inset: 0; background: linear-gradient(0deg, var(--bg) 2%, rgba(6, 7, 8, 0) 45%); }
  .hero__scan { position: absolute; left: 0; right: 0; top: 0; height: 1px; background: rgba(255, 255, 255, 0.7); box-shadow: 0 0 18px 2px rgba(255, 255, 255, 0.35); opacity: 0; z-index: 2; }
  .hero.on .hero__scan { animation: scan 0.9s var(--ease-io) 0.15s both; }
  @keyframes scan { 0% { top: 50%; opacity: 0; } 15% { opacity: 1; } 100% { top: 100%; opacity: 0; } }
  .hero__frame i { position: absolute; width: 14px; height: 14px; border: 0 solid rgba(255, 255, 255, 0.55); z-index: 2; opacity: 0; transition: opacity 0.6s 0.6s; }
  .hero.on .hero__frame i { opacity: 1; }
  .hero__frame i:nth-child(1) { top: 14px; left: var(--gut); border-width: 1px 0 0 1px; }
  .hero__frame i:nth-child(2) { top: 14px; right: var(--gut); border-width: 1px 1px 0 0; }
  .hero__frame i:nth-child(3) { bottom: 14px; left: var(--gut); border-width: 0 0 1px 1px; display: none; }
  .hero__frame i:nth-child(4) { bottom: 14px; right: var(--gut); border-width: 0 1px 1px 0; display: none; }
  .hero__body { position: relative; padding-bottom: 26px; }
  .hero__k { display: flex; align-items: center; gap: 10px; margin-bottom: 18px; color: var(--text); }
  .live { width: 7px; height: 7px; border-radius: 50%; background: var(--red); box-shadow: 0 0 10px var(--red); animation: live 1.8s ease-in-out infinite; }
  @keyframes live { 50% { opacity: 0.25; } }
  .hero__t { margin-bottom: 18px; }
  .ln { display: block; overflow: hidden; padding-bottom: 0.08em; margin-bottom: -0.08em; }
  .ln > span { display: block; transform: translateY(110%); transition: transform 0.9s var(--ease); }
  .ln:nth-child(1) > span { transition-delay: 0.3s; }
  .ln:nth-child(2) > span { transition-delay: 0.38s; }
  .ln:nth-child(3) > span { transition-delay: 0.46s; }
  .hero.on .ln > span { transform: none; }
