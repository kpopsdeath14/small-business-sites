---
// Finish: a hairline Bordeaux glass fills with claret, the surface settles, then «Santé».
// Starts on `finale:go`.
---
<div class="fin" data-fin aria-hidden="true">
  <svg viewBox="0 0 200 260" class="fin__svg">
    <defs>
      <clipPath id="fin-bowl"><path d="M52 24 C46 70 46 108 62 132 C74 150 88 156 100 156 C112 156 126 150 138 132 C154 108 154 70 148 24 Z" /></clipPath>
      <linearGradient id="fin-wine" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#b3283f" /><stop offset="1" stop-color="#5a0d1c" />
      </linearGradient>
    </defs>
    <!-- the pour: a thin stream from above, then wine rising with a moving surface -->
    <path class="fin__stream" d="M100 -10 V140" />
    <g clip-path="url(#fin-bowl)">
      <path class="fin__wine" data-wine d="M30 160 Q65 156 100 160 T170 160 V170 H30 Z" fill="url(#fin-wine)" />
      <ellipse class="fin__shine" cx="80" cy="96" rx="5" ry="22" />
    </g>
    <path class="fin__glass" d="M52 24 C46 70 46 108 62 132 C74 150 88 156 100 156 C112 156 126 150 138 132 C154 108 154 70 148 24 M100 156 V226 M70 232 C80 226 120 226 130 232" pathLength="1" />
  </svg>
  <p class="fin__word">Santé</p>
</div>

<script>
  const el = document.querySelector<HTMLElement>("[data-fin]");
  if (el) document.addEventListener("finale:go", () => {
    el.classList.add("go");
    const wine = el.querySelector<SVGPathElement>("[data-wine]")!;
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const LEVEL = 98, t0 = performance.now() + 700, POUR = 2200;
    const frame = (t: number) => {
      const k = Math.max(0, Math.min(1, (t - t0) / POUR)), e = 1 - Math.pow(1 - k, 2);
      const y = 160 - (160 - LEVEL) * (reduced ? 1 : e);
      // the surface ripples while pouring and calms down after
      const amp = reduced ? 0 : (1 - k) * 3.5 + 0.6 * Math.sin(t / 900), ph = t / 260;
      const a = y + Math.sin(ph) * amp, b = y - Math.sin(ph) * amp;
      wine.setAttribute("d", `M30 ${b} Q65 ${a} 100 ${y} T170 ${b} V170 H30 Z`);
      if (k < 1 || t - t0 < POUR + 3000) requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);
  }, { once: true });
</script>

<style>
  .fin { display: grid; justify-items: center; gap: 4px; width: 100%; padding: 8px 0 4px; }
  .fin__svg { width: 150px; height: 195px; overflow: visible; }
  .fin__glass { fill: none; stroke: var(--text); stroke-width: 1.2; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 1; }
  .fin.go .fin__glass { stroke-dashoffset: 0; transition: stroke-dashoffset 1.1s var(--ease-io); }
  .fin__stream { stroke: #9e1f36; stroke-width: 3; stroke-linecap: round; stroke-dasharray: 160; stroke-dashoffset: 160; opacity: 0; }
  .fin.go .fin__stream { animation: stream 2.6s var(--ease-io) 0.6s both; }
  @keyframes stream { 0% { stroke-dashoffset: 160; opacity: 1; } 25% { stroke-dashoffset: 0; opacity: 1; } 80% { stroke-dashoffset: 0; opacity: 1; stroke-width: 2; } 100% { stroke-dashoffset: -160; opacity: 0; stroke-width: 1; } }
  .fin__shine { fill: rgba(255, 255, 255, 0.12); opacity: 0; }
  .fin.go .fin__shine { opacity: 1; transition: opacity 1s 2.8s; }
  .fin__word { font-family: var(--display); font-size: 40px; line-height: 1; opacity: 0; transform: translateY(8px); }
  .fin.go .fin__word { opacity: 1; transform: none; transition: opacity 1s var(--ease) 2.9s, transform 1.2s var(--ease) 2.9s; }
</style>
