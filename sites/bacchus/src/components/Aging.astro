---
/**
 * «Вино стареет красиво»: a glass of red tilted over a white tablecloth, the way a sommelier judges age
 * by the rim. Drag the years and the colour moves from purple through ruby and garnet to brick and amber.
 * When it scrolls into view, it ages on its own once, from 1 to 12 years.
 */
import { url } from "../lib/site";
import Icon from "./Icon.astro";
// [years, core, rim, name, what happens]
const STOPS = [
  [1, "#2e0a26", "#7c2763", "Фиолетовый", "Молодое вино: фиолетовый край, яркий фрукт, крепкие танины."],
  [5, "#3f0a17", "#a01d36", "Рубиновый", "Вино набирает сложность: край становится рубиновым."],
  [10, "#440e12", "#9b3329", "Гранатовый", "Танины смягчаются, появляются ноты кожи, табака и сухофруктов."],
  [20, "#4f190f", "#ad5b2c", "Кирпичный", "Край светлеет до кирпичного — вино на вершине."],
  [30, "#5e2611", "#bd8143", "Янтарный", "Так выглядят великие выдержанные вина. Если их хранили при 12 °C."],
] as const;
const track = STOPS.map(([y, , r]) => `${r} ${((y - 1) / 29) * 100}%`).join(", ");
---
<div class="age" data-age data-stops={JSON.stringify(STOPS)}>
  <div class="age__cloth" aria-hidden="true">
    <div class="age__glass" data-glass>
      <span class="age__wine"></span>
    </div>
    <p class="age__cap tag">Бокал над белой скатертью · край вина</p>
  </div>
  <div class="age__ctl">
    <p class="age__y"><span class="num" data-y>1</span><small data-yw> год</small></p>
    <p class="age__n" data-n>Фиолетовый</p>
    <p class="age__d" data-d>{STOPS[0][4]}</p>
    <input class="age__in" type="range" min="1" max="30" step="1" value="1" aria-label="Возраст вина, лет" data-in style={`--track: linear-gradient(90deg, ${track})`} />
    <div class="age__scale tag"><span>1 год</span><span>10</span><span>20</span><span>30 лет</span></div>
    <p class="age__note">Красивое старение возможно только в погребе: стабильные 12 °C, 70 % влажности, темнота и покой.</p>
    <a class="ulink" href={url("catalog/shkafy/?zones=1")}>Шкафы для выдержки <Icon name="arrow" class="btn__ar" /></a>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>("[data-age]")!;
  const S = JSON.parse(root.dataset.stops!) as [number, string, string, string, string][];
  const input = root.querySelector<HTMLInputElement>("[data-in]")!;
  const glass = root.querySelector<HTMLElement>("[data-glass]")!;
  const y = root.querySelector("[data-y]")!, yw = root.querySelector("[data-yw]")!, n = root.querySelector("[data-n]")!, d = root.querySelector("[data-d]")!;
  const hex = (h: string) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16));
  const mix = (a: string, b: string, k: number) => `rgb(${hex(a).map((v, i) => Math.round(v + (hex(b)[i] - v) * k)).join(",")})`;
  const word = (v: number) => { const a = v % 10, b = v % 100; return a === 1 && b !== 11 ? " год" : a >= 2 && a <= 4 && (b < 12 || b > 14) ? " года" : " лет"; };
  let last = "";
  const set = (v: number) => {
    let i = 0;
    while (i < S.length - 2 && v > S[i + 1][0]) i++;
    const [y0, c0, r0] = S[i], [y1, c1, r1] = S[i + 1];
    const k = Math.min(1, Math.max(0, (v - y0) / (y1 - y0)));
    glass.style.setProperty("--core", mix(c0, c1, k));
    glass.style.setProperty("--rim", mix(r0, r1, k));
    y.textContent = String(Math.round(v));
    yw.textContent = word(Math.round(v));
    const s = S[v >= S[S.length - 1][0] ? S.length - 1 : k > 0.5 ? i + 1 : i];
    if (s[3] !== last) { last = s[3]; n.textContent = s[3]; d.textContent = s[4]; n.animate([{ opacity: 0, transform: "translateY(6px)" }, { opacity: 1, transform: "none" }], { duration: 500, easing: "cubic-bezier(.16,1,.3,1)" }); }
  };
  let touched = false;
  input.addEventListener("input", () => { touched = true; set(Number(input.value)); });
  set(1);
  // once in view, the wine ages by itself from 1 to 12 years — unless the visitor takes the slider first
  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    new IntersectionObserver(([e], o) => {
      if (!e.isIntersecting) return;
      o.disconnect();
      const t0 = performance.now() + 400, dur = 2600;
      const run = (t: number) => {
        if (touched) return;
        const k = Math.min(1, Math.max(0, (t - t0) / dur)), v = 1 + 11 * (1 - Math.pow(1 - k, 2));
        set(v); input.value = String(Math.round(v));
        if (k < 1) requestAnimationFrame(run);
      };
      requestAnimationFrame(run);
    }, { threshold: 0.5 }).observe(root);
  }
</script>

<style>
  .age { display: grid; gap: 30px; }
  /* white linen: a faint weave so it reads as cloth, not a white box */
  .age__cloth { position: relative; display: grid; place-items: center; gap: 14px; aspect-ratio: 1 / 0.82; padding: 20px; background: repeating-linear-gradient(0deg, rgba(28, 21, 18, 0.025) 0 1px, transparent 1px 3px), repeating-linear-gradient(90deg, rgba(28, 21, 18, 0.02) 0 1px, transparent 1px 3px), radial-gradient(90% 80% at 50% 40%, #fbf8f2, #eee6d8); }
  .age__glass { --core: #2e0a26; --rim: #7c2763; position: relative; width: min(80%, 380px); aspect-ratio: 1.7; border-radius: 50%; transform: rotate(-12deg); box-shadow: 0 0 0 1px rgba(28, 21, 18, 0.13), inset 0 0 0 2px rgba(255, 255, 255, 0.7), 0 30px 36px -30px rgba(28, 21, 18, 0.35); }
  /* the wine in a tilted glass: deep at the bowl, thinning to a watery rim at the edge */
  /* tilted glass: the wine pools to the low side and thins out into a watery rim on the other */
  .age__wine { position: absolute; inset: 3%; border-radius: 50%; background: radial-gradient(ellipse 66% 86% at 63% 54%, var(--core) 0%, var(--core) 26%, var(--rim) 60%, color-mix(in srgb, var(--rim) 48%, transparent) 80%, color-mix(in srgb, var(--rim) 10%, transparent) 93%, transparent 100%); }
  .age__cap { position: absolute; left: 16px; bottom: 12px; color: #8b7c6e; font-size: 9.5px; }
  .age__ctl { display: grid; gap: 10px; align-content: start; justify-items: start; }
  .age__y { font-family: var(--display); font-size: 84px; line-height: 0.85; }
  .age__y .num { font-family: var(--display); }
  .age__y small { font-family: var(--sans); font-size: 15px; color: var(--mute); }
  .age__n { font-family: var(--display); font-size: 32px; line-height: 1; color: var(--straw); }
  .age__d { color: var(--mute); font-size: 15px; min-height: 3em; max-width: 30em; }
  .age__in { -webkit-appearance: none; appearance: none; width: 100%; height: 36px; margin: 8px 0 0; background: transparent; }
  .age__in::-webkit-slider-runnable-track { height: 6px; background: var(--track); }
  .age__in::-moz-range-track { height: 6px; background: var(--track); }
  .age__in::-webkit-slider-thumb { -webkit-appearance: none; width: 22px; height: 22px; margin-top: -8px; border-radius: 50%; background: var(--text); box-shadow: 0 0 0 5px rgba(241, 231, 216, 0.15); }
  .age__in::-moz-range-thumb { width: 22px; height: 22px; border: 0; border-radius: 50%; background: var(--text); }
  .age__scale { display: flex; justify-content: space-between; width: 100%; color: var(--dim); font-size: 9.5px; }
  .age__note { color: var(--text); font-size: 14.5px; margin-top: 8px; padding-top: 14px; border-top: 1px solid var(--line); width: 100%; }
  @media (min-width: 1000px) {
    .age { grid-template-columns: 1.1fr 1fr; gap: 80px; align-items: center; }
    .age__y { font-size: 110px; }
  }
</style>
