---
// Minimal 1.5px line icons, drawn on a 24 grid.
interface Props { name: "arrow" | "cart" | "close" | "plus" | "minus" | "wa" | "phone" | "check" | "back"; class?: string }
const { name, class: cls } = Astro.props;
---
<svg class={cls} width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
  {name === "arrow" && <path d="M4 12h15M13 6l6 6-6 6" />}
  {name === "back" && <path d="M20 12H5M11 6l-6 6 6 6" />}
  {name === "cart" && <><path d="M3 4h2.5l2.2 11h11l1.8-8H6.6" /><circle cx="9" cy="19.5" r="1.2" /><circle cx="17" cy="19.5" r="1.2" /></>}
  {name === "close" && <path d="M5 5l14 14M19 5L5 19" />}
  {name === "plus" && <path d="M12 5v14M5 12h14" />}
  {name === "minus" && <path d="M5 12h14" />}
  {name === "check" && <path d="M4 12.5l5 5L20 6.5" />}
  {name === "phone" && <path d="M6.6 10.8a15 15 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z" />}
  {name === "wa" && <path fill="currentColor" stroke="none" d="M12 3a9 9 0 0 0-7.8 13.5L3 21l4.6-1.2A9 9 0 1 0 12 3zm4.2 12.2c-.2.5-1 1-1.5 1-.4.1-.9.1-1.5-.1-.3-.1-.8-.3-1.4-.5-2.4-1-4-3.5-4.1-3.6-.1-.2-1-1.3-1-2.5s.6-1.8.9-2c.2-.3.5-.3.6-.3h.5c.1 0 .4 0 .6.4l.8 1.9c.1.1.1.3 0 .4l-.3.4-.4.4c-.1.1-.3.3-.1.6.2.3.7 1.1 1.4 1.8 1 .9 1.8 1.1 2 1.2.3.1.4.1.6-.1l.8-1c.2-.2.4-.2.6-.1l1.8.9c.3.1.4.2.5.3.1.1.1.6-.1 1.1z" />}
</svg>
