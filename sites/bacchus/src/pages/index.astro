---
import Base from "../layouts/Base.astro";
import ProductCard from "../components/ProductCard.astro";
import Icon from "../components/Icon.astro";
import Intro from "../components/Intro.astro";
import Thermostat from "../components/Thermostat.astro";
import Descent from "../components/Descent.astro";
import Aging from "../components/Aging.astro";
import Rack from "../components/Rack.astro";
import Foes from "../components/Foes.astro";
import { products, categories, bySlug, url, img, srcset, pimg, contacts, plural } from "../lib/site";
import catalog from "../data/catalog.json";

const featured = (catalog.featured as string[]).map(bySlug);
const count = (id: string) => products.filter((p) => p.cat === id).length;
const cover = (id: string) => (catalog.covers as Record<string, string>)[id] ?? products.find((p) => p.cat === id)!.img[0];
const cabinets = products.filter((p) => p.cat === "shkafy");
const capMin = Math.min(...cabinets.map((p) => p.cap ?? Infinity));
const capMax = Math.max(...cabinets.map((p) => p.cap ?? 0));
// the four enemies of wine, and how many cabinets in the catalogue guard against each
const has = (re: RegExp) => cabinets.filter((p) => p.specs.some((g) => g.rows.some(([k, v]) => re.test(`${k}: ${v}`)))).length;
const enemies = [
  ["Тепло", "Компрессор держит заданную температуру круглый год, а режим «Зима» подогревает шкаф в холодном помещении.", `${has(/Система охлаждения: Компрессор/i)} ${plural(has(/Система охлаждения: Компрессор/i), "модель", "модели", "моделей")} с компрессором`],
  ["Свет", "Ультрафиолет разрушает танины и ароматы за недели. Стеклопакет с УФ-фильтром, тонированное или глухое стекло.", `${has(/УФ/i)} ${plural(has(/УФ/i), "модель", "модели", "моделей")} с УФ-защитой`],
  ["Вибрация", "Встряска мешает осадку и ускоряет старение. Антивибрационные опоры и бесшумные компрессоры.", `${has(/антивибрац/i)} ${plural(has(/антивибрац/i), "модель", "модели", "моделей")} с антивибрацией`],
  ["Сухость", "При влажности ниже 50 % пробка пересыхает и пропускает воздух. «Плачущая» стенка держит 50–80 %.", `${has(/Поддержание влажности: Есть/i)} ${plural(has(/Поддержание влажности: Есть/i), "модель", "модели", "моделей")} держат влажность`],
];
const projects = [
  ["barvikha-b", "Барвиха", "Стеллажи из массива, ромбовидные ячейки, подсветка"],
  ["spiral", "Горки-6", "Спиральный погреб под стеклянным полом"],
  ["vault", "Казань", "Кирпичный свод, каменные стеллажи"],
  ["fominskoe", "Фоминское", "Дерево в отделке и стеллажах"],
  ["stairs", "Иваньковское шоссе", "Погреб с лестницей из гостиной"],
  ["razdory", "Раздоры", "Минимализм: белые каменные ячейки"],
  ["brick", "Салтыковка", "Традиционный погреб под сводом"],
];
const steps = [
  ["Проект", "Замер, расчёт теплопритоков и 3D-визуализация. Планируем вместимость, зоны и свет."],
  ["Климат", "Подбираем сплит-систему или моноблок под объём погреба, утепление и пароизоляцию."],
  ["Стеллажи", "Дерево, камень или металл — по эскизу. Ячейки под 0,75 л, магнумы и ящики."],
  ["Монтаж и сервис", "Собираем, запускаем, выводим на 12 °C и 70 %. Обслуживаем оборудование и после."],
];
---
<Base nav="home">
  <Intro />
  <main>
    <!-- HERO -->
    <section class="hero" data-hero>
      <div class="hero__media">
        <picture>
          <source media="(min-width: 1000px)" srcset={srcset("hero", [800, 1344])} sizes="60vw" />
          <img src={img("hero-tall", 900)} srcset={`${img("hero-tall", 600)} 600w, ${img("hero-tall", 900)} 900w`} sizes="100vw" alt="Винный погреб в Барвихе: стеллажи из массива, декантер на дегустационной полке" fetchpriority="high" />
        </picture>
      </div>
      <div class="wrap hero__body">
        <!-- the title is set on a wine label: deckled paper, gold foil rules, vintage line -->
        <div class="label" data-label>
          <p class="label__top"><span>Grand Cru</span><span class="label__clim"><i></i><span data-live>12,0</span> °C · 70 %</span><span>2004</span></p>
          <p class="label__house">Подвалы Бахуса</p>
          <h1 class="label__t">
            <span class="ln"><span>Вино, которое</span></span>
            <span class="ln"><span><i>становится лучше</i></span></span>
          </h1>
          <p class="label__bot">Шкафы · погреба · климат · под ключ</p>
        </div>
        <p class="lead hero__lead" data-in style="--d:.55s">Винные шкафы на {capMin}–{capMax} бутылок и погреба под ключ: проект, климатическое оборудование, стеллажи, монтаж и сервис.</p>
        <div class="hero__ctas" data-in style="--d:.65s">
          <a class="btn" href={url("catalog/shkafy/")}>Винные шкафы <Icon name="arrow" class="btn__ar" /></a>
          <a class="btn btn--ghost" href={url("pogreb/")}>Погреб под ключ <Icon name="arrow" class="btn__ar" /></a>
        </div>
      </div>
      <dl class="hero__hud wrap" data-in style="--d:.75s">
        <div><dt class="tag">С</dt><dd class="num">2004</dd></div>
        <div><dt class="tag">Погребов</dt><dd class="num"><span data-count="400">400</span>+</dd></div>
        <div><dt class="tag">Моделей</dt><dd class="num"><span data-count={products.length}>{products.length}</span></dd></div>
      </dl>
    </section>

    <!-- CATALOGUE -->
    <section class="sec">
      <div class="wrap">
        <div class="sh">
          <div class="sh__top"><span class="tag">[A1]</span><span class="tag">Каталог</span></div>
          <div class="sh__row">
            <h2 class="d2" data-in>Выберите <b>бутылку</b></h2>
            <p class="lead" data-in>Винные шкафы LaSommeliere, Climadiff, Avintage и Vinosafe. Климатические системы для погребов, стеллажи, диспенсеры для розлива и шкафы для сигар.</p>
          </div>
        </div>
        <Rack />
      </div>
    </section>

    <!-- THERMOSTAT -->
    <section class="sec sec--th" id="climate">
      <div class="wrap">
        <div class="sh">
          <div class="sh__top"><span class="tag">[A2]</span><span class="tag">Термостат</span></div>
          <div class="sh__row">
            <h2 class="d2" data-in>Сколько <b>градусов</b> нужно вашему вину</h2>
            <p class="lead" data-in>Потяните шкалу. Хранят любое вино при 10–14 °C, а подают каждое при своей температуре — поэтому шкафы бывают с одной, двумя и тремя зонами.</p>
          </div>
        </div>
        <Thermostat />
      </div>
    </section>

    <!-- DESCENT -->
    <Descent />

    <!-- POPULAR -->
    <section class="sec">
      <div class="wrap">
        <div class="sh">
          <div class="sh__top"><span class="tag">[A4]</span><span class="tag">Выбор сомелье</span></div>
          <div class="sh__row">
            <h2 class="d2" data-in>Популярные <b>шкафы</b></h2>
            <a class="ulink sh__more" href={url("catalog/shkafy/")} data-in>Все винные шкафы <Icon name="arrow" class="btn__ar" /></a>
          </div>
        </div>
      </div>
      <div class="rail">{featured.map((p, i) => <ProductCard p={p} d={Math.min(i, 3) * 0.06} />)}</div>
    </section>

    <!-- ENEMIES -->
    <section class="sec">
      <div class="wrap">
        <div class="sh">
          <div class="sh__top"><span class="tag">[A5]</span><span class="tag">Защита</span></div>
          <div class="sh__row">
            <h2 class="d2" data-in>Четыре врага <b>вина</b></h2>
            <p class="lead" data-in>Погреб и винный шкаф решают одну задачу: убрать всё, что заставляет вино стареть раньше времени.</p>
          </div>
        </div>
        <Foes enemies={enemies as [string, string, string][]} />
      </div>
    </section>

    <!-- AGING -->
    <section class="sec">
      <div class="wrap">
        <div class="sh">
          <div class="sh__top"><span class="tag">[A6]</span><span class="tag">Выдержка</span></div>
          <div class="sh__row">
            <h2 class="d2" data-in>Вино стареет <b>красиво</b></h2>
            <p class="lead" data-in>Сомелье наклоняет бокал над белой скатертью и по краю вина угадывает возраст. Потяните ползунок — так меняется цвет красного за тридцать лет.</p>
          </div>
        </div>
        <Aging />
      </div>
    </section>

    <!-- CELLAR -->
    <section class="cellar">
      <div class="cellar__media" data-wipe data-lantern>
        <img src={img("vault", 1400)} srcset={srcset("vault", [800, 1400])} sizes="(min-width: 1000px) 62vw, 100vw" alt="Винный погреб под кирпичным сводом, Казань" loading="lazy" decoding="async" data-par />
        <span class="lantern" aria-hidden="true"></span>
        <p class="tag lantern__hint">Посветите — коснитесь свода</p>
        <button type="button" class="lantern__btn" data-light aria-pressed="false"><i></i><span>Включить свет</span></button>
      </div>
      <div class="wrap cellar__body">
        <div class="sh__top"><span class="tag">[A7]</span><span class="tag">Погреб под ключ</span></div>
        <h2 class="d2" data-in>Погреб, который <b>держит 12 °C</b></h2>
        <p class="lead" data-in>Более 400 погребов для частных домов и ресторанов. Делаем всё — от проекта до сервиса — или только климат к вашему погребу.</p>
        <ol class="csteps">
          {steps.map(([t, d], i) => (
            <li data-in style={`--d:${i * 0.06}s`}><span class="num">0{i + 1}</span><div><h3>{t}</h3><p>{d}</p></div></li>
          ))}
        </ol>
        <div class="cellar__ctas" data-in>
          <a class="btn btn--light" href={url("pogreb/")}>Рассчитать погреб <Icon name="arrow" class="btn__ar" /></a>
          <a class="btn btn--ghost" href={contacts.phoneHref}>{contacts.phone} <Icon name="phone" class="btn__ar" /></a>
        </div>
      </div>
    </section>

    <!-- PROJECTS -->
    <section class="sec" id="projects">
      <div class="wrap">
        <div class="sh">
          <div class="sh__top"><span class="tag">[A8]</span><span class="tag">Проекты</span></div>
          <div class="sh__row">
            <h2 class="d2" data-in>Погреба <b>наших клиентов</b></h2>
            <p class="lead" data-in>Подмосковье и регионы: от компактного погреба под лестницей до хранилища на тысячи бутылок.</p>
          </div>
        </div>
      </div>
      <div class="rail film">
        {projects.map(([im, t, d]) => (
          <figure class="film__i" data-wipe>
            <span class="film__img"><img src={img(im, 600)} alt={`Винный погреб, ${t}`} loading="lazy" decoding="async" /></span>
            <figcaption><span class="tag">{t}</span><span>{d}</span></figcaption>
          </figure>
        ))}
      </div>
    </section>

    <!-- CLIENTS -->
    <section class="sec sec--tight wall" style={`--brick:url(${img("brick", 1600)})`}>
      <div class="wrap clients">
        <p class="tag">Работаем с ресторанами</p>
        <ul>{contacts.clients.map((c) => <li data-in>{c}</li>)}</ul>
      </div>
    </section>

    <!-- CONTACT -->
    <section class="sec">
      <div class="wrap">
        <div class="show filet">
          <div class="show__media" data-wipe>
            <img src={img("controller", 970)} srcset={srcset("controller", [600, 970])} sizes="(min-width: 1000px) 50vw, 100vw" alt="Пульт климатической системы погреба" loading="lazy" decoding="async" />
          </div>
          <div class="show__body">
            <div class="sh__top"><span class="tag">[A9]</span><span class="tag">Консультация</span></div>
            <h2 class="d2" data-in>Поговорим <b>о вашем вине</b></h2>
            <p class="lead" data-in>Подберём шкаф под коллекцию и место или рассчитаем климат для погреба. {contacts.hours}.</p>
            <ul class="show__loc" data-in>
              <li><span class="tag">Офис</span><span>{contacts.city}, {contacts.address}</span></li>
              <li><span class="tag">Телефоны</span><span>{contacts.phone} · {contacts.phone2}</span></li>
            </ul>
            <div class="show__ctas" data-in>
              <a class="btn" href={contacts.phoneHref}>Позвонить <Icon name="phone" class="btn__ar" /></a>
              <a class="btn btn--ghost" href={url("podbor/")}>Подобрать шкаф <Icon name="arrow" class="btn__ar" /></a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Base>

<script>
  const hero = document.querySelector<HTMLElement>("[data-hero]")!;
  const html = document.documentElement;
  const im = hero.querySelector("img")!;
  // lights on in the cellar: after the intro, or once the photo is ready
  const go = () => requestAnimationFrame(() => hero.classList.add("on"));
  if (html.classList.contains("intro")) document.addEventListener("intro:done", () => setTimeout(go, 250), { once: true });
  else im.complete ? go() : (im.addEventListener("load", go, { once: true }), setTimeout(go, 1200));

  // a live read-out: the controller nudges the cellar between 11,9 and 12,1 °C
  const live = document.querySelector("[data-live]")!;
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!reduced) setInterval(() => { if (!document.hidden) live.textContent = (11.9 + Math.round(Math.random() * 2) / 10).toFixed(1).replace(".", ","); }, 3200);

  // hero parallax: the photo pushes in, the label drifts up
  if (!reduced) {
    let tk = false;
    addEventListener("scroll", () => { if (tk) return; tk = true; requestAnimationFrame(() => { tk = false; hero.style.setProperty("--hz", Math.min(1, scrollY / innerHeight).toFixed(3)); }); }, { passive: true });
  }

  // counters
  const cio = new IntersectionObserver((es) => es.forEach((e) => {
    if (!e.isIntersecting) return;
    cio.unobserve(e.target);
    const el = e.target as HTMLElement, to = Number(el.dataset.count), t0 = performance.now();
    const tick = (t: number) => { const k = Math.min(1, (t - t0) / 1400); el.textContent = String(Math.round(to * (1 - Math.pow(1 - k, 4)))); if (k < 1) requestAnimationFrame(tick); };
    requestAnimationFrame(tick);
  }));
  document.querySelectorAll("[data-count]").forEach((el) => cio.observe(el));

  // lantern: the vault is dark; a pool of warm light follows the cursor or the last touch, and wanders when left alone
  {
    const box = document.querySelector<HTMLElement>("[data-lantern]")!;
    const btn = box.querySelector<HTMLButtonElement>("[data-light]")!;
    let tx = 0.5, ty = 0.45, x = 0.5, y = 0.45, idle = 0, vis = false, raf = 0;
    const step = (t: number) => {
      raf = 0;
      if (!vis || box.classList.contains("lit")) return;
      if (performance.now() - idle > 2600) { tx = 0.5 + Math.sin(t / 2300) * 0.3; ty = 0.42 + Math.sin(t / 1700) * 0.18; }
      x += (tx - x) * 0.06; y += (ty - y) * 0.06;
      box.style.setProperty("--lx", `${(x * 100).toFixed(2)}%`);
      box.style.setProperty("--ly", `${(y * 100).toFixed(2)}%`);
      raf = requestAnimationFrame(step);
    };
    const go = () => { if (!raf) raf = requestAnimationFrame(step); };
    const aim = (e: PointerEvent) => {
      const r = box.getBoundingClientRect();
      tx = (e.clientX - r.left) / r.width; ty = (e.clientY - r.top) / r.height; idle = performance.now();
      box.classList.add("held"); go();
    };
    box.addEventListener("pointermove", (e) => { if (e.pointerType === "mouse") aim(e); });
    box.addEventListener("pointerdown", (e) => { if (!(e.target as Element).closest("[data-light]")) aim(e); });
    new IntersectionObserver(([e]) => { vis = e.isIntersecting; if (vis) go(); }).observe(box.parentElement!);
    btn.addEventListener("click", () => {
      const lit = box.classList.toggle("lit");
      btn.setAttribute("aria-pressed", String(lit));
      btn.querySelector("span")!.textContent = lit ? "Погасить" : "Включить свет";
      if (!lit) go();
    });
    if (reduced) box.classList.add("lit");
  }

  // gentle parallax on the cellar photo
  const par = document.querySelector<HTMLElement>("[data-par]");
  if (par && !reduced) {
    let tick = false;
    const upd = () => {
      tick = false;
      const r = par.parentElement!.getBoundingClientRect();
      if (r.bottom < 0 || r.top > innerHeight) return;
      par.style.transform = `translate3d(0, ${((r.top + r.height / 2 - innerHeight / 2) * -0.08).toFixed(1)}px, 0) scale(1.12)`;
    };
    addEventListener("scroll", () => { if (!tick) { tick = true; requestAnimationFrame(upd); } }, { passive: true });
    upd();
  }
</script>

<style is:global>
  .js .hero:not(.on) [data-in].in { opacity: 0; transform: translateY(22px); }
</style>

<style>
  /* hero: the cellar fills the screen, the title sits on a wine label */
  .hero { position: relative; min-height: 100svh; display: flex; flex-direction: column; justify-content: flex-end; padding-top: calc(var(--hdr) + env(safe-area-inset-top)); overflow: hidden; isolation: isolate; }
  .hero__media { position: absolute; inset: 0; z-index: -1; overflow: hidden; }
  .hero__media img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; filter: brightness(0.06) saturate(0.4); transform: scale(calc(1.06 + var(--hz, 0) * 0.12)); transition: filter 2.2s var(--ease-io); }
  .hero.on .hero__media img { filter: none; }
  .hero__media::after { content: ""; position: absolute; inset: 0; background: linear-gradient(0deg, var(--bg) 4%, rgba(11, 9, 8, 0.55) 40%, rgba(11, 9, 8, 0.05) 70%); }
  .hero__body { position: relative; display: grid; gap: 16px; padding-bottom: 22px; }
  .label { position: relative; justify-self: start; width: min(100%, 420px); padding: 20px 22px 18px; color: #2a1810; text-align: center; background: radial-gradient(120% 90% at 30% 20%, #faf3e6, #efe4d0 60%, #e2d2b6); transform: translateY(calc(var(--hz, 0) * -60px)) rotate(-1deg); opacity: 0; transition: opacity 1.2s var(--ease) 0.25s; filter: drop-shadow(0 24px 30px rgba(0, 0, 0, 0.6));
    -webkit-mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100' preserveAspectRatio='none'><path d='M1 2 L4 0 L9 1.5 L15 .3 L22 1.4 L30 .2 L37 1.6 L45 .4 L52 1.3 L60 .1 L67 1.5 L75 .3 L82 1.4 L90 .2 L96 1.2 L100 .5 L99.4 8 L100 16 L99.2 25 L100 34 L99.3 43 L100 52 L99.2 61 L100 70 L99.4 79 L100 88 L99.3 96 L100 100 L94 98.8 L87 100 L79 98.6 L71 99.9 L63 98.7 L55 100 L47 98.6 L39 99.8 L31 98.7 L23 100 L15 98.8 L8 99.8 L0 99 L.8 91 L0 82 L.7 73 L0 64 L.8 55 L0 46 L.7 37 L0 28 L.8 19 L0 10 Z'/></svg>") center / 100% 100%; mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100' preserveAspectRatio='none'><path d='M1 2 L4 0 L9 1.5 L15 .3 L22 1.4 L30 .2 L37 1.6 L45 .4 L52 1.3 L60 .1 L67 1.5 L75 .3 L82 1.4 L90 .2 L96 1.2 L100 .5 L99.4 8 L100 16 L99.2 25 L100 34 L99.3 43 L100 52 L99.2 61 L100 70 L99.4 79 L100 88 L99.3 96 L100 100 L94 98.8 L87 100 L79 98.6 L71 99.9 L63 98.7 L55 100 L47 98.6 L39 99.8 L31 98.7 L23 100 L15 98.8 L8 99.8 L0 99 L.8 91 L0 82 L.7 73 L0 64 L.8 55 L0 46 L.7 37 L0 28 L.8 19 L0 10 Z'/></svg>") center / 100% 100%; }
  .hero.on .label { opacity: 1; }
  .label::before { content: ""; position: absolute; inset: 8px; border: 1px solid #a8803e; box-shadow: inset 0 0 0 3px #faf3e6, inset 0 0 0 4px rgba(168, 128, 62, 0.6); pointer-events: none; }
  .label__top { display: flex; justify-content: space-between; font-family: var(--mono); font-size: 9.5px; letter-spacing: 0.22em; text-transform: uppercase; color: #8a6a3a; padding: 4px 10px 8px; border-bottom: 1px solid rgba(168, 128, 62, 0.5); }
  .label__clim { display: inline-flex; align-items: center; gap: 5px; letter-spacing: 0.08em; color: #7d1a2c; }
  .label__clim i { width: 5px; height: 5px; border-radius: 50%; background: #9e1f36; animation: live 2.2s ease-in-out infinite; }
  .label__house { margin-top: 10px; font-family: var(--mono); font-size: 10px; letter-spacing: 0.3em; text-transform: uppercase; color: #7d1a2c; }
  .label__t { font-family: var(--display); font-weight: 400; font-size: clamp(38px, 11vw, 64px); line-height: 0.98; margin: 6px 0 10px; }
  .label__t i { font-style: normal; display: block; background: linear-gradient(100deg, #8a5e22 0%, #d9b265 30%, #f6e2a8 45%, #b8873a 60%, #8a5e22 100%) 0 0 / 220% 100%; -webkit-background-clip: text; background-clip: text; color: transparent; }
  .hero.on .label__t i { animation: foil 3.2s var(--ease-io) 1.2s both; }
  @keyframes foil { from { background-position: 100% 0; } to { background-position: 0 0; } }
  .label__bot { padding-top: 8px; border-top: 1px solid rgba(168, 128, 62, 0.5); font-size: 11.5px; letter-spacing: 0.08em; color: #5e4632; }
