---
/**
 * Once per visit: the workshop's branding iron comes down on an oak board and leaves the ЦИПС mark,
 * glowing for a moment as the wood chars. Then the board slides away. Tap to skip.
 */
import { BASE } from "../lib/site";
---
<script is:inline>
  try {
    if (!sessionStorage.getItem("cips-brand") && !matchMedia("(prefers-reduced-motion: reduce)").matches)
      document.documentElement.classList.add("brand");
  } catch (e) {}
</script>
<div class="brd" aria-hidden="true" style={`--wood:url(${BASE}/img/wood-oak-360.webp)`}>
  <div class="brd__board">
    <svg class="brd__mark" viewBox="0 0 220 150">
      <defs>
        <filter id="char" x="-20%" y="-20%" width="140%" height="140%"><feTurbulence type="fractalNoise" baseFrequency=".9" numOctaves="2" seed="4" /><feDisplacementMap in="SourceGraphic" scale="3" /><feGaussianBlur stdDeviation=".6" /></filter>
      </defs>
      <g filter="url(#char)" class="brd__burn">
        <ellipse cx="110" cy="75" rx="104" ry="70" fill="none" stroke-width="5" />
        <ellipse cx="110" cy="75" rx="90" ry="57" fill="none" stroke-width="2.4" />
        <text x="110" y="88" text-anchor="middle">ЦИПС</text>
        <text x="110" y="116" text-anchor="middle" class="brd__sm">С·П·Б · 2011</text>
      </g>
    </svg>
    <div class="brd__iron"><svg viewBox="0 0 80 160"><rect x="34" y="0" width="12" height="104" rx="3" /><rect x="10" y="104" width="60" height="14" rx="3" /><rect x="22" y="118" width="36" height="34" rx="4" class="brd__head" /></svg></div>
  </div>
  <p class="brd__skip">Коснитесь, чтобы войти в мастерскую</p>
</div>

<script>
  const html = document.documentElement;
  if (html.classList.contains("brand")) {
    const el = document.querySelector<HTMLElement>(".brd")!;
    let done = false;
    const t1 = setTimeout(() => el.classList.add("press"), 350);
    const t2 = setTimeout(() => el.classList.add("burnt"), 900);
    const t3 = setTimeout(go, 2600);
    function go() {
      if (done) return; done = true;
      [t1, t2, t3].forEach(clearTimeout);
      el.classList.add("burnt");
      try { sessionStorage.setItem("cips-brand", "1"); } catch {}
      html.classList.add("brand-out");
      document.dispatchEvent(new CustomEvent("brand:done"));
      setTimeout(() => html.classList.remove("brand", "brand-out"), 1200);
    }
    el.addEventListener("click", go);
    addEventListener("keydown", go, { once: true });
  }
</script>

<style is:global>
  .brd { display: none; }
  html.brand { overflow: hidden; }
  html.brand .brd { position: fixed; inset: 0; z-index: 300; display: grid; place-content: center; justify-items: center; gap: 26px; background: #1c1712; cursor: pointer; transition: transform 1.1s var(--ease-io); }
  html.brand-out .brd { transform: translateY(-100%); }
  .brd__board { position: relative; width: min(340px, 82vw); aspect-ratio: 1.45; background: var(--wood) center / 220px, #a8743a; box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.25), inset 0 -18px 30px rgba(0, 0, 0, 0.25), 0 30px 60px rgba(0, 0, 0, 0.5); display: grid; place-items: center; }
  .brd__mark { width: 82%; }
  .brd__burn { stroke: #2a1608; fill: #2a1608; opacity: 0; }
  .brd__burn text { font-family: var(--serif); font-weight: 700; font-size: 46px; letter-spacing: 6px; stroke: none; }
  .brd__burn .brd__sm { font-family: var(--mono); font-size: 12px; letter-spacing: 3px; font-weight: 400; }
  .burnt .brd__burn { opacity: 0.88; animation: char 1.6s ease-out both; }
  /* for a moment the fresh mark glows like a hot iron, then cools to a charred brown */
  @keyframes char { 0% { opacity: 0.2; filter: drop-shadow(0 0 6px rgba(255, 120, 30, 0.9)); stroke: #ff8a30; fill: #ff8a30; } 35% { filter: drop-shadow(0 0 3px rgba(255, 100, 20, 0.6)); stroke: #7a2e0c; fill: #7a2e0c; } 100% { opacity: 0.88; filter: none; stroke: #2a1608; fill: #2a1608; } }
  .brd__iron { position: absolute; left: 50%; bottom: 50%; width: 70px; margin-left: -35px; transform: translateY(-160px); transition: transform 0.55s cubic-bezier(0.5, 0, 0.75, 0), opacity 0.4s; }
  .brd__iron svg { fill: #3b332c; }
  .brd__iron .brd__head { fill: #6b4a2e; }
  .press .brd__iron { transform: translateY(-10px); }
  .burnt .brd__iron { transform: translateY(-190px); opacity: 0; transition: transform 0.9s var(--ease), opacity 0.6s 0.2s; }
  .brd__skip { font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(241, 235, 225, 0.45); }
</style>
