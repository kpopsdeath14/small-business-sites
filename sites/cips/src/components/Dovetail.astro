---
/** A dovetail joint between sections: two boards slide together and lock when the joint scrolls into view. */
const N = 5, W = 1200, H = 56, T = 34; // tails, width, board height, tail depth
const pitch = W / N;
// tail outline across the joint line (y = H): wide at the end, narrow at the root, as a real dovetail
let tails = `M0 0 H${W} V${H - T}`;
let pins = `M0 ${H + 40} H${W} V${H - T}`;
for (let i = N - 1; i >= 0; i--) {
  const c = i * pitch + pitch / 2, wide = pitch * 0.32, narrow = pitch * 0.2;
  tails += ` H${c + narrow} L${c + wide} ${H} H${c - wide} L${c - narrow} ${H - T}`;
}
tails += " H0 Z";
for (let i = N - 1; i >= 0; i--) {
  const c = i * pitch + pitch / 2, wide = pitch * 0.32, narrow = pitch * 0.2;
  pins += ` H${c + narrow} L${c + wide} ${H} H${c - wide} L${c - narrow} ${H - T}`;
}
pins += " H0 Z";
---
<div class="dv" data-dv aria-hidden="true">
  <svg viewBox={`0 0 ${W} ${H + 40}`} preserveAspectRatio="none">
    <defs>
      <pattern id="dv-a" width="300" height="40" patternUnits="userSpaceOnUse"><rect width="300" height="40" fill="#c99a5b" /><path d="M0 8 Q75 4 150 9 T300 7 M0 20 Q90 16 170 21 T300 19 M0 31 Q60 28 140 33 T300 30" stroke="#a8743a" stroke-width="1.2" fill="none" opacity=".55" /></pattern>
      <pattern id="dv-b" width="40" height="300" patternUnits="userSpaceOnUse"><rect width="40" height="300" fill="#8a5a32" /><path d="M10 0 Q6 80 11 160 T9 300 M27 0 Q31 90 26 170 T28 300" stroke="#5a3a24" stroke-width="1.2" fill="none" opacity=".55" /></pattern>
    </defs>
    <path class="dv__a" d={tails} fill="url(#dv-a)" />
    <path class="dv__b" d={pins} fill="url(#dv-b)" />
  </svg>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-dv]").forEach((el) => new IntersectionObserver(([e], o) => { if (e.isIntersecting) { o.disconnect(); el.classList.add("lock"); } }, { threshold: 0.6 }).observe(el));
</script>

<style>
  .dv { height: 64px; overflow: hidden; margin: 90px 0; }
  .dv svg { width: 100%; height: 100%; display: block; }
  .dv__a { transform: translateY(-34px); transition: transform 1s var(--ease); }
  .dv__b { transform: translateY(34px); transition: transform 1s var(--ease); }
  .dv.lock .dv__a, .dv.lock .dv__b { transform: none; }
  .dv.lock .dv__b { transition-delay: 0.1s; }
  .dv path { stroke: rgba(40, 25, 10, 0.35); stroke-width: 1; vector-effect: non-scaling-stroke; }
  @media (min-width: 1000px) { .dv { height: 80px; margin: 130px 0; } }
</style>
