---
/**
 * The catalogue as a cabinetmaker's chest of drawers: oak fronts with brass pulls.
 * Tap a drawer and it slides out, showing the work inside.
 */
import { CATALOG, img, rub, url } from "../lib/site";
const href = (id: string) => (["stair", "furniture", "billiard"].includes(id) ? url(`kontakty/?p=${id}`) : url(`konstruktor/?k=${id === "window" ? "window" : id}`));
const cta = (id: string) => (["stair", "furniture", "billiard"].includes(id) ? "Обсудить проект" : "Собрать в конструкторе");
---
<div class="chest" data-chest>
  {CATALOG.map((c, i) => (
    <section class="drw" data-drw>
      <button class="drw__front" type="button" aria-expanded={i === 0 ? "true" : "false"}>
        <span class="drw__no mm">{String(i + 1).padStart(2, "0")}</span>
        <span class="drw__t">{c.t}</span>
        <span class="drw__from mm">от {rub(c.from)}</span>
        <span class="drw__pull" aria-hidden="true"><i></i></span>
      </button>
      <div class="drw__box">
        <div class="drw__in">
          <div class="drw__img"><img src={img(c.img, 600)} srcset={`${img(c.img, 600)} 600w, ${img(c.img)} 1200w`} sizes="(min-width: 1000px) 40vw, 90vw" alt={c.t} loading="lazy" decoding="async" /></div>
          <div class="drw__txt">
            <p class="read">{c.note}</p>
            <a class="lnk" href={href(c.id)}>{cta(c.id)} →</a>
          </div>
        </div>
      </div>
    </section>
  ))}
</div>

<script>
  const chest = document.querySelector<HTMLElement>("[data-chest]")!;
  const drs = [...chest.querySelectorAll<HTMLElement>("[data-drw]")];
  const set = (d: HTMLElement, open: boolean) => {
    d.classList.toggle("open", open);
    d.querySelector(".drw__front")!.setAttribute("aria-expanded", String(open));
  };
  set(drs[0], true);
  drs.forEach((d) => d.querySelector(".drw__front")!.addEventListener("click", () => {
    const open = !d.classList.contains("open");
    drs.forEach((x) => set(x, x === d && open));
    if (typeof navigator.vibrate === "function") try { navigator.vibrate(8); } catch {}
  }));
</script>

<style>
  .chest { padding: 10px; background: linear-gradient(90deg, #4a2f1d, #5d3b24 50%, #4a2f1d); box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.3), 0 30px 60px -30px rgba(34, 29, 24, 0.6); display: grid; gap: 8px; }
  .drw { position: relative; }
  .drw__front { position: relative; z-index: 2; width: 100%; display: grid; grid-template-columns: 34px 1fr auto; grid-template-areas: "n t p" "n f p"; gap: 2px 12px; align-items: center; text-align: left; padding: 16px 18px; color: #2a1a0e;
    background: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='400' height='60'><filter id='f'><feTurbulence type='fractalNoise' baseFrequency='.012 .5' numOctaves='3' seed='7'/><feColorMatrix values='0 0 0 0 .55  0 0 0 0 .38  0 0 0 0 .2  0 0 0 .55 0'/></filter><rect width='400' height='60' filter='url(%23f)'/></svg>") center / 400px 60px, linear-gradient(180deg, #c99a5b, #b07d42);
    box-shadow: inset 0 1px 0 rgba(255, 240, 210, 0.45), inset 0 -2px 0 rgba(60, 35, 15, 0.35), inset 0 0 0 1px rgba(60, 35, 15, 0.3); transition: transform 0.7s var(--ease), box-shadow 0.4s; }
  .drw__front::before { content: ""; position: absolute; inset: 7px; border: 1px solid rgba(60, 35, 15, 0.28); box-shadow: inset 0 1px 0 rgba(255, 240, 210, 0.3); pointer-events: none; }
  .drw__no { grid-area: n; font-size: 12px; opacity: 0.6; }
  .drw__t { grid-area: t; font-family: var(--serif); font-size: clamp(22px, 5.6vw, 34px); line-height: 1.05; }
  .drw__from { grid-area: f; font-size: 12px; opacity: 0.75; }
  /* brass cup pull */
  .drw__pull { grid-area: p; width: 54px; height: 24px; border-radius: 0 0 27px 27px; background: linear-gradient(180deg, #8d6c2a, #e6c66f 40%, #b48d36); box-shadow: inset 0 2px 3px rgba(0, 0, 0, 0.35), 0 1px 0 rgba(255, 240, 200, 0.6); position: relative; }
  .drw__pull i { position: absolute; left: 6px; right: 6px; top: 3px; height: 8px; border-radius: 0 0 20px 20px; background: rgba(40, 25, 5, 0.55); }
  .drw.open .drw__front { transform: translateY(-2px); box-shadow: inset 0 1px 0 rgba(255, 240, 210, 0.45), inset 0 -2px 0 rgba(60, 35, 15, 0.35), inset 0 0 0 1px rgba(60, 35, 15, 0.3), 0 12px 20px -10px rgba(0, 0, 0, 0.6); }
  /* the box slides out from under the front */
  .drw__box { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.7s var(--ease); }
  .drw.open .drw__box { grid-template-rows: 1fr; }
  .drw__in { overflow: hidden; display: grid; gap: 14px; background: #efe3cf; box-shadow: inset 0 10px 18px -10px rgba(40, 25, 10, 0.55), inset 6px 0 0 #d9c3a1, inset -6px 0 0 #d9c3a1; padding: 0 16px; }
  .drw.open .drw__in { padding: 16px; }
  .drw__in { transition: padding 0.7s var(--ease); }
  .drw__img { aspect-ratio: 4 / 3; overflow: hidden; background: var(--paper-2); }
  .drw__img img { width: 100%; height: 100%; object-fit: cover; transform: scale(1.06); transition: transform 1.4s var(--ease); }
  .drw.open .drw__img img { transform: none; }
  .drw__txt { display: grid; gap: 12px; justify-items: start; }
  @media (min-width: 1000px) {
    .chest { padding: 14px; gap: 10px; }
    .drw__front { padding: 20px 28px; grid-template-columns: 50px 1fr auto auto; grid-template-areas: "n t f p"; gap: 24px; }
    .drw__in { grid-template-columns: 1.1fr 1fr; align-items: center; }
    .drw.open .drw__in { padding: 22px; gap: 40px; }
  }
</style>
