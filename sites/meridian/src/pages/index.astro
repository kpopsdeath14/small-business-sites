---
import Base from "../layouts/Base.astro";
import Intro from "../components/Intro.astro";
import Cost from "../components/Cost.astro";
import Line from "../components/Line.astro";
import Projects from "../components/Projects.astro";
import Smeta from "../components/Smeta.astro";
import { img, contacts, houses } from "../lib/site";
const minA = Math.min(...houses.map((h) => h.area)), maxA = Math.max(...houses.map((h) => h.area));
---
<Base>
  <Intro />
  <main>
    <!-- HERO: a full-bleed house in the forest; the headline sits on the dark spruce below the roofline -->
    <section class="hero forest">
      <img class="hero__ph" src={img("dom-gorki-289-0-0", 1200)} srcset={`${img("dom-gorki-289-0-0", 600)} 600w, ${img("dom-gorki-289-0-0", 1200)} 1200w`} sizes="100vw" alt="Дом из клееного бруса «Горки», 289 м²" width="1200" height="690" fetchpriority="high" />
      <div class="hero__shade"></div>
      <div class="wrap hero__in">
        <p class="kick" data-in>Свой лес · свой завод · с {contacts.since} года</p>
        <h1 class="h1" data-in style="--d:.08s">Дом <em>из нашего</em><br />леса</h1>
        <p class="read" data-in style="--d:.16s">Заготавливаем лес в Свердловской области, клеим брус на своём заводе в Верхней Туре и строим дома под ключ. {houses.length} проектов от {minA} до {maxA} м², смета — за один день.</p>
        <div class="hero__cta" data-in style="--d:.24s">
          <a class="btn" href="#cost">Сколько стоит мой дом</a>
          <a class="btn btn--line" href="#projects">Проекты</a>
        </div>
        <ul class="hero__facts" data-in style="--d:.3s">
          <li><b class="num">25 000 ₽</b>за м² тёплого контура</li>
          <li><b class="num">4–6 нед</b>производство комплекта</li>
          <li><b class="num">15+</b>стран, куда уходит наш брус</li>
        </ul>
      </div>
    </section>

    <section class="sec birchy" id="cost">
      <div class="wrap">
        <div class="sh" data-in>
          <p class="kick">Цена дома</p>
          <h2 class="h2">Сколько стоит <em>ваш дом</em></h2>
          <p class="read">Двигайте площадь — дом на чертеже собирается заново, венец за венцом, а цена тёплого контура считается по опубликованной цене «Меридиана».</p>
        </div>
        <Cost />
      </div>
    </section>

    <section class="sec birchy" id="projects">
      <div class="wrap">
        <div class="sh" data-in>
          <p class="kick">Проекты</p>
          <h2 class="h2">{houses.length} проектов — <em>фасад и план</em></h2>
          <p class="read">Нажмите «План» на карточке — увидите, как устроен дом внутри. Любой проект можно изменить под себя.</p>
        </div>
        <Projects />
      </div>
    </section>

    <section class="sec forest" id="line">
      <div class="wrap">
        <div class="sh" data-in>
          <p class="kick">Путь бруса</p>
          <h2 class="h2">От доски <em>до вагона</em></h2>
          <p class="read">Пятнадцать операций на нашей линии — листайте, и одна доска пройдёт их все.</p>
        </div>
        <Line />
      </div>
    </section>

    <section class="sec birchy" id="map">
      <div class="wrap map">
        <div class="sh" data-in>
          <p class="kick">Где строим</p>
          <h2 class="h2">Завод на Урале — <em>офисы рядом с вами</em></h2>
          <p class="read">Строим по всей России. Завод в Верхней Туре с собственной железнодорожной веткой, офисы и представители — в пяти городах.</p>
        </div>
        <div class="map__box" data-in>
          <svg class="map__svg" viewBox="0 0 100 80" role="img" aria-label="Схема: завод в Верхней Туре и офисы">
            <!-- the Ural ridge and the railway that leaves the plant -->
            <path class="map__ural" d="M56 2 C 54 14, 60 22, 57 34 S 60 54, 56 66 S 58 76, 55 80" />
            <path class="map__rail" d="M58 28 C 54 40, 46 44, 30 52 S 18 56, 12 56" />
            <path class="map__rail" d="M58 28 C 60 40, 61 46, 60 50" />
            {contacts.offices.map((o) => (
              <g class:list={["map__pin", { "map__pin--plant": o.plant }]} transform={`translate(${o.x} ${o.y})`}>
                <circle r={o.plant ? 2.6 : 1.8} />
                <text x={o.lx} y={o.ly} text-anchor={o.end ? "end" : o.mid ? "middle" : "start"}>{o.city}</text>
              </g>
            ))}
            <g class="map__train"><rect x="-3" y="-1.2" width="6" height="2.4" rx=".6" /></g>
          </svg>
        </div>
        <ul class="map__list">
          {contacts.offices.map((o) => <li><b>{o.city}{o.plant ? " · завод" : ""}</b><a href={`tel:${o.phone.replace(/[^+\d]/g, "")}`}>{o.phone}</a></li>)}
        </ul>
      </div>
    </section>

    <section class="sec forest" id="smeta">
      <div class="wrap">
        <div class="sh" data-in>
          <p class="kick">Смета за 1 день</p>
          <h2 class="h2">Посчитаем <em>ваш дом</em> к завтрашнему дню</h2>
        </div>
        <Smeta />
      </div>
    </section>
  </main>
</Base>

<style>
  .hero { position: relative; min-height: 100svh; display: grid; align-items: end; overflow: hidden; isolation: isolate; }
  .hero__ph { position: absolute; inset: 0 0 auto; z-index: -2; width: 100%; height: 56%; object-fit: cover; object-position: 50% 40%; animation: zoom 18s ease-out both; }
  @keyframes zoom { from { transform: scale(1.12); } }
  .hero__shade { position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgba(24, 41, 31, 0) 22%, rgba(24, 41, 31, 0.9) 44%, var(--spruce) 54%); }
  .hero__in { display: grid; gap: 16px; padding-top: 44vh; padding-bottom: 34px; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 10px; }
  .hero__cta .btn { flex: 1 1 220px; }
  .hero__facts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; padding-top: 16px; border-top: 1px solid var(--dline); font-size: 13px; color: #c3cbbf; line-height: 1.3; }
  .hero__facts b { display: block; font-size: 24px; font-weight: 600; color: var(--pine); }

  .map { display: grid; gap: 22px; }
  .map__box { border-radius: 6px; background: linear-gradient(160deg, #e9efe6, #dfe6da); padding: 10px; }
  .map__svg { width: 100%; height: auto; display: block; }
  .map__ural { fill: none; stroke: #9db08f; stroke-width: 5; stroke-linecap: round; opacity: 0.6; }
  .map__rail { fill: none; stroke: var(--ink); stroke-width: 0.5; stroke-dasharray: 1.4 1; }
  .map__pin circle { fill: var(--spruce); }
  .map__pin--plant circle { fill: var(--resin); animation: pulse 2s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
  @keyframes pulse { 50% { transform: scale(1.4); } }
  .map__pin text { font-family: var(--display); font-size: 3.2px; letter-spacing: 0.04em; text-transform: uppercase; fill: var(--ink); }
  .map__train rect { fill: var(--resin); }
  .map__train { offset-path: path("M58 28 C 54 40, 46 44, 30 52 S 18 56, 12 56"); animation: train 7s ease-in-out infinite; }
  @keyframes train { 0% { offset-distance: 0%; } 70%, 100% { offset-distance: 100%; } }
  .map__list { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .map__list li { display: grid; padding: 12px 14px; border-radius: 4px; background: #fff; }
  .map__list b { font-family: var(--display); font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; }
  .map__list a { font-size: 14.5px; color: var(--ink-2); }

  @media (min-width: 1000px) {
    .hero__ph { height: 100%; }
    .hero__shade { background: linear-gradient(90deg, rgba(24, 41, 31, 0.92) 0, rgba(24, 41, 31, 0.6) 45%, rgba(24, 41, 31, 0) 75%), linear-gradient(0deg, rgba(24, 41, 31, 0.6), transparent 40%); }
    .hero__in { padding-top: 22vh; padding-bottom: 60px; max-width: var(--max); }
    .hero__in > * { max-width: 640px; }
    #map .h2 { font-size: clamp(36px, 4vw, 64px); }
    .map { grid-template-columns: 1fr 1.2fr; grid-template-rows: auto 1fr; column-gap: 56px; }
    .map__box { grid-column: 2; grid-row: 1 / 3; }
  }
</style>
