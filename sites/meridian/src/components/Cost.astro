---
/**
 * «Сколько стоит дом»: area and storeys in, the house is redrawn course by course at its width,
 * the warm contour is priced at their 25 000 ₽ per m², and the projects nearest in area are offered.
 */
import { houses, img, PER_M2, url } from "../lib/site";
import { houseSVG } from "../scripts/house";
const list = houses.map((h) => ({ id: h.id, name: h.name, area: h.area, a: h.a, b: h.b, floors: h.floors, terrace: h.terrace, src: img(`${h.id}-0`, 600) }));
const first = houseSVG({ w: 9.5, floors: 2 });
---
<div class="co" data-co>
  <div class="co__draw">
    <div class="co__svg" data-svg set:html={first} />
    <p class="co__cap" data-cap></p>
  </div>
  <div class="co__ctl">
    <label class="rg"><span class="rg__l"><span>Площадь дома</span><b class="num" data-o-a></b></span><input type="range" min="40" max="380" step="1" value="150" data-area aria-label="Площадь дома, м²" /></label>
    <div class="co__fl" role="radiogroup" aria-label="Этажей">
      <button type="button" role="radio" aria-checked="false" data-fl="1">Одноэтажный</button>
      <button type="button" role="radio" aria-checked="true" data-fl="2">С мансардой / 2 этажа</button>
    </div>
    <div class="co__price">
      <p class="co__l">Тёплый контур</p>
      <p class="co__v num" data-price></p>
      <p class="co__f">Площадь × 25 000 ₽ за м² — опубликованная цена «Меридиана» за тёплый контур. Состав комплекта, фундамент и «под ключ» — в смете по проекту.</p>
    </div>
    <ol class="co__time">
      <li><b class="num">1 день</b>смета по проекту</li>
      <li><b class="num">4–6 нед</b>производство комплекта</li>
      <li><b class="num">2 года</b>гарантия</li>
    </ol>
    <p class="co__sug">Похожие проекты</p>
    <ul class="co__list" data-list></ul>
  </div>
</div>

<script define:vars={{ list, PER_M2 }}>
  window.__co = { list, PER_M2 };
</script>
<script>
  import { houseSVG } from "../scripts/house";
  const { list, PER_M2 } = (window as any).__co;
  const el = document.querySelector<HTMLElement>("[data-co]")!;
  const q = <E extends HTMLElement = HTMLElement>(s: string) => el.querySelector<E>(s)!;
  const area = q<HTMLInputElement>("[data-area]");
  let floors: 1 | 2 = 2, t = 0, lastW = 0, lastF = 0;
  const fmt = (n: number) => Math.round(n).toLocaleString("ru-RU") + " ₽";
  el.querySelectorAll<HTMLButtonElement>("[data-fl]").forEach((b) => b.addEventListener("click", () => { el.querySelectorAll("[data-fl]").forEach((x) => x.setAttribute("aria-checked", String(x === b))); floors = +b.dataset.fl! as 1 | 2; render(); }));
  area.addEventListener("input", render);
  function render() {
    const A = +area.value;
    // a plan close to square; the drawn front is one side, the attic gives ~75% of the ground floor
    const foot = floors === 2 ? A / 1.75 : A;
    const w = Math.round(Math.sqrt(foot * 1.25) * 10) / 10;
    q("[data-o-a]").textContent = `${A} м²`;
    q("[data-price]").textContent = fmt(A * PER_M2);
    q("[data-cap]").textContent = `Фасад ≈ ${String(w).replace(".", ",")} м · ${floors === 2 ? "два уровня" : "один этаж"}`;
    clearTimeout(t);
    // redraw only when the house really changes, so the courses fall in again
    if (Math.abs(w - lastW) >= 0.5 || floors !== lastF) t = window.setTimeout(() => { q("[data-svg]").innerHTML = houseSVG({ w, floors, terrace: A > 120 }); (q("[data-svg]").firstElementChild as HTMLElement).style.setProperty("--step", "22ms"); lastW = w; lastF = floors; }, 120);
    const near = list.filter((h: any) => floors === 1 ? h.floors === 1 : h.floors === 2).sort((a: any, b: any) => Math.abs(a.area - A) - Math.abs(b.area - A)).slice(0, 3);
    q("[data-list]").innerHTML = near.map((h: any) => `<li><button type="button" data-open="${h.id}"><img src="${h.src}" alt="" width="160" height="110" loading="lazy" /><span><b>${h.name}</b><small class="num">${h.area} м² · ${String(h.a).replace(".", ",")}×${String(h.b).replace(".", ",")} м</small><small class="num">${fmt(h.area * PER_M2)}</small></span></button></li>`).join("");
    q("[data-list]").querySelectorAll<HTMLButtonElement>("[data-open]").forEach((b) => b.addEventListener("click", () => document.dispatchEvent(new CustomEvent("house:open", { detail: { id: b.dataset.open, from: b } }))));
  }
  render();
</script>

<style>
  .co { display: grid; gap: 26px; }
  .co__draw { background: linear-gradient(180deg, #dfe8ee, var(--birch) 75%); border-radius: 6px; padding: 14px 14px 10px; color: var(--ink-2); }
  .co__svg { height: 260px; display: grid; place-items: end center; }
  .co__svg :global(svg) { height: 100%; width: 100%; }
  .co__cap { text-align: center; font-size: 13px; color: var(--mute); margin-top: 6px; }
  .co__ctl { display: grid; gap: 18px; align-content: start; }
  .rg { display: grid; gap: 2px; }
  .rg__l { display: flex; justify-content: space-between; align-items: baseline; font-family: var(--display); letter-spacing: 0.06em; text-transform: uppercase; font-size: 14px; color: var(--ink-2); }
  .rg__l b { font-size: 28px; font-weight: 600; color: var(--ink); letter-spacing: 0; }
  .rg input { -webkit-appearance: none; appearance: none; width: 100%; height: 40px; background: transparent; }
  /* the track is a glued beam: pale lamellas with dark glue lines */
  .rg input::-webkit-slider-runnable-track { height: 12px; border-radius: 2px; background: repeating-linear-gradient(180deg, var(--pine) 0 3px, #b0814a 3px 4px); }
  .rg input::-moz-range-track { height: 12px; border-radius: 2px; background: repeating-linear-gradient(180deg, var(--pine) 0 3px, #b0814a 3px 4px); }
  .rg input::-webkit-slider-thumb { -webkit-appearance: none; width: 30px; height: 30px; margin-top: -9px; border-radius: 50%; background: radial-gradient(circle, var(--resin) 0 3px, #e8c48c 3.5px 6px, #c9924f 6.5px 9px, #e8c48c 9.5px 12px, #7a5634 12.5px); box-shadow: 0 3px 8px rgba(0, 0, 0, 0.3); }
  .rg input::-moz-range-thumb { width: 30px; height: 30px; border: 0; border-radius: 50%; background: radial-gradient(circle, var(--resin) 0 3px, #e8c48c 3.5px 6px, #c9924f 6.5px 9px, #e8c48c 9.5px 12px, #7a5634 12.5px); }
  .co__fl { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
  .co__fl button { min-height: 48px; border-radius: 4px; box-shadow: inset 0 0 0 1.5px var(--line); font-weight: 700; font-size: 14.5px; transition: background 0.25s, color 0.25s; }
  .co__fl [aria-checked="true"] { background: var(--spruce); color: var(--birch); box-shadow: none; }
  .co__price { padding: 18px; border-radius: 6px; background: var(--spruce); color: var(--birch); }
  .co__l { font-family: var(--display); letter-spacing: 0.1em; text-transform: uppercase; font-size: 14px; color: var(--pine); }
  .co__v { font-size: clamp(40px, 11vw, 64px); font-weight: 600; line-height: 1.05; }
  .co__f { font-size: 13.5px; color: #c3cbbf; margin-top: 6px; line-height: 1.5; }
  .co__time { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
  .co__time li { padding: 12px 10px; border-radius: 4px; background: #fff; font-size: 13px; color: var(--ink-2); line-height: 1.3; }
  .co__time b { display: block; font-size: 22px; font-weight: 600; color: var(--resin); }
  .co__sug { font-family: var(--display); letter-spacing: 0.1em; text-transform: uppercase; font-size: 14px; color: var(--ink-2); }
  .co__list { display: grid; gap: 6px; }
  .co__list :global(button) { width: 100%; display: grid; grid-template-columns: 110px 1fr; gap: 12px; align-items: center; text-align: left; padding: 6px; border-radius: 4px; background: #fff; transition: box-shadow 0.25s; }
  @media (hover: hover) { .co__list :global(button:hover) { box-shadow: inset 0 0 0 2px var(--resin); } }
  .co__list :global(img) { width: 110px; height: 74px; object-fit: cover; border-radius: 3px; }
  .co__list :global(b) { display: block; font-family: var(--display); font-weight: 600; font-size: 19px; text-transform: uppercase; }
  .co__list :global(small) { display: block; font-size: 13px; color: var(--ink-2); }
  @media (min-width: 1000px) {
    .co { grid-template-columns: 1.2fr 1fr; gap: 56px; align-items: start; }
    .co__draw { position: sticky; top: calc(var(--hdr) + 24px); padding: 30px; }
    .co__svg { height: 440px; }
  }
</style>
