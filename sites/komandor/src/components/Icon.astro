---
// 1.5px line icons on a 24 grid.
interface Props { name: "boat" | "motor" | "compass" | "cart" | "phone" | "arrow" | "back" | "chat" | "trailer" | "close" | "plus" | "check" | "pin" | "anchor"; class?: string }
const { name, class: cls } = Astro.props;
---
<svg class={cls} width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === "boat" && <><path d="M3 15h18l-2.6 4.2a2 2 0 0 1-1.7.8H6.6a2 2 0 0 1-1.6-.8z" /><path d="M6 15l1.6-5h7.2L18 15" /><path d="M9.5 10V6.5h3" /></>}
  {name === "motor" && <><path d="M8 3h7a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2H8z" /><path d="M11 12v7l-3 2M11 19h5" /><path d="M8 6H6" /></>}
  {name === "compass" && <><circle cx="12" cy="12" r="9" /><path d="M15.5 8.5l-2 5-5 2 2-5z" /></>}
  {name === "cart" && <><path d="M3 4h2.5l2.2 11h11l1.8-8H6.6" /><circle cx="9" cy="19.5" r="1.2" /><circle cx="17" cy="19.5" r="1.2" /></>}
  {name === "phone" && <path d="M6.6 10.8a15 15 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z" />}
  {name === "arrow" && <path d="M4 12h15M13 6l6 6-6 6" />}
  {name === "back" && <path d="M20 12H5M11 6l-6 6 6 6" />}
  {name === "chat" && <path d="M4 5h16v11H9l-5 4z" />}
  {name === "trailer" && <><path d="M2 14h15v-4H5z" /><circle cx="9" cy="17" r="2" /><path d="M17 14h5" /></>}
  {name === "close" && <path d="M5 5l14 14M19 5L5 19" />}
  {name === "plus" && <path d="M12 5v14M5 12h14" />}
  {name === "check" && <path d="M4 12.5l5 5L20 6.5" />}
  {name === "anchor" && <><circle cx="12" cy="4.5" r="2" /><path d="M12 6.5V21M7 10h10M4 14c0 4 3.6 7 8 7s8-3 8-7" /></>}
  {name === "pin" && <><path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" /></>}
</svg>
