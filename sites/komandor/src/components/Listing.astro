---
/**
 * The catalogue as a boat-show price list: one row per model with the numbers that matter,
 * sortable by any column. A gallery view is one tap away.
 */
import Base from "../layouts/Base.astro";
import Icon from "./Icon.astro";
import type { Item } from "../lib/site";
import { boats, motors, trailers, url, pimg, rub, fmt, href, plural, TAGS } from "../lib/site";

interface Props { cat: "boats" | "motors" | "trailers" }
const { cat } = Astro.props;
const list = cat === "boats" ? boats : cat === "motors" ? motors : trailers;
const T = { boats: ["Катера", "и лодки"], motors: ["Моторы", "лодочные"], trailers: ["Прицепы", "для катеров"] }[cat];
const hpOf = (i: Item) => i.hp?.[1] ?? 0;
const cols = cat === "boats"
  ? [["len", "Длина", (i: Item) => i.len, (i: Item) => (i.len ? `${fmt(i.len)} м` : "—")], ["people", "Мест", (i: Item) => i.people, (i: Item) => i.people ?? "—"], ["hp", "Мотор", (i: Item) => hpOf(i), (i: Item) => (i.hp ? `до ${i.hp[1]}` : "—")]]
  : cat === "motors"
  ? [["hp", "Мощность", (i: Item) => hpOf(i), (i: Item) => (i.hp ? `${i.hp[1]} л. с.` : "—")], ["w", "Масса", (i: Item) => i.weight, (i: Item) => (i.weight ? `${i.weight} кг` : "—")]]
  : [["load", "Нагрузка", (i: Item) => i.load, (i: Item) => (i.load ? `${i.load} кг` : "—")], ["len", "Длина", (i: Item) => i.len, (i: Item) => (i.len ? `${fmt(i.len)} м` : "—")]];
const brands = [...new Set(list.map((i) => i.brand).filter(Boolean))];
const filters = cat === "boats" ? TAGS.filter((t) => list.some((b) => b.tags.includes(t))) : cat === "motors" ? ["до 30", "40–100", "115+"] : [];
const tagOf = (i: Item) => (cat === "boats" ? i.tags : cat === "motors" ? [hpOf(i) <= 30 ? "до 30" : hpOf(i) <= 100 ? "40–100" : "115+"] : []);
---
<Base title={`${T[0]} ${T[1]} — салон «Командор»`} description={`${T[0]} ${T[1]}: ${list.length} моделей с ценами. Салон в Жуковском, подбор, сервис.`} nav={cat === "motors" ? "motors" : "boats"}>
  <main class="lst">
    <header class="wrap lst__head">
      <nav class="lst__tabs" aria-label="Разделы">
        <a href={url("catalog/")} aria-current={cat === "boats" ? "page" : undefined}><Icon name="boat" />Катера <sup>{boats.length}</sup></a>
        <a href={url("catalog/motors/")} aria-current={cat === "motors" ? "page" : undefined}><Icon name="motor" />Моторы <sup>{motors.length}</sup></a>
        <a href={url("catalog/trailers/")} aria-current={cat === "trailers" ? "page" : undefined}><Icon name="trailer" />Прицепы <sup>{trailers.length}</sup></a>
      </nav>
      <h1 class="mark mark--l">{T[0]} <span class="out">{T[1]}</span></h1>
      <div class="lst__bar">
        {filters.length > 0 && (
          <form class="seg" data-f>
            <label><input type="radio" name="t" value="" checked /><span>Все</span></label>
            {filters.map((t) => <label><input type="radio" name="t" value={t} /><span>{t}{cat === "motors" ? " л. с." : ""}</span></label>)}
          </form>
        )}
        <div class="lst__view" role="group" aria-label="Вид">
          <button type="button" aria-pressed="true" data-v="table">Таблица</button>
          <button type="button" aria-pressed="false" data-v="grid">Галерея</button>
        </div>
      </div>
      <p class="fit mono" data-fitnote hidden></p>
      <p class="mono"><span data-n>{list.length}</span> {plural(list.length, "модель", "модели", "моделей")}{brands.length > 1 && ` · ${brands.slice(0, 6).join(", ")}`}</p>
    </header>

    <div class="wrap">
      <div class="tbl" data-tbl data-view="table" style={`--nc:${cols.length}`}>
        <div class="tbl__h" role="row">
          <span>Модель</span>
          {cols.map(([k, l]) => <button type="button" data-sort={k}>{l}<i></i></button>)}
          <button type="button" data-sort="price">Цена<i></i></button>
        </div>
        {list.map((i, n) => (
          <a class="tr" href={href(i)} data-tags={tagOf(i).join("|")} data-price={i.price || 9e9} data-sum={cols.map(([, l, , f]) => `${(f as (i: Item) => string | number)(i)}`).filter((v) => v !== "—").join(" · ")} {...Object.fromEntries(cols.map(([k, , g]) => [`data-${k}`, String((g as (i: Item) => number | null)(i) ?? 0)]))} style={`--d:${Math.min(n, 12) * 0.03}s`} data-in>
            <span class="tr__img"><img src={pimg(i.img[0])} alt="" loading={n < 6 ? "eager" : "lazy"} decoding="async" /></span>
            <span class="tr__n"><b>{i.name.replace(/^(Катер|Лодка|Лодочный мотор|Мотор|Прицеп для лодок и катеров)\s+/i, "")}</b><small class="mono">{i.brand}{i.stock ? " · в наличии" : ""}</small></span>
            {cols.map(([, , , f]) => <span class="tr__c num">{(f as (i: Item) => string | number)(i)}</span>)}
            <span class="tr__p">{i.price ? rub(i.price) : "по запросу"}</span>
          </a>
        ))}
      </div>
    </div>
  </main>
</Base>

<script>
  const tbl = document.querySelector<HTMLElement>("[data-tbl]")!;
  const rows = [...tbl.querySelectorAll<HTMLElement>(".tr")];
  const f = document.querySelector<HTMLFormElement>("[data-f]");
  const n = document.querySelector("[data-n]")!;
  let key = "", dir = 1;
  const apply = () => {
    const t = f ? String(new FormData(f).get("t") || "") : "";
    let k = 0;
    const sorted = key ? [...rows].sort((a, b) => (Number(a.dataset[key]) - Number(b.dataset[key])) * dir) : rows;
    sorted.forEach((r) => {
      tbl.appendChild(r);
      const on = !t || r.dataset.tags!.split("|").includes(t);
      r.hidden = !on;
      if (on) { r.animate([{ opacity: 0, transform: "translateY(8px)" }, { opacity: 1, transform: "none" }], { duration: 360, delay: Math.min(k, 14) * 22, easing: "cubic-bezier(.2,.9,.25,1)", fill: "backwards" }); k++; }
    });
    n.textContent = String(k);
  };
  tbl.querySelectorAll<HTMLButtonElement>("[data-sort]").forEach((b) => b.addEventListener("click", () => {
    const k = b.dataset.sort!;
    dir = key === k ? -dir : 1; key = k;
    tbl.querySelectorAll("[data-sort]").forEach((x) => x.removeAttribute("data-dir"));
    b.dataset.dir = dir > 0 ? "up" : "down";
    apply();
  }));
  f?.addEventListener("change", apply);
  // arriving from the slipway: show only what suits the chosen hull
  const fit = new URLSearchParams(location.search).get("fit");
  if (fit) {
    const [lo, hi] = fit.split("-").map(Number);
    const note = document.querySelector<HTMLElement>("[data-fitnote]")!;
    rows.forEach((r) => {
      if (hi) { const h = Number(r.dataset.hp); r.dataset.tags += h >= lo && h <= hi ? "|fit" : ""; }
      else { const c = Number(r.dataset.load); r.dataset.tags += c >= lo ? "|fit" : ""; }
    });
    note.textContent = hi ? `Под ваш корпус: ${lo}–${hi} л. с.` : `Под ваш катер с мотором: от ${lo} кг`;
    note.hidden = false;
    const only = () => { let k = 0; rows.forEach((r) => { r.hidden = !r.dataset.tags!.includes("fit"); if (!r.hidden) k++; }); n.textContent = String(k); };
    only();
    f?.addEventListener("change", () => setTimeout(only));
  }
  const q = new URLSearchParams(location.search).get("hp");
  if (f && q !== null) { const r = f.querySelectorAll<HTMLInputElement>("input")[Number(q) + 1]; if (r) { r.checked = true; apply(); } }
  // table / gallery
  document.querySelectorAll<HTMLButtonElement>("[data-v]").forEach((b) => b.addEventListener("click", () => {
    document.querySelectorAll("[data-v]").forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
    tbl.dataset.view = b.dataset.v!;
    try { localStorage.setItem("komandor-view", b.dataset.v!); } catch {}
  }));
  try { const v = localStorage.getItem("komandor-view"); if (v) document.querySelector<HTMLButtonElement>(`[data-v="${v}"]`)?.click(); } catch {}
</script>

<style>
  .lst { padding-top: calc(var(--top) + env(safe-area-inset-top) + 18px); }
  .lst__head { display: grid; gap: 16px; margin-bottom: 18px; }
  .lst__tabs { display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; }
  .lst__tabs a { flex: none; display: inline-flex; align-items: center; gap: 8px; height: 42px; padding: 0 16px 0 12px; border-radius: 999px; font-weight: 700; font-size: 14px; color: var(--soft); box-shadow: inset 0 0 0 1.5px var(--line); }
  .lst__tabs a svg { width: 20px; height: 20px; }
  .lst__tabs a[aria-current] { background: var(--navy); color: #fff; box-shadow: none; }
  .lst__tabs sup { font-family: var(--mono); font-size: 9.5px; opacity: 0.7; }
  .lst__bar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 10px; }
  .fit { display: inline-flex; justify-self: start; padding: 8px 14px; border-radius: 999px; background: var(--navy); color: #fff; }
  .lst__view { display: inline-flex; padding: 3px; border-radius: 999px; background: var(--mist); }
  .lst__view button { height: 34px; padding: 0 14px; border-radius: 999px; font-size: 13px; font-weight: 700; color: var(--soft); }
  .lst__view button[aria-pressed="true"] { background: var(--foam); color: var(--navy); box-shadow: 0 1px 4px rgba(11, 34, 54, 0.15); }

  /* table */
  .tbl { --cols: 1fr; }
  .tbl__h { display: none; }
  .tr { display: grid; grid-template-columns: 88px 1fr auto; grid-template-areas: "img n p" "img c c"; gap: 2px 14px; align-items: center; padding: 12px 0; border-bottom: 1px solid var(--line); }
  .tr[hidden] { display: none; }
  .tr__img { grid-area: img; aspect-ratio: 4 / 3; border-radius: 12px; overflow: hidden; background: #fff; }
  .tr__img img { width: 100%; height: 100%; object-fit: cover; }
  .tr__n { grid-area: n; display: grid; gap: 2px; min-width: 0; }
  .tr__n b { font-weight: 700; font-size: 15px; line-height: 1.25; }
  .tr__n small { font-size: 10px; }
  .tr__c { display: none; }
  .tr__p { grid-area: p; font-weight: 800; font-size: 14px; white-space: nowrap; align-self: start; padding-top: 2px; }
  .tr::after { grid-area: c; content: attr(data-sum); font-family: var(--mono); font-size: 11px; color: var(--soft); }
  .tbl[data-view="grid"] .tr::after { display: none; }
  /* gallery view */
  .tbl[data-view="grid"] { display: grid; grid-template-columns: 1fr 1fr; gap: 18px 10px; }
  .tbl[data-view="grid"] .tbl__h { display: none; }
  .tbl[data-view="grid"] .tr { grid-template-columns: 1fr; grid-template-areas: "img" "n" "p"; border: 0; padding: 0; align-items: start; }
  .tbl[data-view="grid"] .tr__img { border-radius: 18px; aspect-ratio: 1; }
  @media (hover: hover) { .tr:hover .tr__img img { transform: scale(1.05); } .tr__img img { transition: transform 0.8s var(--ease); } }
  @media (min-width: 760px) {
    .tbl[data-view="table"] .tbl__h, .tbl[data-view="table"] .tr { display: grid; grid-template-columns: 120px minmax(0, 2.2fr) repeat(var(--nc, 3), 1fr) 1.2fr; grid-template-areas: none; gap: 20px; }
    .tbl[data-view="table"] .tbl__h { position: sticky; top: 0; z-index: 2; padding: 12px 0; background: var(--hull); border-bottom: 1.5px solid var(--navy); font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--soft); }
    .tbl__h span { grid-column: 1 / span 2; }
    .tbl__h button { display: inline-flex; align-items: center; gap: 6px; text-transform: uppercase; font-size: 11px; letter-spacing: 0.06em; color: var(--soft); text-align: left; }
    .tbl__h button i { width: 7px; height: 7px; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: rotate(45deg); opacity: 0.3; }
    .tbl__h button[data-dir] { color: var(--navy); }
    .tbl__h button[data-dir] i { opacity: 1; }
    .tbl__h button[data-dir="down"] i { transform: rotate(-135deg); }
    .tbl[data-view="table"] .tr > * { grid-area: auto; }
    .tbl[data-view="table"] .tr::after { display: none; }
    .tbl[data-view="table"] .tr__c { display: block; font-size: 14px; }
    .tbl[data-view="table"] .tr__p { align-self: center; padding: 0; font-size: 15px; }
    .tbl[data-view="table"] .tr:hover { background: var(--foam); }
    .tbl[data-view="grid"] { grid-template-columns: repeat(3, 1fr); gap: 28px 16px; }
  }
  @media (min-width: 1000px) {
    .lst { padding-top: 48px; }
    .tbl[data-view="grid"] { grid-template-columns: repeat(4, 1fr); }
  }
</style>
