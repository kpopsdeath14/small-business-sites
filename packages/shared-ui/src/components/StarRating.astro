---
interface Props {
  rating: number;
  class?: string;
  size?: number;
  /** Stars pop in one-by-one when scrolled into view, instead of rendering static. */
  animated?: boolean;
}
const { rating, class: className = "", size = 16, animated = false } = Astro.props;
const rounded = Math.round(Math.min(5, Math.max(0, rating)));
---

<div
  class:list={["flex items-center gap-0.5", animated && "star-rating--animated", className]}
  aria-label={`Оценка ${rating} из 5`}
>
  {Array.from({ length: 5 }).map((_, i) => (
    <svg
      width={size}
      height={size}
      viewBox="0 0 20 20"
      fill={i < rounded ? "var(--color-accent)" : "none"}
      stroke="var(--color-accent)"
      stroke-width="1.2"
      style={animated ? `transition-delay: ${i * 90}ms` : undefined}
    >
      <path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.2 1 5.9-5.2-2.8-5.2 2.8 1-5.9-4.3-4.2 5.9-.8z" />
    </svg>
  ))}
</div>

<style>
  .star-rating--animated svg {
    opacity: 0;
    transform: scale(0.3) rotate(-15deg);
    transition-property: opacity, transform;
    transition-duration: 0.5s;
    transition-timing-function: cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .star-rating--animated.is-in-view svg {
    opacity: 1;
    transform: scale(1) rotate(0deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .star-rating--animated svg {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  // Self-contained (doesn't depend on Section.astro's reveal system, since this component can be
  // used outside a Section) — fails open via the timeout, same fail-safe pattern used elsewhere.
  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-in-view");
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.4 }
    );
    document.querySelectorAll(".star-rating--animated").forEach((el) => observer.observe(el));
    setTimeout(() => {
      document.querySelectorAll(".star-rating--animated:not(.is-in-view)").forEach((el) => el.classList.add("is-in-view"));
    }, 1500);
  } else {
    document.querySelectorAll(".star-rating--animated").forEach((el) => el.classList.add("is-in-view"));
  }
</script>
