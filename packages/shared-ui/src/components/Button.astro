---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
  href?: string;
  variant?: "primary" | "outline";
  size?: "md" | "lg";
  class?: string;
}
const { href, variant = "primary", size = "md", class: className = "", ...rest } = Astro.props;
const Tag = href ? "a" : "button";

const sizeClass = size === "lg" ? "px-6 py-3.5 text-base" : "px-5 py-2.5 text-sm";
const variantClass =
  variant === "primary"
    ? "bg-[var(--color-primary)] text-[var(--color-primary-contrast)] shadow-[var(--shadow-card)] hover:shadow-[var(--shadow-elevated)]"
    : "border border-[var(--color-border)] text-[var(--color-text)] backdrop-blur-sm bg-[var(--color-surface)]/40 hover:bg-[var(--color-surface)]/80";
---

<Tag
  href={href}
  {...rest}
  class:list={[
    "inline-flex items-center justify-center font-medium",
    "rounded-[var(--radius-md)]",
    "transition-all duration-300 ease-out",
    "hover:-translate-y-0.5 active:translate-y-0 active:scale-95",
    sizeClass,
    variantClass,
    className,
  ]}
>
  <slot />
</Tag>
