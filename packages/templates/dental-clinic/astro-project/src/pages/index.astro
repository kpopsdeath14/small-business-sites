---
import Base from "../layouts/Base.astro";
import Nav from "@sitegen/shared-ui/components/Nav.astro";
import HeroSection from "@sitegen/template-dental-clinic/sections/HeroSection.astro";
import AboutSection from "@sitegen/template-dental-clinic/sections/AboutSection.astro";
import ServicesSection from "@sitegen/template-dental-clinic/sections/ServicesSection.astro";
import TeamSection from "@sitegen/template-dental-clinic/sections/TeamSection.astro";
import FaqSection from "@sitegen/template-dental-clinic/sections/FaqSection.astro";
import GallerySection from "@sitegen/template-dental-clinic/sections/GallerySection.astro";
import ReviewsSection from "@sitegen/template-dental-clinic/sections/ReviewsSection.astro";
import ContactSection from "@sitegen/template-dental-clinic/sections/ContactSection.astro";
import FooterSection from "@sitegen/template-dental-clinic/sections/FooterSection.astro";
import type { SiteData } from "@sitegen/shared-ui/types.ts";
import siteDataJson from "../data/site.json";
import siteConfigJson from "../data/site-config.json";

const data = siteDataJson as unknown as SiteData;
const siteConfig = siteConfigJson as { sections: { id: string; variant: number }[] };

const sectionComponents: Record<string, any> = {
  hero: HeroSection,
  about: AboutSection,
  services: ServicesSection,
  team: TeamSection,
  faq: FaqSection,
  gallery: GallerySection,
  reviews: ReviewsSection,
  contact: ContactSection,
  footer: FooterSection,
};

const NAV_LABELS: Record<string, string> = {
  about: "О нас",
  services: "Услуги",
  team: "Врачи",
  faq: "Вопросы",
  gallery: "Галерея",
  reviews: "Отзывы",
  contact: "Контакты",
};

const navLinks = siteConfig.sections
  .filter((section) => section.id in NAV_LABELS)
  .map((section) => ({ label: NAV_LABELS[section.id], href: `#${section.id}` }));
---

<Base title={data.meta.title} description={data.meta.description}>
  <Nav siteName={data.name} links={navLinks} phone={data.phone} />
  {
    siteConfig.sections.map((section) => {
      const Cmp = sectionComponents[section.id];
      return Cmp ? <Cmp variant={section.variant} data={data} /> : null;
    })
  }
</Base>
