---
import Container from "@sitegen/shared-ui/components/Container.astro";
import Section from "@sitegen/shared-ui/components/Section.astro";
import type { SiteData } from "@sitegen/shared-ui/types.ts";

interface Props {
  data: SiteData;
}
const { data } = Astro.props;
---

<Section id="services">
  <Container narrow>
    <h2 class="font-[var(--font-heading)] text-3xl font-bold text-[var(--color-text)] text-center mb-10">Услуги и цены</h2>
    <div class="overflow-hidden rounded-[var(--radius-lg)] border border-[var(--color-border)] backdrop-blur-md shadow-[var(--shadow-card)]">
      <table class="w-full text-left border-collapse">
        <tbody>
          {data.items.map((item, i) => (
            <tr class={i % 2 === 0 ? "bg-[var(--color-bg)]/70" : "bg-[var(--color-surface)]/70"}>
              <td class="px-5 py-4">
                <p class="font-medium text-[var(--color-text)]">{item.name}</p>
                {item.description && <p class="text-sm text-[var(--color-text-muted)] mt-0.5">{item.description}</p>}
              </td>
              <td class="px-5 py-4 text-right font-medium text-[var(--color-text)] whitespace-nowrap align-top">
                {item.price}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </Container>
</Section>
