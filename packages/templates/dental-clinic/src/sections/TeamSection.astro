---
import Container from "@sitegen/shared-ui/components/Container.astro";
import SkeletonImg from "@sitegen/shared-ui/components/SkeletonImg.astro";
import { initials } from "@sitegen/shared-ui/utils/initials.ts";
import type { SiteData } from "@sitegen/shared-ui/types.ts";

interface Props {
  data: SiteData;
}
const { data } = Astro.props;
---

<section id="team" data-reveal class="relative bg-[var(--color-surface)] py-20 sm:py-28">
  <Container>
    <div class="text-center mb-14">
      <p class="text-xs uppercase tracking-[0.3em] text-[var(--color-primary)] font-semibold mb-3">Команда</p>
      <h2 class="font-[var(--font-heading)] text-3xl sm:text-4xl font-bold text-[var(--color-text)]">Наши врачи</h2>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {data.team.map((member) => (
        <div class="rounded-[var(--radius-lg)] bg-[var(--color-bg)] p-6 text-center shadow-[var(--shadow-card)]">
          {member.photo ? (
            <SkeletonImg src={member.photo} alt={member.name} class="mx-auto h-32 w-32 rounded-full" />
          ) : (
            <div class="mx-auto flex h-32 w-32 items-center justify-center rounded-full bg-[var(--color-surface)] text-2xl font-bold text-[var(--color-primary)]">
              {initials(member.name)}
            </div>
          )}
          <p class="mt-5 font-[var(--font-heading)] text-lg font-semibold text-[var(--color-text)]">{member.name}</p>
          {member.role && <p class="text-sm text-[var(--color-primary)]">{member.role}</p>}
          {member.bio && <p class="mt-2 text-sm text-[var(--color-text-muted)]">{member.bio}</p>}
        </div>
      ))}
    </div>
  </Container>
</section>
