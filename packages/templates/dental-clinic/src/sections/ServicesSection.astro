---
import type { SiteData } from "@sitegen/shared-ui/types.ts";
import ServicesTable from "./Services/ServicesTable.astro";
import ServicesGrid from "./Services/ServicesGrid.astro";

interface Props {
  variant: number;
  data: SiteData;
}
const { variant, data } = Astro.props;
const variants = [ServicesTable, ServicesGrid];
const Variant = variants[variant] ?? variants[0];
---

<Variant data={data} />
