---
import Container from "@sitegen/shared-ui/components/Container.astro";
import type { SiteData } from "@sitegen/shared-ui/types.ts";

interface Props {
  data: SiteData;
}
const { data } = Astro.props;

function groupByCategory(items: SiteData["items"]) {
  const map = new Map<string, SiteData["items"]>();
  for (const item of items) {
    const cat = item.category || "Услуги";
    if (!map.has(cat)) map.set(cat, []);
    map.get(cat)!.push(item);
  }
  return Array.from(map.entries());
}
const groups = groupByCategory(data.items);
---

<section id="services" data-reveal class="relative bg-[var(--color-bg)] py-20 sm:py-28">
  <Container narrow>
    <div class="text-center mb-14">
      <p class="text-xs uppercase tracking-[0.3em] text-[var(--color-primary)] font-semibold mb-3">Прайс-лист</p>
      <h2 class="font-[var(--font-heading)] text-3xl sm:text-4xl font-bold text-[var(--color-text)]">Услуги и цены</h2>
    </div>
    <div class="space-y-10">
      {groups.map(([category, items]) => (
        <div class="rounded-[var(--radius-lg)] bg-[var(--color-surface)] p-6 sm:p-8">
          <p class="text-sm uppercase tracking-wide text-[var(--color-primary)] font-semibold mb-4">{category}</p>
          <ul class="divide-y divide-[var(--color-border)]">
            {items.map((item) => (
              <li class="flex items-center justify-between gap-4 py-3">
                <span class="text-[var(--color-text)]">{item.name}</span>
                {item.price && <span class="font-semibold text-[var(--color-text)] whitespace-nowrap">{item.price}</span>}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </Container>
</section>
