---
import Container from "@sitegen/shared-ui/components/Container.astro";
import Section from "@sitegen/shared-ui/components/Section.astro";
import type { SiteData } from "@sitegen/shared-ui/types.ts";

interface Props {
  data: SiteData;
}
const { data } = Astro.props;
---

<Section id="stats" spacing="md" surface="surface">
  <Container>
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-6">
      {data.stats.map((stat) => (
        <div class="text-center">
          <p class="font-[var(--font-heading)] text-3xl sm:text-4xl font-bold text-[var(--color-primary)]">{stat.value}</p>
          <p class="mt-1 text-xs sm:text-sm text-[var(--color-text-muted)]">{stat.label}</p>
        </div>
      ))}
    </div>
  </Container>
</Section>
