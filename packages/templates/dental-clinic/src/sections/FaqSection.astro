---
import Container from "@sitegen/shared-ui/components/Container.astro";
import type { SiteData } from "@sitegen/shared-ui/types.ts";

interface Props {
  data: SiteData;
}
const { data } = Astro.props;
---

<section id="faq" data-reveal class="relative bg-[var(--color-bg)] py-20 sm:py-28">
  <Container narrow>
    <div class="text-center mb-12">
      <p class="text-xs uppercase tracking-[0.3em] text-[var(--color-primary)] font-semibold mb-3">Вопросы</p>
      <h2 class="font-[var(--font-heading)] text-3xl sm:text-4xl font-bold text-[var(--color-text)]">Часто спрашивают</h2>
    </div>
    <div class="space-y-3">
      {data.faq.map((item) => (
        <details class="group rounded-[var(--radius-md)] bg-[var(--color-surface)] px-6 py-4 open:pb-5">
          <summary class="flex cursor-pointer items-center justify-between gap-4 font-semibold text-[var(--color-text)] list-none">
            {item.question}
            <span class="shrink-0 text-[var(--color-primary)] transition-transform group-open:rotate-45 text-xl leading-none">+</span>
          </summary>
          <p class="mt-3 text-[var(--color-text-muted)] leading-relaxed">{item.answer}</p>
        </details>
      ))}
    </div>
  </Container>
</section>
