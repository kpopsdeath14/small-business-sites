---
import Container from "@sitegen/shared-ui/components/Container.astro";
import Button from "@sitegen/shared-ui/components/Button.astro";
import SocialLinks from "@sitegen/shared-ui/components/SocialLinks.astro";
import MapEmbed from "@sitegen/shared-ui/components/MapEmbed.astro";
import type { SiteData } from "@sitegen/shared-ui/types.ts";

interface Props {
  data: SiteData;
}
const { data } = Astro.props;
---

<section id="contact" data-reveal class="relative bg-[var(--color-bg)] py-20 sm:py-28">
  <Container>
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <div>
        <p class="text-xs uppercase tracking-[0.3em] text-[var(--color-primary)] font-semibold mb-3">Запись</p>
        <h2 class="font-[var(--font-heading)] text-3xl sm:text-4xl font-bold text-[var(--color-text)] mb-6">
          Запишитесь на приём
        </h2>
        <div class="space-y-2 text-[var(--color-text)] mb-8">
          {data.address && <p class="text-lg">{data.address}</p>}
          {data.phone && (
            <p>
              <a href={`tel:${data.phone.replace(/[^+\d]/g, "")}`} class="text-[var(--color-primary)] font-semibold text-xl hover:underline">{data.phone}</a>
            </p>
          )}
          {data.workingHours && Object.entries(data.workingHours).map(([days, hours]) => (
            <p class="text-[var(--color-text-muted)] text-sm">{days}: {hours}</p>
          ))}
        </div>
        <Button href={`tel:${(data.phone ?? "").replace(/[^+\d]/g, "")}`} size="lg">Записаться</Button>
        {data.socialLinks && Object.keys(data.socialLinks).length > 0 && (
          <div class="mt-6">
            <SocialLinks links={data.socialLinks} />
          </div>
        )}
      </div>
      <div>
        {(data.mapCoords || data.address) && (
          <MapEmbed address={data.address} lat={data.mapCoords?.lat} lng={data.mapCoords?.lng} class="aspect-[4/3]" />
        )}
      </div>
    </div>
  </Container>
</section>
