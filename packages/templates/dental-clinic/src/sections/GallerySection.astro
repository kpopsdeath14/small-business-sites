---
import Container from "@sitegen/shared-ui/components/Container.astro";
import Lightbox from "@sitegen/shared-ui/components/Lightbox.tsx";
import type { SiteData } from "@sitegen/shared-ui/types.ts";

interface Props {
  data: SiteData;
}
const { data } = Astro.props;
---

<section id="gallery" data-reveal class="relative bg-[var(--color-surface)] py-20 sm:py-28">
  <Container>
    <div class="text-center mb-12">
      <p class="text-xs uppercase tracking-[0.3em] text-[var(--color-primary)] font-semibold mb-3">Клиника</p>
      <h2 class="font-[var(--font-heading)] text-3xl sm:text-4xl font-bold text-[var(--color-text)]">Как у нас</h2>
    </div>
    <Lightbox
      client:visible
      photos={data.gallery}
      gridClassName="grid grid-cols-2 sm:grid-cols-3 gap-4"
      itemClassName="aspect-[4/3]"
      imgClassName="h-full w-full object-cover"
    />
  </Container>
</section>
