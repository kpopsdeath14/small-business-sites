---
import Container from "@sitegen/shared-ui/components/Container.astro";
import Section from "@sitegen/shared-ui/components/Section.astro";
import type { SiteData } from "@sitegen/shared-ui/types.ts";

interface Props {
  data: SiteData;
}
const { data } = Astro.props;
---

<Section id="about" surface="surface">
  <Container narrow class="text-center">
    <h2 class="font-[var(--font-heading)] text-3xl font-bold text-[var(--color-text)]">{data.about.heading}</h2>
    <p class="mt-6 text-lg text-[var(--color-text-muted)] leading-relaxed">{data.about.body}</p>
  </Container>
</Section>
