---
import Lightbox from "@sitegen/shared-ui/components/Lightbox.tsx";
import type { SiteData } from "@sitegen/shared-ui/types.ts";

interface Props {
  data: SiteData;
}
const { data } = Astro.props;
---

<section id="gallery" data-reveal class="relative bg-[var(--color-bg)] py-4">
  <Lightbox
    client:visible
    photos={data.gallery}
    gridClassName="columns-2 sm:columns-4 gap-1 px-1"
    itemClassName="mb-1 break-inside-avoid"
    imgClassName="w-full h-auto"
  />
</section>
