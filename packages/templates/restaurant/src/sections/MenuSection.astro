---
import type { SiteData } from "@sitegen/shared-ui/types.ts";
import MenuList from "./Menu/MenuList.astro";
import MenuGrid from "./Menu/MenuGrid.astro";
import MenuTabs from "./Menu/MenuTabs.astro";

interface Props {
  variant: number;
  data: SiteData;
}
const { variant, data } = Astro.props;
const variants = [MenuList, MenuGrid, MenuTabs];
const Variant = variants[variant] ?? variants[0];
---

<Variant data={data} />
