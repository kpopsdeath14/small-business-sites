---
import type { SiteData } from "@sitegen/shared-ui/types.ts";
import ContactMapSide from "./Contact/ContactMapSide.astro";
import ContactCentered from "./Contact/ContactCentered.astro";

interface Props {
  variant: number;
  data: SiteData;
}
const { variant, data } = Astro.props;
const variants = [ContactMapSide, ContactCentered];
const Variant = variants[variant] ?? variants[0];
---

<Variant data={data} />
