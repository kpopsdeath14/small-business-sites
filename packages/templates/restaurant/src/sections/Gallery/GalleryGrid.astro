---
import Container from "@sitegen/shared-ui/components/Container.astro";
import Section from "@sitegen/shared-ui/components/Section.astro";
import Lightbox from "@sitegen/shared-ui/components/Lightbox.tsx";
import type { SiteData } from "@sitegen/shared-ui/types.ts";

interface Props {
  data: SiteData;
}
const { data } = Astro.props;
---

<Section id="gallery" surface="surface">
  <Container>
    <h2 class="font-[var(--font-heading)] text-3xl font-bold text-[var(--color-text)] text-center mb-10">Галерея</h2>
    <Lightbox client:visible photos={data.gallery} />
  </Container>
</Section>
