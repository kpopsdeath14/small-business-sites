---
import Container from "@sitegen/shared-ui/components/Container.astro";
import StarRating from "@sitegen/shared-ui/components/StarRating.astro";
import type { SiteData } from "@sitegen/shared-ui/types.ts";

interface Props {
  data: SiteData;
}
const { data } = Astro.props;
---

<section id="reviews" data-reveal class="relative bg-[var(--color-surface)] py-20 sm:py-28">
  <Container>
    <div class="text-center mb-14">
      <p class="text-xs uppercase tracking-[0.35em] text-[var(--color-primary)] mb-3">Отзывы</p>
      <h2 class="font-[var(--font-heading)] italic text-[clamp(2rem,5vw,3.5rem)] text-[var(--color-text)]">
        Что говорят гости
      </h2>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {data.reviews.map((review) => (
        <div class="bg-[var(--color-bg)] p-6">
          <StarRating rating={review.rating} class="mb-3" />
          <p class="text-[var(--color-text)] leading-relaxed">«{review.text}»</p>
          <p class="mt-4 text-sm text-[var(--color-text-muted)]">{review.author}</p>
        </div>
      ))}
    </div>
  </Container>
</section>
