---
import Container from "@sitegen/shared-ui/components/Container.astro";
import Section from "@sitegen/shared-ui/components/Section.astro";
import type { SiteData } from "@sitegen/shared-ui/types.ts";

interface Props {
  variant: number;
  data: SiteData;
}
const { data } = Astro.props;
---

<Section id="highlights" surface="surface">
  <Container>
    <h2 class="font-[var(--font-heading)] text-3xl font-bold text-[var(--color-text)] text-center mb-16">Хиты меню</h2>
    <div class="space-y-16">
      {data.highlights.map((item, i) => {
        const reverse = i % 2 === 1;
        return (
          <div class="grid md:grid-cols-2 gap-10 items-center">
            <div class={reverse ? "md:order-2" : ""}>
              {item.photo ? (
                <img
                  src={item.photo}
                  alt={item.name}
                  class="w-full aspect-[4/3] rounded-[var(--radius-lg)] object-cover shadow-[var(--shadow-elevated)]"
                />
              ) : (
                <div class="aspect-[4/3] rounded-[var(--radius-lg)] bg-[var(--color-bg)]" />
              )}
            </div>
            <div class={reverse ? "md:order-1" : ""}>
              <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-[var(--color-primary)]">Хит меню</p>
              <h3 class="font-[var(--font-heading)] text-2xl sm:text-3xl font-bold text-[var(--color-text)]">{item.name}</h3>
              {item.description && <p class="mt-3 leading-relaxed text-[var(--color-text-muted)]">{item.description}</p>}
              {item.price && <p class="mt-4 text-xl font-semibold text-[var(--color-primary)]">{item.price}</p>}
            </div>
          </div>
        );
      })}
    </div>
  </Container>
</Section>
