---
import Container from "@sitegen/shared-ui/components/Container.astro";
import SkeletonImg from "@sitegen/shared-ui/components/SkeletonImg.astro";
import type { SiteData } from "@sitegen/shared-ui/types.ts";

interface Props {
  data: SiteData;
}
const { data } = Astro.props;
---

<section id="highlights" data-reveal class="relative bg-[var(--color-bg)] py-20 sm:py-28">
  <Container>
    <div class="text-center mb-14">
      <p class="text-xs uppercase tracking-[0.35em] text-[var(--color-primary)] mb-3">Фирменные блюда</p>
      <h2 class="font-[var(--font-heading)] italic text-[clamp(2rem,5vw,3.5rem)] text-[var(--color-text)]">
        Рекомендуем попробовать
      </h2>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {data.highlights.map((item) => (
        <div>
          {item.photo && <SkeletonImg src={item.photo} alt={item.name} class="aspect-[4/3] w-full mb-4" />}
          <div class="flex items-baseline justify-between gap-3">
            <p class="font-[var(--font-heading)] text-xl text-[var(--color-text)]">{item.name}</p>
            {item.price && <p class="text-[var(--color-primary)] font-semibold whitespace-nowrap">{item.price}</p>}
          </div>
          {item.description && <p class="mt-1 text-sm text-[var(--color-text-muted)]">{item.description}</p>}
        </div>
      ))}
    </div>
  </Container>
</section>
