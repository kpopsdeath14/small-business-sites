---
import Container from "@sitegen/shared-ui/components/Container.astro";
import SkeletonImg from "@sitegen/shared-ui/components/SkeletonImg.astro";
import type { SiteData } from "@sitegen/shared-ui/types.ts";

interface Props {
  data: SiteData;
}
const { data } = Astro.props;
const photo = data.team[0]?.photo ?? data.gallery[1]?.src;
---

<section id="about" data-reveal class="relative bg-[var(--color-bg)] py-20 sm:py-28">
  <Container>
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-16 items-center">
      <div class="lg:col-span-5">
        {photo && <SkeletonImg src={photo} alt={data.name} class="aspect-[4/5] w-full" />}
      </div>
      <div class="lg:col-span-7">
        <p class="text-xs uppercase tracking-[0.35em] text-[var(--color-primary)] mb-4">О нас</p>
        <p class="font-[var(--font-heading)] italic text-[clamp(1.8rem,4vw,3rem)] leading-[1.15] text-[var(--color-text)]">
          {data.about.heading}
        </p>
        <p class="mt-6 text-base sm:text-lg text-[var(--color-text-muted)] leading-relaxed max-w-2xl">
          {data.about.body}
        </p>
        {data.team[0]?.name && (
          <p class="mt-8 text-sm uppercase tracking-[0.25em] text-[var(--color-text)]">
            — {data.team[0].name}{data.team[0].role ? `, ${data.team[0].role}` : ""}
          </p>
        )}
      </div>
    </div>
  </Container>
</section>
