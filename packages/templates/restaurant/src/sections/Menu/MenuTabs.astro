---
import Container from "@sitegen/shared-ui/components/Container.astro";
import Section from "@sitegen/shared-ui/components/Section.astro";
import Card from "@sitegen/shared-ui/components/Card.astro";
import type { SiteData } from "@sitegen/shared-ui/types.ts";

interface Props {
  data: SiteData;
}
const { data } = Astro.props;

function groupByCategory(items: SiteData["items"]) {
  const map = new Map<string, SiteData["items"]>();
  for (const item of items) {
    const cat = item.category || "Меню";
    if (!map.has(cat)) map.set(cat, []);
    map.get(cat)!.push(item);
  }
  return Array.from(map.entries());
}
const groups = groupByCategory(data.items);

// CSS-only tab switching: no JS needed, driven by hidden radio inputs + generated sibling-selector CSS.
const panelCss = groups
  .map((_, i) => `#menu-tab-${i}:checked ~ .tab-panels [data-tab="${i}"] { display: block; }`)
  .join("\n");
const labelCss = groups
  .map(
    (_, i) =>
      `#menu-tab-${i}:checked ~ .tab-labels label[for="menu-tab-${i}"] { background: var(--color-primary); color: var(--color-primary-contrast); border-color: var(--color-primary); }`
  )
  .join("\n");
---

<Section id="menu">
  <Container>
    <h2 class="font-[var(--font-heading)] text-3xl font-bold text-[var(--color-text)] text-center mb-10">Меню</h2>

    {groups.map((_, i) => <input type="radio" name="menu-tab" id={`menu-tab-${i}`} class="sr-only" checked={i === 0} />)}

    <div class="tab-labels flex flex-wrap gap-2 justify-center mb-8">
      {groups.map(([category], i) => (
        <label
          for={`menu-tab-${i}`}
          class="cursor-pointer rounded-[var(--radius-md)] border border-[var(--color-border)] bg-[var(--color-surface)]/40 backdrop-blur-sm px-4 py-2 text-sm transition-all duration-300"
        >
          {category}
        </label>
      ))}
    </div>

    <Card hover={false} class="tab-panels max-w-2xl mx-auto">
      {groups.map(([, items], i) => (
        <div data-tab={i} class="hidden">
          <ul class="space-y-3">
            {items.map((item) => (
              <li class="flex justify-between gap-4 border-b border-[var(--color-border)] pb-3">
                <div>
                  <p class="font-medium text-[var(--color-text)]">{item.name}</p>
                  {item.description && <p class="text-sm text-[var(--color-text-muted)]">{item.description}</p>}
                </div>
                {item.price && <span class="whitespace-nowrap font-medium text-[var(--color-text)]">{item.price}</span>}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </Card>

    <style set:html={`${panelCss}\n${labelCss}`} />
  </Container>
</Section>
