---
import SkeletonImg from "@sitegen/shared-ui/components/SkeletonImg.astro";
import Button from "@sitegen/shared-ui/components/Button.astro";
import type { SiteData } from "@sitegen/shared-ui/types.ts";

interface Props {
  data: SiteData;
}
const { data } = Astro.props;
const heroPhoto = data.heroPhoto ?? data.gallery[0]?.src;
---

<section id="hero" class="relative h-[94vh] min-h-[560px] w-full overflow-hidden bg-[var(--color-bg)]">
  {heroPhoto && <SkeletonImg src={heroPhoto} alt="" class="absolute inset-0 h-full w-full" loading="eager" />}
  <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/35 to-black/10"></div>

  <div class="relative z-10 flex h-full items-center justify-center text-center">
    <div class="mx-auto w-full max-w-3xl px-4 sm:px-6">
      <p class="text-xs sm:text-sm tracking-[0.4em] uppercase text-white/70 mb-5">Ресторан</p>
      <h1 class="font-[var(--font-heading)] italic leading-[1.05] text-white text-[clamp(2.6rem,7vw,5.5rem)]">
        {data.name}
      </h1>
      <p class="mt-6 max-w-xl mx-auto text-base sm:text-lg text-white/85 leading-relaxed">
        {data.hero.subheading}
      </p>
      <div class="mt-9 flex flex-wrap items-center justify-center gap-4">
        <Button href="#contact" size="lg">{data.hero.ctaLabel}</Button>
        <a href="#menu" class="text-sm uppercase tracking-widest text-white/80 hover:text-white transition-colors border-b border-white/40 hover:border-white pb-1">
          Меню
        </a>
      </div>
    </div>
  </div>
</section>
