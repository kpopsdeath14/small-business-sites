---
import Container from "@sitegen/shared-ui/components/Container.astro";
import SkeletonImg from "@sitegen/shared-ui/components/SkeletonImg.astro";
import { initials } from "@sitegen/shared-ui/utils/initials.ts";
import type { SiteData } from "@sitegen/shared-ui/types.ts";

interface Props {
  data: SiteData;
}
const { data } = Astro.props;
---

<section id="team" data-reveal class="relative bg-[var(--color-surface)] py-20 sm:py-28">
  <Container>
    <div class="mb-14">
      <p class="text-xs uppercase tracking-[0.3em] text-[var(--color-primary)] font-bold mb-3">Инструкторы</p>
      <h2 class="font-[var(--font-heading)] uppercase text-[clamp(2rem,5vw,3.5rem)] leading-none text-[var(--color-text)]">
        Наша команда
      </h2>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {data.team.map((member) => (
        <div class="flex items-center gap-4 bg-[var(--color-bg)] border border-[var(--color-border)] p-5">
          {member.photo ? (
            <SkeletonImg src={member.photo} alt={member.name} class="h-16 w-16 rounded-full shrink-0" />
          ) : (
            <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-[var(--color-surface)] text-lg font-bold text-[var(--color-primary)]">
              {initials(member.name)}
            </div>
          )}
          <div>
            <p class="font-[var(--font-heading)] uppercase text-[var(--color-text)]">{member.name}</p>
            {member.role && <p class="text-sm text-[var(--color-primary)]">{member.role}</p>}
          </div>
        </div>
      ))}
    </div>
  </Container>
</section>
