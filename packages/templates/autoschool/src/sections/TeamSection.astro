---
import Container from "@sitegen/shared-ui/components/Container.astro";
import Section from "@sitegen/shared-ui/components/Section.astro";
import Card from "@sitegen/shared-ui/components/Card.astro";
import { initials } from "@sitegen/shared-ui/utils/initials.ts";
import type { SiteData } from "@sitegen/shared-ui/types.ts";

interface Props {
  variant: number;
  data: SiteData;
}
const { data } = Astro.props;
---

<Section id="team" surface="surface">
  <Container>
    <h2 class="font-[var(--font-heading)] text-3xl font-bold text-[var(--color-text)] text-center mb-10">Наши инструкторы</h2>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {data.team.map((member) => (
        <Card class="text-center">
          {member.photo ? (
            <img
              src={member.photo}
              alt={member.name}
              class="mx-auto h-24 w-24 rounded-full object-cover ring-4 ring-[var(--color-primary)]/20"
            />
          ) : (
            <div class="mx-auto h-24 w-24 rounded-full bg-[var(--color-primary)]/15 flex items-center justify-center text-xl font-bold text-[var(--color-primary)]">
              {initials(member.name)}
            </div>
          )}
          <p class="mt-4 font-semibold text-[var(--color-text)]">{member.name}</p>
          {member.role && (
            <p class="mt-1 inline-block rounded-full bg-[var(--color-primary)]/10 px-3 py-1 text-xs font-medium text-[var(--color-primary)]">
              {member.role}
            </p>
          )}
          {member.bio && <p class="mt-3 text-sm text-[var(--color-text-muted)]">{member.bio}</p>}
        </Card>
      ))}
    </div>
  </Container>
</Section>
