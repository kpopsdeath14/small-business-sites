---
import type { SiteData } from "@sitegen/shared-ui/types.ts";
import ReviewsGrid from "./Reviews/ReviewsGrid.astro";
import ReviewsQuote from "./Reviews/ReviewsQuote.astro";

interface Props {
  variant: number;
  data: SiteData;
}
const { variant, data } = Astro.props;
const variants = [ReviewsGrid, ReviewsQuote];
const Variant = variants[variant] ?? variants[0];
---

<Variant data={data} />
