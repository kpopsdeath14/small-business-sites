---
import Container from "@sitegen/shared-ui/components/Container.astro";
import Section from "@sitegen/shared-ui/components/Section.astro";
import type { SiteData } from "@sitegen/shared-ui/types.ts";

interface Props {
  data: SiteData;
}
const { data } = Astro.props;
const photo = data.gallery[1]?.src ?? data.gallery[0]?.src;
---

<Section id="about">
  <Container class="grid md:grid-cols-2 gap-10 items-center">
    {photo ? (
      <img src={photo} alt="" class="rounded-[var(--radius-lg)] shadow-[var(--shadow-card)] object-cover aspect-[4/3] w-full" />
    ) : (
      <div class="aspect-[4/3] rounded-[var(--radius-lg)] bg-[var(--color-surface)]" />
    )}
    <div>
      <h2 class="font-[var(--font-heading)] text-3xl font-bold text-[var(--color-text)]">{data.about.heading}</h2>
      <p class="mt-4 text-[var(--color-text-muted)] leading-relaxed">{data.about.body}</p>
    </div>
  </Container>
</Section>
