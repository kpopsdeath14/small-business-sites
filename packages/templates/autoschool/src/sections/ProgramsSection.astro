---
import type { SiteData } from "@sitegen/shared-ui/types.ts";
import ProgramsList from "./Programs/ProgramsList.astro";
import ProgramsGrid from "./Programs/ProgramsGrid.astro";

interface Props {
  variant: number;
  data: SiteData;
}
const { variant, data } = Astro.props;
const variants = [ProgramsList, ProgramsGrid];
const Variant = variants[variant] ?? variants[0];
---

<Variant data={data} />
