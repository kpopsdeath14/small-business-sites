---
import Container from "@sitegen/shared-ui/components/Container.astro";
import Button from "@sitegen/shared-ui/components/Button.astro";
import type { SiteData } from "@sitegen/shared-ui/types.ts";

interface Props {
  data: SiteData;
}
const { data } = Astro.props;
---

<section id="programs" data-reveal class="relative bg-[var(--color-surface)] py-20 sm:py-28">
  <Container>
    <div class="mb-14">
      <p class="text-xs uppercase tracking-[0.3em] text-[var(--color-primary)] font-bold mb-3">Программы</p>
      <h2 class="font-[var(--font-heading)] uppercase text-[clamp(2rem,5vw,3.5rem)] leading-none text-[var(--color-text)]">
        Курсы обучения
      </h2>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {data.items.map((item) => (
        <div class="bg-[var(--color-bg)] border border-[var(--color-border)] p-6 flex flex-col">
          {item.category && <p class="text-xs uppercase tracking-widest text-[var(--color-primary)] font-bold mb-2">{item.category}</p>}
          <p class="font-[var(--font-heading)] uppercase text-xl text-[var(--color-text)]">{item.name}</p>
          {item.description && <p class="mt-2 text-sm text-[var(--color-text-muted)] flex-1">{item.description}</p>}
          {item.price && <p class="mt-4 font-[var(--font-heading)] text-2xl text-[var(--color-primary)]">{item.price}</p>}
        </div>
      ))}
    </div>
    <div class="mt-10 text-center">
      <Button href="#contact" size="lg" class="uppercase tracking-wide font-bold">Записаться на курс</Button>
    </div>
  </Container>
</section>
