---
import Container from "@sitegen/shared-ui/components/Container.astro";
import type { SiteData } from "@sitegen/shared-ui/types.ts";

interface Props {
  data: SiteData;
}
const { data } = Astro.props;
---

<section id="process" data-reveal class="relative bg-[var(--color-bg)] py-20 sm:py-28">
  <Container>
    <div class="mb-14">
      <p class="text-xs uppercase tracking-[0.3em] text-[var(--color-primary)] font-bold mb-3">Как это устроено</p>
      <h2 class="font-[var(--font-heading)] uppercase text-[clamp(2rem,5vw,3.5rem)] leading-none text-[var(--color-text)]">
        Путь к правам
      </h2>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
      {data.processSteps.map((step, i) => (
        <div>
          <p class="font-[var(--font-heading)] text-5xl text-[var(--color-primary)]">{String(i + 1).padStart(2, "0")}</p>
          <p class="mt-4 font-[var(--font-heading)] uppercase text-lg text-[var(--color-text)]">{step.title}</p>
          {step.description && <p class="mt-2 text-sm text-[var(--color-text-muted)]">{step.description}</p>}
        </div>
      ))}
    </div>
  </Container>
</section>
