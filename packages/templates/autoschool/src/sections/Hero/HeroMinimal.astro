---
import Container from "@sitegen/shared-ui/components/Container.astro";
import Button from "@sitegen/shared-ui/components/Button.astro";
import type { SiteData } from "@sitegen/shared-ui/types.ts";

interface Props {
  data: SiteData;
}
const { data } = Astro.props;
---

<section id="hero" class="bg-[var(--color-surface)]">
  <Container narrow class="py-28 text-center">
    <h1 class="font-[var(--font-heading)] text-5xl sm:text-7xl font-bold text-[var(--color-text)] tracking-tight">
      {data.hero.heading}
    </h1>
    <p class="mt-6 text-xl text-[var(--color-text-muted)]">{data.hero.subheading}</p>
    <div class="mt-10">
      <Button href="#contact" size="lg">{data.hero.ctaLabel}</Button>
    </div>
  </Container>
</section>
