---
import Container from "@sitegen/shared-ui/components/Container.astro";
import Section from "@sitegen/shared-ui/components/Section.astro";
import MapEmbed from "@sitegen/shared-ui/components/MapEmbed.astro";
import BookingForm from "@sitegen/shared-ui/components/BookingForm.tsx";
import BookingWidget from "@sitegen/shared-ui/components/BookingWidget.astro";
import Card from "@sitegen/shared-ui/components/Card.astro";
import type { SiteData } from "@sitegen/shared-ui/types.ts";

interface Props {
  data: SiteData;
}
const { data } = Astro.props;
---

<Section id="contact">
  <Container narrow>
    <h2 class="font-[var(--font-heading)] text-3xl font-bold text-[var(--color-text)] text-center mb-4">Контакты</h2>
    <p class="text-center text-[var(--color-text-muted)] mb-10">
      {data.address}
      {data.phone && ` · ${data.phone}`}
    </p>
    <div class="max-w-md mx-auto mb-10">
      {data.bookingUrl ? (
        <BookingWidget url={data.bookingUrl} />
      ) : (
        <Card hover={false}>
          <BookingForm client:visible submitLabel="Записаться" successMessage="Заявка отправлена, спасибо!" phone={data.phone} />
        </Card>
      )}
    </div>
    <MapEmbed address={data.address} lat={data.mapCoords?.lat} lng={data.mapCoords?.lng} class="aspect-[21/9]" />
  </Container>
</Section>
