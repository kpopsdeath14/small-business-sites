---
import SkeletonImg from "@sitegen/shared-ui/components/SkeletonImg.astro";
import Button from "@sitegen/shared-ui/components/Button.astro";
import BrassRule from "../components/BrassRule.astro";
import type { SiteData } from "@sitegen/shared-ui/types.ts";

interface Props {
  data: SiteData;
}
const { data } = Astro.props;
const heroPhoto = data.heroPhoto ?? data.gallery[0]?.src;
const telegram = data.socialLinks?.telegram;
---

<section id="hero" class="relative h-[100svh] min-h-[560px] w-full overflow-hidden bg-[var(--color-bg)]">
  {heroPhoto && <SkeletonImg src={heroPhoto} alt="" class="absolute inset-0 h-full w-full" loading="eager" />}
  <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-black/20"></div>

  <div class="relative z-10 flex h-full items-center">
    <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-xl">
        <BrassRule class="mb-6 max-w-[140px]" />
        <h1 class="font-[var(--font-heading)] uppercase leading-[0.95] text-white text-[clamp(2.8rem,8vw,5.5rem)] tracking-wide">
          {data.name}
        </h1>
        <p class="mt-6 text-base sm:text-lg text-white/80 leading-relaxed">
          {data.hero.subheading}
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-4">
          {telegram ? (
            <Button href={telegram} size="lg" class="!rounded-none uppercase tracking-widest text-sm font-semibold">
              Записаться
            </Button>
          ) : data.phone ? (
            <Button href={`tel:${data.phone.replace(/[^+\d]/g, "")}`} size="lg" class="!rounded-none uppercase tracking-widest text-sm font-semibold">
              Записаться
            </Button>
          ) : null}
          <a href="#gallery" class="text-sm uppercase tracking-widest text-white/70 hover:text-white transition-colors border-b border-white/30 hover:border-white pb-1">
            Наши работы
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
