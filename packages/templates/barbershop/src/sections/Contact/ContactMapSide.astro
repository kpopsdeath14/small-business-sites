---
import Container from "@sitegen/shared-ui/components/Container.astro";
import Section from "@sitegen/shared-ui/components/Section.astro";
import MapEmbed from "@sitegen/shared-ui/components/MapEmbed.astro";
import BookingForm from "@sitegen/shared-ui/components/BookingForm.tsx";
import BookingWidget from "@sitegen/shared-ui/components/BookingWidget.astro";
import Card from "@sitegen/shared-ui/components/Card.astro";
import type { SiteData } from "@sitegen/shared-ui/types.ts";

interface Props {
  data: SiteData;
}
const { data } = Astro.props;
const hoursEntries = Object.entries(data.workingHours ?? {});
---

<Section id="contact" surface="surface">
  <Container>
    <h2 class="font-[var(--font-heading)] text-3xl font-bold text-[var(--color-text)] text-center mb-10">Контакты</h2>
    <div class="grid md:grid-cols-2 gap-10">
      <div>
        <div class="space-y-2 mb-6 text-[var(--color-text-muted)]">
          {data.address && <p>{data.address}</p>}
          {data.phone && <p>{data.phone}</p>}
          {hoursEntries.map(([days, hours]) => (
            <p>
              {days}: {hours}
            </p>
          ))}
        </div>
        <MapEmbed address={data.address} lat={data.mapCoords?.lat} lng={data.mapCoords?.lng} class="aspect-video" />
      </div>
      {data.bookingUrl ? (
        <BookingWidget url={data.bookingUrl} />
      ) : (
        <Card hover={false}>
          <BookingForm
            client:visible
            submitLabel="Отправить"
            successMessage="Спасибо! Мы скоро свяжемся с вами."
            phone={data.phone}
          />
        </Card>
      )}
    </div>
  </Container>
</Section>
