---
import Container from "@sitegen/shared-ui/components/Container.astro";
import Section from "@sitegen/shared-ui/components/Section.astro";
import { initials } from "@sitegen/shared-ui/utils/initials.ts";
import type { SiteData } from "@sitegen/shared-ui/types.ts";

interface Props {
  variant: number;
  data: SiteData;
}
const { data } = Astro.props;
---

<Section id="team">
  <Container>
    <h2 class="font-[var(--font-heading)] text-3xl font-bold text-[var(--color-text)] text-center mb-10">Наши мастера</h2>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {data.team.map((member) => (
        <div class="group relative overflow-hidden rounded-[var(--radius-lg)] aspect-[3/4] shadow-[var(--shadow-card)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[var(--shadow-elevated)]">
          {member.photo ? (
            <img
              src={member.photo}
              alt={member.name}
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
          ) : (
            <div class="flex h-full w-full items-center justify-center bg-[var(--color-surface)] text-4xl font-bold text-[var(--color-primary)]">
              {initials(member.name)}
            </div>
          )}
          <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/10 to-transparent"></div>
          <div class="absolute inset-x-0 bottom-0 p-4">
            <p class="font-[var(--font-heading)] text-lg font-bold text-white">{member.name}</p>
            {member.role && <p class="text-sm text-white/80">{member.role}</p>}
          </div>
        </div>
      ))}
    </div>
  </Container>
</Section>
