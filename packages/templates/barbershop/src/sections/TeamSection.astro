---
import Container from "@sitegen/shared-ui/components/Container.astro";
import SkeletonImg from "@sitegen/shared-ui/components/SkeletonImg.astro";
import BrassRule from "../components/BrassRule.astro";
import { initials } from "@sitegen/shared-ui/utils/initials.ts";
import type { SiteData } from "@sitegen/shared-ui/types.ts";

interface Props {
  data: SiteData;
}
const { data } = Astro.props;
---

<section id="team" data-reveal class="relative bg-[var(--color-bg)] py-16 sm:py-24">
  <Container>
    <div class="text-center mb-12">
      <BrassRule class="mx-auto mb-5 max-w-[100px]" />
      <h2 class="font-[var(--font-heading)] uppercase text-[clamp(2rem,5vw,3.5rem)] leading-none text-[var(--color-text)]">
        Мастера
      </h2>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-10">
      {data.team.map((member) => (
        <div class="text-center">
          {member.photo ? (
            <SkeletonImg src={member.photo} alt={member.name} class="mx-auto h-40 w-40 rounded-full ring-2 ring-[var(--color-border)]" />
          ) : (
            <div class="mx-auto flex h-40 w-40 items-center justify-center rounded-full bg-[var(--color-surface)] text-3xl font-[var(--font-heading)] text-[var(--color-primary)] ring-2 ring-[var(--color-border)]">
              {initials(member.name)}
            </div>
          )}
          <p class="mt-5 font-[var(--font-heading)] uppercase text-lg text-[var(--color-text)]">{member.name}</p>
          {member.role && <p class="text-sm text-[var(--color-primary)]">{member.role}</p>}
          {member.bio && <p class="mt-2 text-sm text-[var(--color-text-muted)]">{member.bio}</p>}
        </div>
      ))}
    </div>
  </Container>
</section>
