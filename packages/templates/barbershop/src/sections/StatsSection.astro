---
import Container from "@sitegen/shared-ui/components/Container.astro";
import Section from "@sitegen/shared-ui/components/Section.astro";
import type { SiteData } from "@sitegen/shared-ui/types.ts";

interface Props {
  variant: number;
  data: SiteData;
}
const { data } = Astro.props;
---

<Section id="stats" surface="surface" spacing="md">
  <Container>
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-8 text-center">
      {data.stats.map((stat) => (
        <div>
          <p class="font-[var(--font-heading)] text-4xl sm:text-5xl font-bold text-[var(--color-primary)]">{stat.value}</p>
          <p class="mt-2 text-xs sm:text-sm uppercase tracking-wide text-[var(--color-text-muted)]">{stat.label}</p>
        </div>
      ))}
    </div>
  </Container>
</Section>
