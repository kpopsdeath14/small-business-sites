---
import Container from "@sitegen/shared-ui/components/Container.astro";
import Section from "@sitegen/shared-ui/components/Section.astro";
import Button from "@sitegen/shared-ui/components/Button.astro";
import Card from "@sitegen/shared-ui/components/Card.astro";
import type { SiteData } from "@sitegen/shared-ui/types.ts";

interface Props {
  data: SiteData;
}
const { data } = Astro.props;
---

<Section id="services" surface="surface">
  <Container>
    <h2 class="font-[var(--font-heading)] text-3xl font-bold text-[var(--color-text)] text-center">Услуги</h2>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-10">
      {data.items.map((item) => (
        <Card>
          <div class="flex justify-between items-start gap-2">
            <p class="font-medium text-[var(--color-text)]">{item.name}</p>
            {item.price && <span class="text-sm font-semibold text-[var(--color-primary)] whitespace-nowrap">{item.price}</span>}
          </div>
          {item.description && <p class="mt-2 text-sm text-[var(--color-text-muted)]">{item.description}</p>}
        </Card>
      ))}
    </div>
    <div class="text-center mt-10">
      <Button href="#contact" size="lg">Записаться</Button>
    </div>
  </Container>
</Section>
