---
import FooterBase from "@sitegen/shared-ui/components/FooterBase.astro";
import type { SiteData } from "@sitegen/shared-ui/types.ts";

interface Props {
  data: SiteData;
}
const { data } = Astro.props;
const hoursSummary = data.workingHours ? Object.values(data.workingHours)[0] : undefined;
---

<FooterBase
  siteName={data.name}
  address={data.address}
  phone={data.phone}
  hoursSummary={hoursSummary}
  socialLinks={data.socialLinks}
/>
