---
/** A short ornamental double-rule with a diamond centerpiece — classic barbershop signage motif,
 *  recolors with the token set via currentColor. */
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<div class:list={["flex items-center gap-3 text-[var(--color-primary)]", className]} aria-hidden="true">
  <span class="h-px flex-1 bg-current opacity-70"></span>
  <span class="h-1.5 w-1.5 rotate-45 bg-current"></span>
  <span class="h-px flex-1 bg-current opacity-70"></span>
</div>
