---
import Container from "@sitegen/shared-ui/components/Container.astro";
import Section from "@sitegen/shared-ui/components/Section.astro";
import type { SiteData } from "@sitegen/shared-ui/types.ts";

interface Props {
  variant: number;
  data: SiteData;
}
const { data } = Astro.props;
---

<Section id="highlights">
  <Container>
    <h2 class="font-[var(--font-heading)] text-3xl font-bold text-[var(--color-text)] text-center mb-12">Топ-процедуры</h2>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {data.highlights.map((item) => (
        <div class="text-center">
          <div class="relative aspect-[4/5] overflow-hidden rounded-[var(--radius-lg)] shadow-[var(--shadow-card)]">
            {item.photo ? (
              <img src={item.photo} alt={item.name} class="h-full w-full object-cover" />
            ) : (
              <div class="h-full w-full bg-[var(--color-surface)]" />
            )}
          </div>
          <p class="mt-4 font-[var(--font-heading)] text-lg font-semibold text-[var(--color-text)]">{item.name}</p>
          {item.description && <p class="mt-1 text-sm text-[var(--color-text-muted)]">{item.description}</p>}
          {item.price && <p class="mt-2 font-semibold text-[var(--color-primary)]">{item.price}</p>}
        </div>
      ))}
    </div>
  </Container>
</Section>
