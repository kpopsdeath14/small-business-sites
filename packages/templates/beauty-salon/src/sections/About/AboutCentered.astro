---
import Container from "@sitegen/shared-ui/components/Container.astro";
import SalonSection from "../../components/SalonSection.astro";
import type { SiteData } from "@sitegen/shared-ui/types.ts";

interface Props {
  data: SiteData;
}
const { data } = Astro.props;
---

<SalonSection id="about">
  <Container narrow>
    <div class="text-center" data-reveal>
      <!-- Ornament: hairline — diamond — hairline, the quietest possible divider. -->
      <div class="flex items-center justify-center gap-4 mb-8" aria-hidden="true">
        <span class="h-px w-12 bg-[var(--color-border)]"></span>
        <span class="w-1.5 h-1.5 rotate-45 bg-[var(--color-primary)]"></span>
        <span class="h-px w-12 bg-[var(--color-border)]"></span>
      </div>
      <p class="eyebrow mb-6">О нас</p>
      <h2 class="font-[var(--font-heading)] text-3xl sm:text-4xl font-medium leading-[1.15] text-[var(--color-text)] max-w-2xl mx-auto">
        {data.about.heading}
      </h2>
      <p class="mt-8 text-[var(--color-text-muted)] leading-[1.95] max-w-xl mx-auto font-light">
        {data.about.body}
      </p>
    </div>
  </Container>
</SalonSection>