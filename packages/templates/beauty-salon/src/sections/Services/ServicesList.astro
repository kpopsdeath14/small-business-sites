---
import Container from "@sitegen/shared-ui/components/Container.astro";
import SalonSection from "../../components/SalonSection.astro";
import SalonButton from "../../components/SalonButton.astro";
import type { SiteData } from "@sitegen/shared-ui/types.ts";

interface Props {
  data: SiteData;
}
const { data } = Astro.props;

// Group services by category, preserving first-appearance order — renders as a
// fine-dining-style price menu with dotted leaders. The single most scannable,
// most conversion-friendly layout for a salon's service list.
const categories: { name: string; items: typeof data.items }[] = [];
for (const item of data.items) {
  const key = item.category?.trim() || "Услуги";
  let group = categories.find((c) => c.name === key);
  if (!group) {
    group = { name: key, items: [] };
    categories.push(group);
  }
  group.items.push(item);
}
---

<SalonSection id="services">
  <Container>
    <div class="text-center mb-14" data-reveal>
      <p class="eyebrow mb-5">Прайс</p>
      <h2 class="font-[var(--font-heading)] text-3xl sm:text-4xl font-medium text-[var(--color-text)]">Услуги и цены</h2>
      {data.servicesNote && <p class="mt-4 text-sm text-[var(--color-text-muted)]">{data.servicesNote}</p>}
    </div>

    <!-- Two-column menu on wide screens; single column keeps long names readable on mobile. -->
    <div class="grid lg:grid-cols-2 gap-x-16 gap-y-12 max-w-5xl mx-auto" data-reveal-stagger="90">
      {
        categories.map((group) => (
          <div data-reveal>
            <h3 class="flex items-baseline gap-4 font-[var(--font-heading)] text-xl font-medium text-[var(--color-text)] pb-3 border-b border-[var(--color-border)]">
              {group.name}
            </h3>
            <ul class="mt-2 divide-y divide-[var(--color-border)]/60">
              {group.items.map((item) => (
                <li class="menu-row py-3.5">
                  <span class="text-[15px] text-[var(--color-text)]">{item.name}</span>
                  <span class="menu-dots" aria-hidden="true"></span>
                  {item.price && (
                    <span class="shrink-0 font-[var(--font-heading)] text-lg font-medium text-[var(--color-primary)] tabular-nums whitespace-nowrap">
                      {item.price}
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="text-center mt-14" data-reveal>
      <SalonButton href="#booking" size="lg">Записаться</SalonButton>
    </div>
  </Container>
</SalonSection>