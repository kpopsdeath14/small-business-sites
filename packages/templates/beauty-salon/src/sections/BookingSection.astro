---
import Container from "@sitegen/shared-ui/components/Container.astro";
import SalonSection from "../components/SalonSection.astro";
import BookingWidget from "../components/BookingWidgetLux.astro";
import type { SiteData } from "@sitegen/shared-ui/types.ts";

interface Props {
  variant: number;
  data: SiteData;
}
const { data } = Astro.props;
const hoursSummary = Object.entries(data.workingHours ?? {})
  .map(([days, hours]) => `${days}: ${hours}`)
  .join(" · ");
const tel = data.phone ? `tel:${data.phone.replace(/[^+\d]/g, "")}` : undefined;
const social = data.socialLinks ?? {};
// The salon's own booking system is embedded here. Never a home-made form: it would
// need a backend to go anywhere, and without one it silently drops enquiries. Where a
// client has no booking system yet we hold the space visibly instead of filling it.
const channels = [
  social.telegram && { href: social.telegram, label: "Telegram" },
  social.whatsapp && { href: social.whatsapp, label: "WhatsApp" },
].filter(Boolean) as { href: string; label: string }[];
---

<!-- The page's conversion anchor: always the charcoal room, regardless of palette.
     Split layout — persuasive copy + direct phone line on the left, the form on the right —
     so a visitor who won't fill forms still sees the number first. -->
<SalonSection id="booking" surface="noir" spacing="xl">
  <Container>
    <div class="grid lg:grid-cols-2 gap-14 lg:gap-20 items-center">
      <!-- Copy column -->
      <div data-reveal>
        <p class="eyebrow !text-[#C8A96E] mb-6">Онлайн-запись</p>
        <h2 class="font-[var(--font-heading)] text-3xl sm:text-4xl lg:text-[2.9rem] font-medium leading-[1.1] text-[#F4EEE2] max-w-md">
          Запишитесь на визит
        </h2>
        <div class="mt-7 h-px w-16 bg-[#C8A96E]" aria-hidden="true"></div>
        <p class="mt-7 text-[#A79C89] leading-[1.9] max-w-md font-light">
          Выберите удобный способ — онлайн-запись, мессенджер или звонок. Ответим и подберём время.
        </p>

        {
          data.phone && (
            <div class="mt-10">
              <p class="text-[10px] uppercase tracking-[0.28em] text-[#A79C89]">Или позвоните нам</p>
              <a
                href={`tel:${data.phone.replace(/[^+\d]/g, "")}`}
                class="mt-2 inline-block font-[var(--font-heading)] text-3xl sm:text-4xl font-medium text-[#F4EEE2] hover:text-[#C8A96E] transition-colors"
              >
                {data.phone}
              </a>
            </div>
          )
        }
        {hoursSummary && <p class="mt-5 text-sm text-[#A79C89]">{hoursSummary}</p>}
      </div>

      <!-- Booking column: the salon's live widget, or space held for it. -->
      <div data-reveal>
        {
          data.bookingUrl ? (
            <BookingWidget url={data.bookingUrl} />
          ) : (
            <div class="flex min-h-[560px] flex-col items-center justify-center border border-dashed border-white/25 bg-white/[0.03] backdrop-blur-sm p-10 sm:p-12 text-center">
              <p class="text-[10px] uppercase tracking-[0.28em] text-[#C8A96E]">Онлайн-запись</p>
              <p class="mt-5 font-[var(--font-heading)] text-2xl font-medium text-[#F4EEE2]">
                Место под виджет записи
              </p>
              <p class="mt-4 text-sm text-[#A79C89] leading-relaxed max-w-sm mx-auto">
                Сюда встроится ваша онлайн-запись — Dikidi, YClients или другая система.
                Пришлите ссылку, и клиенты будут выбирать время прямо на сайте.
              </p>
              <div class="mt-8 flex flex-wrap justify-center gap-3">
                {
                  channels.map((c) => (
                    <a
                      href={c.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="px-6 py-3.5 text-[11px] font-semibold uppercase tracking-[0.22em] border border-white/25 text-[#F4EEE2] hover:bg-white/10 hover:border-white/50 transition-all duration-300"
                    >
                      {c.label}
                    </a>
                  ))
                }
                {
                  tel && (
                    <a
                      href={tel}
                      class="px-6 py-3.5 text-[11px] font-semibold uppercase tracking-[0.22em] border border-white/25 text-[#F4EEE2] hover:bg-white/10 hover:border-white/50 transition-all duration-300"
                    >
                      Позвонить
                    </a>
                  )
                }
              </div>
            </div>
          )
        }
      </div>
    </div>
  </Container>
</SalonSection>