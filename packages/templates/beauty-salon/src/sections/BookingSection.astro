---
import Container from "@sitegen/shared-ui/components/Container.astro";
import SalonSection from "../components/SalonSection.astro";
import type { SiteData } from "@sitegen/shared-ui/types.ts";

interface Props {
  variant: number;
  data: SiteData;
}
const { data } = Astro.props;
const hoursSummary = Object.entries(data.workingHours ?? {})
  .map(([days, hours]) => `${days}: ${hours}`)
  .join(" · ");
// Booking stays link-only by design: one tap opens the salon's own booking system
// or a messenger — no third-party iframe slowing the page down or breaking in layout.
// Order: booking system first (if the salon has one), then every social channel, then the phone line.
const SOCIAL_LABELS: Record<string, string> = {
  instagram: "Instagram",
  vk: "VK",
  telegram: "Telegram",
  whatsapp: "WhatsApp",
  facebook: "Facebook",
  youtube: "YouTube",
};
const tel = data.phone ? `tel:${data.phone.replace(/[^+\d]/g, "")}` : undefined;
const channels = Object.entries(data.socialLinks ?? {})
  .filter(([, url]) => Boolean(url))
  .map(([key, url]) => ({ href: url, label: SOCIAL_LABELS[key.toLowerCase()] ?? key }));
const outlineBtn =
  "px-6 py-3.5 text-[11px] font-semibold uppercase tracking-[0.22em] border border-white/25 text-[#F4EEE2] hover:bg-white/10 hover:border-white/50 transition-all duration-300";
---

<!-- The page's conversion anchor: always the charcoal room, regardless of palette.
     Split layout — persuasive copy + direct phone line on the left, the booking
     links on the right — so a visitor picks their channel in one tap. -->
<SalonSection id="booking" surface="noir" spacing="xl">
  <Container>
    <div class="grid lg:grid-cols-2 gap-14 lg:gap-20 items-center">
      <!-- Copy column -->
      <div data-reveal>
        <p class="eyebrow !text-[#C8A96E] mb-6">Онлайн-запись</p>
        <h2 class="font-[var(--font-heading)] text-3xl sm:text-4xl lg:text-[2.9rem] font-medium leading-[1.1] text-[#F4EEE2] max-w-md">
          Запишитесь на визит
        </h2>
        <div class="mt-7 h-px w-16 bg-[#C8A96E]" aria-hidden="true"></div>
        <p class="mt-7 text-[#A79C89] leading-[1.9] max-w-md font-light">
          Выберите удобный способ — онлайн-запись, мессенджер или звонок. Ответим и подберём время.
        </p>

        {
          data.phone && (
            <div class="mt-10">
              <p class="text-[10px] uppercase tracking-[0.28em] text-[#A79C89]">Или позвоните нам</p>
              <a
                href={`tel:${data.phone.replace(/[^+\d]/g, "")}`}
                class="mt-2 inline-block font-[var(--font-heading)] text-3xl sm:text-4xl font-medium text-[#F4EEE2] hover:text-[#C8A96E] transition-colors"
              >
                {data.phone}
              </a>
            </div>
          )
        }
        {hoursSummary && <p class="mt-5 text-sm text-[#A79C89]">{hoursSummary}</p>}
      </div>

      <!-- Booking column: plain links to every way to reach the salon. -->
      <div data-reveal>
        <div class="border border-white/10 bg-white/[0.03] backdrop-blur-sm p-8 sm:p-10 text-center">
          <p class="text-[10px] uppercase tracking-[0.28em] text-[#C8A96E]">Выберите способ записи</p>

          <div class="mt-8 flex flex-col items-stretch gap-3 max-w-xs mx-auto">
            {
              data.bookingUrl && (
                <a
                  href={data.bookingUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="px-6 py-3.5 text-[11px] font-semibold uppercase tracking-[0.22em] bg-[#C8A96E] text-[#171310] hover:bg-[#d9bd83] transition-colors duration-300"
                >
                  Онлайн-запись
                </a>
              )
            }
            {channels.map((c) => (
              <a href={c.href} target="_blank" rel="noopener noreferrer" class={outlineBtn}>
                {c.label}
              </a>
            ))}
            {tel && (
              <a href={tel} class={outlineBtn}>
                Позвонить
              </a>
            )}
          </div>
        </div>
      </div>
    </div>
  </Container>
</SalonSection>