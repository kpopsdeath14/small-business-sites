---
import Container from "@sitegen/shared-ui/components/Container.astro";
import SalonSection from "../../components/SalonSection.astro";
import Lightbox from "@sitegen/shared-ui/components/Lightbox.tsx";
import type { SiteData } from "@sitegen/shared-ui/types.ts";

interface Props {
  data: SiteData;
}
const { data } = Astro.props;
---

<SalonSection id="gallery" spacing="md">
  <Container>
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-5 mb-12" data-reveal>
      <div>
        <p class="eyebrow mb-5">Портфолио</p>
        <h2 class="font-[var(--font-heading)] text-3xl sm:text-4xl font-medium text-[var(--color-text)]">Наши работы</h2>
      </div>
      <p class="text-sm text-[var(--color-text-muted)] max-w-xs leading-relaxed">
        Нажмите на фото, чтобы рассмотреть детали
      </p>
    </div>
  </Container>

  <!-- Full-bleed strip: photos run edge-to-edge with hairline gaps — the most
       "gallery wall" of the three variants. -->
  <div data-reveal>
    <Lightbox
      client:visible
      photos={data.gallery}
      gridClassName="grid grid-cols-2 md:grid-cols-4 gap-1"
      itemClassName="aspect-square"
      imgClassName="h-full w-full object-cover"
    />
  </div>
</SalonSection>