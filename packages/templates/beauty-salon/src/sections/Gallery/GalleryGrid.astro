---
import Container from "@sitegen/shared-ui/components/Container.astro";
import SalonSection from "../../components/SalonSection.astro";
import Lightbox from "@sitegen/shared-ui/components/Lightbox.tsx";
import type { SiteData } from "@sitegen/shared-ui/types.ts";

interface Props {
  data: SiteData;
}
const { data } = Astro.props;
---

<SalonSection id="gallery" surface="surface">
  <Container>
    <div class="text-center mb-14" data-reveal>
      <p class="eyebrow mb-5">Портфолио</p>
      <h2 class="font-[var(--font-heading)] text-3xl sm:text-4xl font-medium text-[var(--color-text)]">Наши работы</h2>
    </div>

    <!-- The island itself can't carry data-reveal (Preact replaces its subtree on hydration),
         so the reveal wrapper sits around it. -->
    <div data-reveal>
      <Lightbox
        client:visible
        photos={data.gallery}
        gridClassName="grid grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4"
        itemClassName="aspect-[4/5]"
        imgClassName="h-full w-full object-cover"
      />
    </div>
  </Container>
</SalonSection>