---
import Container from "@sitegen/shared-ui/components/Container.astro";
import Button from "@sitegen/shared-ui/components/Button.astro";
import type { SiteData } from "@sitegen/shared-ui/types.ts";

interface Props {
  data: SiteData;
}
const { data } = Astro.props;
const bgPhoto = data.gallery[0]?.src;
---

<section id="hero" class="relative flex items-center justify-center min-h-[80vh] text-center overflow-hidden">
  {bgPhoto && <img src={bgPhoto} alt="" class="absolute inset-0 w-full h-full object-cover" />}
  <div class="absolute inset-0 bg-black/50"></div>
  <Container class="relative z-10 py-24">
    <h1 class="font-[var(--font-heading)] text-4xl sm:text-6xl font-bold text-white">{data.hero.heading}</h1>
    <p class="mt-4 text-lg text-white/90 max-w-xl mx-auto">{data.hero.subheading}</p>
    <div class="mt-8">
      <Button href="#contact" size="lg">{data.hero.ctaLabel}</Button>
    </div>
  </Container>
</section>
