---
import Container from "@sitegen/shared-ui/components/Container.astro";
import Button from "@sitegen/shared-ui/components/Button.astro";
import type { SiteData } from "@sitegen/shared-ui/types.ts";

interface Props {
  data: SiteData;
}
const { data } = Astro.props;
const photos = data.gallery.slice(0, 2);
---

<section id="hero" class="bg-[var(--color-bg)]">
  <Container class="grid md:grid-cols-2 gap-10 items-center py-20">
    <div>
      <h1 class="font-[var(--font-heading)] text-4xl sm:text-5xl font-bold text-[var(--color-text)]">{data.hero.heading}</h1>
      <p class="mt-4 text-lg text-[var(--color-text-muted)]">{data.hero.subheading}</p>
      <div class="mt-8">
        <Button href="#contact" size="lg">{data.hero.ctaLabel}</Button>
      </div>
    </div>
    <div class="grid grid-cols-2 gap-4">
      {photos.length > 0 ? (
        photos.map((p) => (
          <img
            src={p.src}
            alt={p.alt}
            class="rounded-[var(--radius-lg)] shadow-[var(--shadow-card)] object-cover aspect-[3/4] w-full"
          />
        ))
      ) : (
        <div class="col-span-2 aspect-video rounded-[var(--radius-lg)] bg-[var(--color-surface)]" />
      )}
    </div>
  </Container>
</section>
