---
import Container from "@sitegen/shared-ui/components/Container.astro";
import SalonButton from "../../components/SalonButton.astro";
import SkeletonImg from "@sitegen/shared-ui/components/SkeletonImg.astro";
import type { SiteData } from "@sitegen/shared-ui/types.ts";

interface Props {
  data: SiteData;
}
const { data } = Astro.props;
const heroPhoto = data.heroPhoto;
const bgPhoto = data.gallery[0]?.src;
const ratingStat = data.stats.find((s) => /рейтинг|rating/i.test(s.label));
---

<section id="hero" class="relative h-[100svh] min-h-[560px] w-full overflow-hidden">
  {
    heroPhoto ? (
      <SkeletonImg src={heroPhoto} alt="" class="absolute inset-0 w-full h-full ken-burns [&_img]:object-[center_30%]" loading="eager" />
    ) : (
      bgPhoto && (
        <>
          <img src={bgPhoto} alt="" aria-hidden="true" class="absolute inset-0 w-full h-full object-cover scale-110 blur-2xl brightness-75" />
          <SkeletonImg src={bgPhoto} alt="" class="absolute inset-0 w-full h-full" fit="contain" loading="eager" />
        </>
      )
    )
  }
  <!-- Editorial wash: heavier at the bottom where the type sits, so the serif stays legible
       over any photo while the upper half keeps its air. -->
  <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/35 to-black/10"></div>

  {
    ratingStat && (
      <div class="hero-enter hidden sm:flex absolute top-24 right-6 lg:right-10 z-20 items-center gap-2.5 text-white/85 text-xs tracking-[0.2em] uppercase" style="--enter-delay:0.9s">
        <span class="text-[#E3D2AF] text-base leading-none">★</span>
        {ratingStat.value} · {ratingStat.label}
      </div>
    )
  }

  <div class="relative z-10 flex h-full items-end">
    <Container class="pb-16 sm:pb-24">
      <p class="hero-enter eyebrow !text-white/70 mb-6" style="--enter-delay:0.1s">Салон красоты</p>
      <!-- The oversized editorial headline: italic accent comes free via the global h1 em rule
           when the generated copy includes one; otherwise the plain serif carries it. -->
      <h1
        class="hero-enter font-[var(--font-heading)] font-medium leading-[1.02] text-white text-[clamp(3rem,9vw,7rem)] max-w-5xl [text-shadow:0_2px_40px_rgba(0,0,0,0.4)]"
        style="--enter-delay:0.25s"
      >
        {data.hero.heading}
      </h1>
      <div class="mt-8 flex flex-col sm:flex-row sm:items-end gap-8 sm:gap-14">
        <p class="hero-enter max-w-md text-base sm:text-lg text-white/85 leading-relaxed font-light" style="--enter-delay:0.45s">
          {data.hero.subheading}
        </p>
        <div class="hero-enter flex flex-wrap gap-4" style="--enter-delay:0.6s">
          <SalonButton href="#booking" size="lg">{data.hero.ctaLabel}</SalonButton>
        </div>
      </div>
    </Container>
  </div>

  <!-- Scroll hint -->
  <a
    href="#stats"
    aria-label="Листайте вниз"
    class="drift-down absolute bottom-6 right-6 sm:right-10 z-10 text-white/70 hover:text-white transition-colors"
  >
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 4v16m0 0l-6-6m6 6l6-6"></path>
    </svg>
  </a>
</section>