---
import Container from "@sitegen/shared-ui/components/Container.astro";
import Section from "@sitegen/shared-ui/components/Section.astro";
import type { SiteData } from "@sitegen/shared-ui/types.ts";

interface Props {
  variant: number;
  data: SiteData;
}
const { data } = Astro.props;
---

<Section id="stats" spacing="md">
  <Container>
    <div class="flex flex-wrap justify-center divide-x divide-[var(--color-border)]">
      {data.stats.map((stat) => (
        <div class="px-8 py-4 text-center">
          <p class="font-[var(--font-heading)] text-3xl sm:text-4xl font-bold text-[var(--color-primary)]">{stat.value}</p>
          <p class="mt-1 text-xs uppercase tracking-widest text-[var(--color-text-muted)]">{stat.label}</p>
        </div>
      ))}
    </div>
  </Container>
</Section>
