---
/**
 * L'ATELIER section wrapper. Local to this template (the shared Section.astro paints
 * colored blur-blob backgrounds that fight the editorial look). Adds a "noir" surface:
 * a fixed charcoal room used for booking/footer anchors, consistent across all palettes.
 *
 * Carries its own copy of the global scroll-reveal system (same fail-open pattern as
 * shared-ui's Section.astro): hidden states only apply once JS opts in via `reveal-ready`,
 * so content stays visible with zero JS.
 */
interface Props {
  id?: string;
  class?: string;
  surface?: "base" | "surface" | "noir";
  spacing?: "md" | "lg" | "xl";
}
const { id, class: className = "", surface = "base", spacing = "lg" } = Astro.props;

const surfaceClass =
  surface === "surface"
    ? "bg-[var(--color-surface)]"
    : surface === "noir"
      ? "salon-noir text-[#F4EEE2]"
      : "bg-[var(--color-bg)]";
const spacingClass = spacing === "md" ? "py-14 sm:py-20" : spacing === "xl" ? "py-24 sm:py-36" : "py-20 sm:py-28";
---

<section id={id} data-reveal class:list={["relative overflow-hidden", surfaceClass, spacingClass, className]}>
  <slot />
</section>

<style is:global>
  /*
    Scroll-reveal system — GLOBAL on purpose (same rationale as shared-ui Section.astro):
    the `reveal-ready` class lands on <html> from JS, which never carries a component cid,
    so scoped rules would never match. Fails open: no JS → everything visible.
  */
  .reveal-ready [data-reveal] {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.9s cubic-bezier(0.22, 1, 0.36, 1), transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: var(--reveal-delay, 0ms);
  }
  .reveal-ready [data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .reveal-ready [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  if ("IntersectionObserver" in window) {
    document.documentElement.classList.add("reveal-ready");

    // Stagger: inside a [data-reveal-stagger] container, direct [data-reveal] children get an
    // incremental delay so grids cascade in instead of popping as one block.
    document.querySelectorAll<HTMLElement>("[data-reveal-stagger]").forEach((container) => {
      const step = parseInt(container.dataset.revealStagger || "", 10) || 80;
      const items = Array.from(container.querySelectorAll<HTMLElement>(":scope [data-reveal]"));
      items.forEach((el, i) => el.style.setProperty("--reveal-delay", `${Math.min(i * step, 600)}ms`));
    });

    const revealObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            revealObserver.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.12, rootMargin: "0px 0px -60px 0px" }
    );
    document.querySelectorAll("[data-reveal]").forEach((el) => revealObserver.observe(el));

    // Safety net: force anything still hidden visible after a grace period rather than
    // leaving it hidden indefinitely (e.g. very fast loads where intersection already happened).
    setTimeout(() => {
      document.querySelectorAll("[data-reveal]:not(.is-visible)").forEach((el) => el.classList.add("is-visible"));
    }, 1500);
  }
</script>