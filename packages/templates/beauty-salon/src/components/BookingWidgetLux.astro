---
// L'ATELIER booking embed: frames the salon's real booking system (YClients / Dikidi / …)
// in the template's design language — hairline header with pulsing status dots, shimmer
// skeleton behind the iframe while it loads, and an always-visible escape link for systems
// that block iframing. Token-driven, so every palette dresses it natively.
interface Props {
  url: string;
  title?: string;
  heightClass?: string;
  class?: string;
}
const { url, title = "Онлайн-запись", heightClass = "h-[720px]", class: className = "" } = Astro.props;
---

<div
  data-booking-widget
  class={`overflow-hidden rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[var(--color-surface)] shadow-[var(--shadow-card)] ${className}`}
>
  <!-- Header strip -->
  <div class="flex items-center justify-between gap-4 px-5 py-3 border-b border-[var(--color-border)]">
    <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-[var(--color-text-muted)]">{title}</p>
    <span class="bw-dots" aria-hidden="true"><i></i><i></i><i></i></span>
  </div>

  <!-- Widget body: loading shimmer sits behind the iframe -->
  <div class="relative">
    <div class="absolute inset-0 z-0 grid place-items-center bw-skeleton" aria-hidden="true">
      <span
        class="inline-block h-8 w-8 rounded-full border-2 border-[var(--color-primary)] opacity-60"
        style="animation: bw-spin 0.8s linear infinite; -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 2px), #000 0); mask: radial-gradient(farthest-side, transparent calc(100% - 2px), #000 0);"
      ></span>
    </div>
    <iframe src={url} class={`relative z-10 w-full ${heightClass} border-0 block`} loading="lazy" title={title}></iframe>
  </div>

  <!-- Fallback: some systems disallow iframing — always give visitors a way out -->
  <div class="border-t border-[var(--color-border)] px-5 py-3 text-center">
    <a
      href={url}
      target="_blank"
      rel="noopener noreferrer"
      class="text-sm font-medium text-[var(--color-primary)] underline decoration-dotted underline-offset-4 hover:opacity-80 transition-opacity duration-200"
    >
      Не открывается? Открыть форму записи в новой вкладке →
    </a>
  </div>
</div>

<style>
  .bw-skeleton {
    background: linear-gradient(
      110deg,
      var(--color-surface) 30%,
      color-mix(in srgb, var(--color-primary) 7%, var(--color-surface)) 50%,
      var(--color-surface) 70%
    );
    background-size: 200% 100%;
    animation: bw-shimmer 1.6s ease-in-out infinite;
  }
  .bw-dots {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .bw-dots i {
    width: 5px;
    height: 5px;
    border-radius: 9999px;
    background: var(--color-primary);
    opacity: 0.25;
    animation: bw-pulse 1.4s ease-in-out infinite;
  }
  .bw-dots i:nth-child(2) {
    animation-delay: 0.2s;
  }
  .bw-dots i:nth-child(3) {
    animation-delay: 0.4s;
  }
  @keyframes bw-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes bw-shimmer {
    to {
      background-position: -200% 0;
    }
  }
  @keyframes bw-pulse {
    0%,
    100% {
      opacity: 0.25;
    }
    50% {
      opacity: 0.9;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bw-skeleton,
    .bw-dots i {
      animation: none !important;
    }
  }
</style>
