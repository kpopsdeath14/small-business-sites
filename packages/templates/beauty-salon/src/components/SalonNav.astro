---
/**
 * L'ATELIER navigation. Fixed over the hero: transparent with ivory text while the
 * hero photo fills the screen, then condenses into a solid palette bar on scroll.
 * Desktop links are letterspaced micro-caps with a growing underline; mobile gets a
 * full-screen atelier menu with oversized serif links.
 */
interface NavLink {
  label: string;
  href: string;
  primary?: boolean;
}
interface Props {
  siteName: string;
  links: NavLink[];
  phone?: string;
  /** True when the hero is full-bleed photography (nav needs light text + dark scrim);
   *  false when the hero is the split layout, whose light palette panel sits behind the
   *  wordmark and needs the palette's own text colour instead. */
  onPhoto?: boolean;
}
const { siteName, links, phone, onPhoto = false } = Astro.props;
---

<header id="salon-nav" class:list={["fixed inset-x-0 top-0 z-50", onPhoto && "on-photo"]}>
  <!-- relative z-10 keeps the wordmark + burger paintable above the fullscreen overlay
       that follows (same stacking context), so the X button stays tappable while open. -->
  <div class="relative z-10 mx-auto flex max-w-7xl items-center justify-between px-5 sm:px-8 h-[4.5rem] lg:h-20">
    <!-- Wordmark: serif with a hairline rule — reads like a fashion-house logotype. -->
    <a href="#hero" class="nav-fg flex items-baseline gap-3 group">
      <span class="font-[var(--font-heading)] text-xl lg:text-2xl font-semibold tracking-wide">{siteName}</span>
      <span class="hidden sm:block h-px w-8 bg-current opacity-40 transition-all duration-500 group-hover:w-12 group-hover:opacity-80"></span>
    </a>

    <nav class="hidden lg:flex items-center gap-8">
      {
        links.map((link) =>
          link.primary ? (
            <a
              href={link.href}
              class="nav-fg border border-current px-5 py-2.5 text-[11px] font-semibold uppercase tracking-[0.22em] transition-all duration-300 hover:bg-white hover:text-black hover:border-white"
            >
              {link.label}
            </a>
          ) : (
            <a href={link.href} class="nav-fg link-line text-[11px] font-semibold uppercase tracking-[0.22em] opacity-80 hover:opacity-100 transition-opacity">
              {link.label}
            </a>
          )
        )
      }
      {
        phone && (
          <a
            href={`tel:${phone.replace(/[^+\d]/g, "")}`}
            class="nav-fg text-[13px] font-semibold tracking-wide opacity-90 hover:opacity-100 transition-opacity"
          >
            {phone}
          </a>
        )
      }
    </nav>

    <!-- Burger: two hairlines that cross into an X when the menu opens. -->
    <button
      type="button"
      id="nav-burger"
      class="nav-fg lg:hidden relative w-10 h-10 -mr-2 flex items-center justify-center"
      aria-label="Меню"
      aria-expanded="false"
      aria-controls="nav-overlay"
    >
      <span class="burger-line block w-6 h-px bg-current transition-transform duration-300"></span>
      <span class="burger-line block w-6 h-px bg-current mt-[7px] transition-transform duration-300"></span>
    </button>
  </div>

</header>

  <!--
    Full-screen mobile menu: oversized serif links stagger in over an opaque panel.

    Deliberately a SIBLING of <header>, not a child: when the page is scrolled the header
    carries `backdrop-filter`, and any filtered/transformed ancestor becomes the containing
    block for `position: fixed` descendants — the overlay would then size itself to the
    72px header bar instead of the viewport and look clipped. As a sibling it always spans
    the real viewport. z-[45]: above the mobile CTA bar (z-40), below the header (z-50),
    so the burger/X stays visible and tappable on top of the open menu.
  -->
  <div
    id="nav-overlay"
    class="lg:hidden fixed inset-0 z-[45] flex flex-col bg-[var(--color-bg)] opacity-0 pointer-events-none transition-opacity duration-300"
  >
    <div class="flex-1 flex flex-col justify-center px-8 pt-20 pb-10 overflow-y-auto">
      <nav class="flex flex-col gap-1">
        {
          links.map((link, i) => (
            <a
              href={link.href}
              class="overlay-link font-[var(--font-heading)] text-4xl py-3 text-[var(--color-text)] border-b border-[var(--color-border)] flex items-baseline justify-between"
              style={`--i:${i}`}
            >
              <span>{link.label}</span>
              <span class="text-xs font-body tracking-[0.3em] text-[var(--color-primary)]">0{i + 1}</span>
            </a>
          ))
        }
      </nav>
      {
        phone && (
          <a href={`tel:${phone.replace(/[^+\d]/g, "")}`} class="overlay-link mt-10 text-lg font-semibold text-[var(--color-primary)]" style="--i:9">
            {phone}
          </a>
        )
      }
    </div>
  </div>

<style>
  /* Transparent-over-hero state. Text follows the palette (--color-text), NOT hardcoded
     white: on light palettes (ivory, porcelain, blush…) white nav text was invisible over
     the light hero. A soft scrim of the page's own bg color keeps contrast over photos
     without ever looking like a bar. */
  #salon-nav {
    color: var(--color-text);
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-bg) 72%, transparent),
      color-mix(in srgb, var(--color-bg) 30%, transparent) 60%,
      transparent
    );
    transition: background-color 0.4s ease, box-shadow 0.4s ease, color 0.4s ease;
  }
  /* Over full-bleed photography: ivory text on a soft dark wash, so links stay
     readable whatever the photo does behind them. */
  #salon-nav.on-photo {
    color: #fff;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0.22) 60%, transparent);
  }

  /* Solid state after scrolling past the hero's first screenful. */
  #salon-nav.is-solid {
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    color: var(--color-text);
    box-shadow: 0 1px 0 var(--color-border);
  }
  /* The primary CTA keeps its outline readable in both states. */
  #salon-nav.is-solid a[class*="border-current"]:hover {
    background: var(--color-primary);
    color: var(--color-primary-contrast);
    border-color: var(--color-primary);
  }

  /* Burger → X. */
  #salon-nav.is-open .burger-line:first-child {
    transform: translateY(4px) rotate(45deg);
  }
  #salon-nav.is-open .burger-line:last-child {
    transform: translateY(-4px) rotate(-45deg);
  }
  /* Keep burger/wordmark visible above the overlay panel. */
  #salon-nav.is-open {
    color: var(--color-text);
    background: transparent;
    box-shadow: none;
  }
  /* The solid state replaces the scrim with a real surface — including over photos. */
  #salon-nav.is-solid,
  #salon-nav.on-photo.is-solid {
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    color: var(--color-text);
  }

  /* Staggered entrance for overlay links. */
  .overlay-link {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.5s ease, transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(60ms * var(--i, 0) + 120ms);
  }
  #nav-overlay.is-open .overlay-link {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  const header = document.getElementById("salon-nav");
  const burger = document.getElementById("nav-burger");
  const overlay = document.getElementById("nav-overlay");

  // Solid bar once the page is scrolled; transparent again at the very top.
  const onScroll = () => header?.classList.toggle("is-solid", window.scrollY > 40);
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  const setOpen = (open: boolean) => {
    header?.classList.toggle("is-open", open);
    overlay?.classList.toggle("is-open", open);
    overlay?.classList.toggle("opacity-0", !open);
    overlay?.classList.toggle("pointer-events-none", !open);
    burger?.setAttribute("aria-expanded", String(open));
    document.body.style.overflow = open ? "hidden" : "";
  };

  burger?.addEventListener("click", () => setOpen(!header?.classList.contains("is-open")));
  // Any link inside the overlay closes it (anchor navigation).
  overlay?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
  window.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setOpen(false);
  });

  // Scrollspy: underline the nav link of the section crossing the viewport's middle band.
  const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>("#salon-nav .link-line[href^='#']"));
  const linkById = new Map<string, HTMLAnchorElement>();
  for (const link of navLinks) {
    const id = link.getAttribute("href")!.slice(1);
    if (id && document.getElementById(id)) linkById.set(id, link);
  }
  if (linkById.size > 0 && "IntersectionObserver" in window) {
    const setActive = (id: string) => {
      for (const [key, link] of linkById) link.classList.toggle("is-active", key === id);
    };
    const spy = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) setActive(entry.target.id);
        }
      },
      { rootMargin: "-45% 0px -50% 0px", threshold: 0 }
    );
    for (const id of linkById.keys()) spy.observe(document.getElementById(id)!);
  }
</script>