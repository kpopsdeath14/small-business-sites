---
import { ViewTransitions } from "astro:transitions";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#131110" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <!--
      L'ATELIER type system: five display faces (Playfair, Cormorant Garamond, Forum,
      Tenor Sans) paired with two UI sans (Manrope, Jost) — the active pairing is chosen
      per palette in tokens.ts, so sibling sites read as different ateliers, not recolors.
      All families carry full Cyrillic subsets. One combined request keeps it to a single
      CSS fetch; preconnect + display=swap keep first paint fast.
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Forum&family=Tenor+Sans&family=Manrope:wght@300;400;500;600;700&family=Jost:wght@300;400;500;600&display=swap"
    />

    <ViewTransitions />
  </head>
  <body class="bg-[var(--color-bg)] text-[var(--color-text)] antialiased">
    <slot />
  </body>
</html>