---
import Container from "@sitegen/shared-ui/components/Container.astro";
import StoreSection from "../components/StoreSection.astro";
import ProductCard from "../components/ProductCard.astro";
import StoreButton from "../components/StoreButton.astro";
import type { SiteData } from "@sitegen/shared-ui/types.ts";

/**
 * The badged products, given room to breathe before the full catalog. Deliberately not filterable:
 * it is the seller's own pick, and a filter bar here would just compete with the catalog's.
 */
interface Props {
  variant: number;
  data: SiteData;
}
const { data } = Astro.props;
const featured = data.products.filter((product) => !!product.badge).slice(0, 3);
---

{
  featured.length > 0 && (
    <StoreSection id="bestsellers">
      <Container class="max-w-7xl">
        <div class="mb-9 flex flex-wrap items-end justify-between gap-5" data-reveal>
          <div>
            <p class="eyebrow mb-3">Выбор покупателей</p>
            <h2 class="section-title">Хиты продаж</h2>
          </div>
          <StoreButton href="#catalog" variant="outline" size="sm">Весь каталог</StoreButton>
        </div>

        <div class="grid gap-4 sm:gap-5 md:grid-cols-3" data-reveal-stagger="110">
          {featured.map((product) => (
            <ProductCard product={product} layout="showcase" />
          ))}
        </div>
      </Container>
    </StoreSection>
  )
}
