---
import Container from "@sitegen/shared-ui/components/Container.astro";
import StoreSection from "../components/StoreSection.astro";
import type { SiteData } from "@sitegen/shared-ui/types.ts";

interface Props {
  variant: number;
  data: SiteData;
}
const { data } = Astro.props;
---

<StoreSection id="faq" surface="surface">
  <Container narrow>
    <div class="mb-9" data-reveal>
      <p class="eyebrow mb-3">Вопросы</p>
      <h2 class="section-title">Коротко о главном</h2>
    </div>

    <!-- Native <details>: keyboard-accessible, findable by in-page search, and works with JS off.
         `name` makes the group behave as an accordion in browsers that support it, and simply
         allows several open at once in those that do not — a harmless fallback either way. -->
    <div class="divide-y divide-[var(--color-border)] border-y border-[var(--color-border)]" data-reveal-stagger="60">
      {
        data.faq.map((item) => (
          <details class="faq-item group" name="faq" data-reveal>
            <summary class="flex cursor-pointer list-none items-start justify-between gap-5 py-5 text-left">
              <span class="font-[var(--font-heading)] text-base font-bold leading-snug text-[var(--color-text)] sm:text-lg">
                {item.question}
              </span>
              <span
                class="mt-0.5 grid h-7 w-7 shrink-0 place-items-center rounded-full border border-[var(--color-border)] text-[var(--color-primary)] transition-transform duration-300 group-open:rotate-45"
                aria-hidden="true"
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" width="13" height="13">
                  <path d="M12 5v14M5 12h14" stroke-linecap="round" />
                </svg>
              </span>
            </summary>
            <div class="faq-body">
              <p class="pb-6 pr-12 text-[15px] leading-relaxed text-[var(--color-text-muted)]">{item.answer}</p>
            </div>
          </details>
        ))
      }
    </div>
  </Container>
</StoreSection>

<style>
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  /* grid-template-rows 0fr → 1fr is the one way to transition to a content-sized height without
     hardcoding a max-height that clips long answers. */
  .faq-body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .faq-item[open] .faq-body {
    grid-template-rows: 1fr;
  }
  .faq-body > p {
    overflow: hidden;
  }
</style>
