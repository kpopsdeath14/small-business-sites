---
/** Decorative single-line ornamental mark, standing in for a studio's own flash/linework —
 *  recolors with the active token set via `currentColor`. Three loose, hand-drawn-feeling
 *  variants so repeated use across a page doesn't look stamped-out. */
interface Props {
  variant?: 1 | 2 | 3;
  class?: string;
}
const { variant = 1, class: className = "" } = Astro.props;

const paths: Record<number, string> = {
  1: "M4 60 C 20 10, 55 10, 60 40 C 64 64, 40 70, 34 50 C 30 36, 46 30, 58 38 C 78 52, 96 20, 116 24",
  2: "M6 12 C 30 6, 34 34, 14 40 C -4 45, 2 66, 24 62 C 52 57, 48 20, 76 14 C 96 9, 108 30, 96 44 C 86 55, 68 50, 70 36",
  3: "M2 30 C 18 4, 46 4, 54 26 C 60 42, 42 52, 34 40 C 28 30, 40 22, 50 30 C 66 42, 66 62, 90 58 C 106 55, 112 40, 100 30",
};
---

<svg
  viewBox="0 0 120 70"
  fill="none"
  class:list={["text-[var(--color-primary)]", className]}
  aria-hidden="true"
>
  <path
    d={paths[variant]}
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    vector-effect="non-scaling-stroke"
  />
</svg>
