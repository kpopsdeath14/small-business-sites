---
import Container from "@sitegen/shared-ui/components/Container.astro";
import Lightbox from "@sitegen/shared-ui/components/Lightbox.tsx";
import type { SiteData } from "@sitegen/shared-ui/types.ts";

interface Props {
  data: SiteData;
}
const { data } = Astro.props;
---

<section id="gallery" data-reveal class="relative bg-[var(--color-bg)] py-16 sm:py-24">
  <Container class="mb-10">
    <p class="text-xs tracking-[0.4em] uppercase text-[var(--color-text-muted)] mb-3">Портфолио</p>
    <h2 class="font-[var(--font-heading)] uppercase text-[clamp(2rem,6vw,4rem)] leading-none text-[var(--color-text)]">
      Работы
    </h2>
  </Container>

  <!-- Edge-to-edge, no container padding — the work fills the frame like a portfolio site, not a boxed card grid. -->
  <Lightbox
    client:visible
    photos={data.gallery}
    gridClassName="columns-2 sm:columns-3 lg:columns-4 gap-1 px-1"
    itemClassName="mb-1 break-inside-avoid"
    imgClassName="w-full h-auto"
  />
</section>
