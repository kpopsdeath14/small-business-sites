---
import Container from "@sitegen/shared-ui/components/Container.astro";
import type { SiteData } from "@sitegen/shared-ui/types.ts";

interface Props {
  data: SiteData;
}
const { data } = Astro.props;
---

<section id="services" data-reveal class="relative bg-[var(--color-surface)] py-20 sm:py-28">
  <Container narrow>
    <p class="text-xs tracking-[0.4em] uppercase text-[var(--color-text-muted)] mb-3 text-center">Ориентир по ценам</p>
    <h2 class="font-[var(--font-heading)] uppercase text-[clamp(2rem,5vw,3.5rem)] leading-none text-[var(--color-text)] text-center mb-12">
      Цены
    </h2>
    <div class="divide-y divide-[var(--color-border)] border-y border-[var(--color-border)]">
      {data.items.map((item) => (
        <div class="flex items-baseline justify-between gap-6 py-5">
          <div>
            <p class="text-lg sm:text-xl text-[var(--color-text)]">{item.name}</p>
            {item.description && <p class="text-sm text-[var(--color-text-muted)] mt-1">{item.description}</p>}
          </div>
          {item.price && (
            <p class="font-[var(--font-heading)] text-xl sm:text-2xl text-[var(--color-primary)] whitespace-nowrap">{item.price}</p>
          )}
        </div>
      ))}
    </div>
    <p class="mt-6 text-center text-sm text-[var(--color-text-muted)]">
      Точная стоимость — после эскиза, зависит от размера и сложности.
    </p>
  </Container>
</section>
