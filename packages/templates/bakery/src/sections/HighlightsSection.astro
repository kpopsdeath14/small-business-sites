---
import Container from "@sitegen/shared-ui/components/Container.astro";
import Section from "@sitegen/shared-ui/components/Section.astro";
import type { SiteData } from "@sitegen/shared-ui/types.ts";

interface Props {
  variant: number;
  data: SiteData;
}
const { data } = Astro.props;
---

<Section id="highlights" surface="surface">
  <Container>
    <h2 class="font-[var(--font-heading)] text-3xl font-bold text-[var(--color-text)] text-center mb-10">Хиты продаж</h2>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {data.highlights.map((item) => (
        <div class="group overflow-hidden rounded-[var(--radius-lg)] bg-[var(--color-bg)] shadow-[var(--shadow-card)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[var(--shadow-elevated)]">
          <div class="relative aspect-square overflow-hidden">
            {item.photo ? (
              <img
                src={item.photo}
                alt={item.name}
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
            ) : (
              <div class="h-full w-full bg-[var(--color-surface)]" />
            )}
            <span class="absolute left-3 top-3 rounded-full bg-[var(--color-primary)] px-3 py-1 text-xs font-semibold text-[var(--color-primary-contrast)] shadow-[var(--shadow-card)]">
              Хит
            </span>
          </div>
          <div class="p-5">
            <p class="font-[var(--font-heading)] text-lg font-semibold text-[var(--color-text)]">{item.name}</p>
            {item.description && <p class="mt-1 text-sm text-[var(--color-text-muted)]">{item.description}</p>}
            {item.price && <p class="mt-3 font-semibold text-[var(--color-primary)]">{item.price}</p>}
          </div>
        </div>
      ))}
    </div>
  </Container>
</Section>
