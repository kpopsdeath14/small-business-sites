---
import Container from "@sitegen/shared-ui/components/Container.astro";
import Section from "@sitegen/shared-ui/components/Section.astro";
import StarRating from "@sitegen/shared-ui/components/StarRating.astro";
import Button from "@sitegen/shared-ui/components/Button.astro";
import type { SiteData } from "@sitegen/shared-ui/types.ts";

interface Props {
  data: SiteData;
}
const { data } = Astro.props;
---

<Section id="reviews" surface="surface">
  <Container narrow>
    <h2 class="font-[var(--font-heading)] text-3xl font-bold text-[var(--color-text)] text-center mb-10">Отзывы</h2>
    <div class="space-y-8">
      {data.reviews.map((review) => (
        <blockquote class="text-center">
          <StarRating rating={review.rating} class="justify-center mb-3" />
          <p class="font-[var(--font-heading)] text-xl text-[var(--color-text)] leading-relaxed">&laquo;{review.text}&raquo;</p>
          <footer class="mt-3 text-sm text-[var(--color-text-muted)]">— {review.author}</footer>
        </blockquote>
      ))}
    </div>
    {data.reviewsUrl && (
      <div class="text-center mt-10">
        <Button href={data.reviewsUrl} variant="outline" target="_blank" rel="noopener noreferrer">
          Оставить отзыв
        </Button>
      </div>
    )}
  </Container>
</Section>
